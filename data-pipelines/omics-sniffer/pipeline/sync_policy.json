{
  "description": "Tiered incremental sync schedule for omics-sniffer (GEO/AE every 2 days, active specialty repos monthly, static cohorts manual)",
  "defaults": {
    "memory_limit": "2GB",
    "keep_releases": 2,
    "overlap_days": 2
  },
  "sources": {
    "geo": {
      "tier": 1,
      "interval_hours": 48,
      "mode": "date_window",
      "enabled": true,
      "notes": "Every 2 days via NCBI E-utilities PDAT window"
    },
    "arrayexpress": {
      "tier": 1,
      "interval_hours": 48,
      "mode": "date_window",
      "enabled": true,
      "notes": "Every 2 days via BioStudies release_date window"
    },
    "pride": {
      "tier": 2,
      "interval_hours": 720,
      "mode": "reverse_early_stop",
      "enabled": true,
      "notes": "Monthly (30d) updates via PRIDE /projects sorted descending with early stop"
    },
    "cellxgene": {
      "tier": 2,
      "interval_hours": 720,
      "mode": "date_window",
      "enabled": true,
      "notes": "Monthly (30d) updates via CZ CELLxGENE Curation /datasets published_at/revised_at window"
    },
    "metabolights": {
      "tier": 2,
      "interval_hours": 720,
      "mode": "date_window",
      "enabled": true,
      "notes": "Monthly (30d) updates via EBI Search metabolights publication_date window"
    },
    "sra": {
      "tier": 2,
      "interval_hours": 720,
      "mode": "delta_sqlite",
      "enabled": false,
      "notes": "Monthly cadence when running sra_orphan_scan delta staging"
    },
    "massive": {
      "tier": 2,
      "interval_hours": 720,
      "mode": "delta_sqlite",
      "enabled": false,
      "notes": "Monthly cadence"
    },
    "mw": {
      "tier": 2,
      "interval_hours": 720,
      "mode": "delta_sqlite",
      "enabled": false,
      "notes": "Monthly cadence"
    },
    "encode": {
      "tier": 2,
      "interval_hours": 720,
      "mode": "delta_sqlite",
      "enabled": false,
      "notes": "Monthly cadence"
    },
    "cbioportal": {
      "tier": 2,
      "interval_hours": 720,
      "mode": "delta_sqlite",
      "enabled": false,
      "notes": "Monthly cadence"
    },
    "hubmap": {
      "tier": 2,
      "interval_hours": 720,
      "mode": "delta_sqlite",
      "enabled": false,
      "notes": "Monthly cadence"
    },
    "proteomicsdb": {
      "tier": 2,
      "interval_hours": 720,
      "mode": "delta_sqlite",
      "enabled": false,
      "notes": "Monthly cadence"
    },
    "gtex": {
      "tier": 3,
      "interval_hours": 0,
      "mode": "manual",
      "enabled": false,
      "notes": "Static/release-based (GTEx v10); update manually via --delta-sqlite"
    },
    "gdc_tcga": {
      "tier": 3,
      "interval_hours": 0,
      "mode": "manual",
      "enabled": false,
      "notes": "Static/release-based; update manually via --delta-sqlite"
    },
    "icgc": {
      "tier": 3,
      "interval_hours": 0,
      "mode": "manual",
      "enabled": false,
      "notes": "Static cohort; manual only"
    },
    "depmap": {
      "tier": 3,
      "interval_hours": 0,
      "mode": "manual",
      "enabled": false,
      "notes": "Release-based; manual only"
    },
    "finngen": {
      "tier": 3,
      "interval_hours": 0,
      "mode": "manual",
      "enabled": false,
      "notes": "Release-based (R13+); manual only"
    }
  }
}
