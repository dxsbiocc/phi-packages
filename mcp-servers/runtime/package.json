{
  "name": "phi-omics-runtime",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "HTTP client, result builders, and stdio/HTTP entry points for the Phi omics MCP servers",
  "files": ["dist"],
  "engines": { "node": ">=20" },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "phi-omics-schemas": "1.0.0",
    "zod": "^4.1.12"
  }
}
