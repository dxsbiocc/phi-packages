{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "status",
    "tool",
    "n_input_files",
    "n_events_total",
    "n_events_significant",
    "n_genes_significant",
    "n_multi_hit_genes",
    "n_frameshift_candidates",
    "n_in_frame_modular",
    "event_class_summary",
    "top_events",
    "top_multi_hit_genes",
    "outputs",
    "warnings"
  ],
  "properties": {
    "status": { "type": "string", "const": "ok" },
    "tool": { "type": "string", "const": "rna_splicing" },
    "n_input_files": { "type": "integer" },
    "n_events_total": { "type": "integer" },
    "n_events_significant": { "type": "integer" },
    "n_genes_significant": { "type": "integer" },
    "n_multi_hit_genes": { "type": "integer" },
    "n_frameshift_candidates": { "type": "integer" },
    "n_in_frame_modular": { "type": "integer" },
    "event_class_summary": { "type": "array", "items": { "type": "object" } },
    "top_events": { "type": "array", "items": { "type": "object" } },
    "top_multi_hit_genes": { "type": "array", "items": { "type": "object" } },
    "outputs": {
      "type": "object",
      "required": ["significant_events", "event_class_summary", "multi_hit_genes", "volcano_plot"],
      "properties": {
        "significant_events": { "type": "string" },
        "event_class_summary": { "type": "string" },
        "multi_hit_genes": { "type": "string" },
        "volcano_plot": { "type": "string" }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
