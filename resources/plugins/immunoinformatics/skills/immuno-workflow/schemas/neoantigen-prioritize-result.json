{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "status",
    "tool",
    "ic50_source",
    "ic50_cutoff_nm",
    "min_tpm",
    "n_candidates",
    "n_strong_binders",
    "n_weak_binders",
    "n_passed_all_gates",
    "top_candidates",
    "outputs",
    "artifacts",
    "warnings"
  ],
  "properties": {
    "status": { "type": "string", "const": "ok" },
    "tool": { "type": "string", "const": "imm_neoantigen_prioritize" },
    "ic50_source": { "type": "string", "enum": ["provided", "pssm_estimate", "mixed"] },
    "ic50_cutoff_nm": { "type": "number" },
    "min_tpm": { "type": "number" },
    "n_candidates": { "type": "integer" },
    "n_strong_binders": { "type": "integer" },
    "n_weak_binders": { "type": "integer" },
    "n_passed_all_gates": { "type": "integer" },
    "n_high_dai": { "type": "integer" },
    "n_anchor_mutations": { "type": "integer" },
    "top_candidates": { "type": "array", "items": { "type": "object" } },
    "outputs": {
      "type": "object",
      "required": [
        "prioritized_neoantigens",
        "neoantigen_landscape"
      ],
      "properties": {
        "prioritized_neoantigens": { "type": "string" },
        "neoantigen_landscape": { "type": "string" }
      }
    },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
