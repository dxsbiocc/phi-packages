{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "status",
    "tool",
    "n_samples",
    "n_class1_homozygous_samples",
    "mean_cohort_class1_hed",
    "samples",
    "outputs",
    "artifacts",
    "warnings"
  ],
  "properties": {
    "status": { "type": "string", "const": "ok" },
    "tool": { "type": "string", "const": "imm_hla_summary" },
    "n_samples": { "type": "integer" },
    "detected_tools": { "type": "array", "items": { "type": "string" } },
    "n_class1_homozygous_samples": { "type": "integer" },
    "mean_cohort_class1_hed": { "type": ["number", "null"] },
    "samples": { "type": "array", "items": { "type": "object" } },
    "outputs": {
      "type": "object",
      "required": [
        "hla_consensus_genotypes",
        "hla_zygosity_hed"
      ],
      "properties": {
        "hla_consensus_genotypes": { "type": "string" },
        "hla_zygosity_hed": { "type": "string" }
      }
    },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
