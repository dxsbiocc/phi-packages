{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["tool", "outputs", "artifacts", "warnings"],
  "properties": {
    "tool": { "const": "mo_rna_protein" },
    "de_concordance": { "type": ["object", "null"] },
    "sample_level_correlation": { "type": ["object", "null"] },
    "outputs": { "type": "object" },
    "figures": { "type": "array", "items": { "type": "string" } },
    "scientificContext": { "type": "object" },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
