{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["tool", "n_shared_samples", "n_factors", "modalities", "factor_variance_explained", "outputs", "artifacts", "warnings"],
  "properties": {
    "tool": { "const": "mo_factor_integration" },
    "n_shared_samples": { "type": "integer" },
    "n_factors": { "type": "integer" },
    "modalities": { "type": "array", "items": { "type": "object" } },
    "factor_variance_explained": { "type": "array", "items": { "type": "object" } },
    "group_associations": { "type": ["array", "null"] },
    "outputs": { "type": "object" },
    "figures": { "type": "array", "items": { "type": "string" } },
    "scientificContext": { "type": "object" },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
