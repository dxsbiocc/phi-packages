{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["ok", "mode", "action"],
  "properties": {
    "ok": { "type": "boolean" },
    "mode": { "const": "live" },
    "action": { "type": "string" },
    "collection_id": { "type": "string" },
    "db_path": { "type": "string" },
    "collections": { "type": "array" },
    "wiki_vault": { "type": ["string", "null"] },
    "wiki_init": { "type": ["object", "null"] }
  },
  "additionalProperties": true
}
