{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["ok", "seed_id", "relation", "hits", "wrote"],
  "properties": {
    "ok": { "type": "boolean" },
    "stub": { "type": "boolean", "description": "Only true for legacy/mock edge; happy path false" },
    "mode": { "type": "string" },
    "seed_id": { "type": "string" },
    "relation": { "type": "string", "enum": ["similar", "citations", "references"] },
    "hits": { "type": "array" },
    "n_hits": { "type": "integer" },
    "wrote": { "type": "boolean" },
    "confirm_write": { "type": "boolean" },
    "providers": { "type": "array" },
    "meta": { "type": "object" },
    "banner": { "type": "string" },
    "hits_path": { "type": ["string", "null"] },
    "ingest": {},
    "enrich": {},
    "error": { "type": "string" }
  },
  "additionalProperties": true
}
