@article{zheng2017,
  title={Landscape of Infiltrating T Cells in Liver Cancer Revealed by Single-Cell Sequencing},
  author={Zheng, Chunhong and Zheng, Liangtao and Yoo, Jae-Kwang and Guo, Huahu and Zhang, Yuanyuan},
  journal={Cell},
  year={2017},
  volume={169},
  pages={1342--1356},
  doi={10.1016/j.cell.2017.05.035},
  pmid={28622514},
  abstract={Detailed characterization of the composition and dynamics of T cells in the hepatocellular carcinoma (HCC) microenvironment remains challenging. Here we report a single-cell RNA sequencing analysis of 5,063 T cells isolated from peripheral blood, tumor, and adjacent normal tissues from six HCC patients. The transcriptional profiles of these individual cells, coupled with assembled T cell receptor (TCR) sequences, enable us to identify 11 unique T cell subsets based on their molecular and functional properties and delineate their developmental trajectory. Specific subsets such as exhausted CD8+ T cells and Tregs are preferentially enriched and potentially clonally expanded in HCC, and LAYN is linked to immunosuppressive T cells. This composite analysis of T cells in HCC provides deeper insights into the immune landscape of HCC and guides effective immunotherapies.}
}

