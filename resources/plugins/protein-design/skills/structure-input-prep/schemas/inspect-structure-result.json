{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["path", "format", "num_chains", "chains", "ligands"],
  "properties": {
    "path": { "type": "string" },
    "format": { "type": "string" },
    "num_chains": { "type": "integer" },
    "chains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["chain_id", "num_residues", "min_resseq", "max_resseq", "gaps", "suggested_contig", "sequence"]
      }
    },
    "ligands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["chain_id", "resname", "resseq", "atom_count"]
      }
    }
  }
}
