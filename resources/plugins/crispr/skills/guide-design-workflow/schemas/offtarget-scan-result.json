{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "status",
    "tool",
    "n_guides_scanned",
    "n_contigs",
    "reference_bp",
    "max_mismatches",
    "include_nag_pam",
    "n_total_offtarget_sites",
    "n_high_risk_guides",
    "guide_summaries",
    "outputs",
    "artifacts",
    "warnings"
  ],
  "properties": {
    "status": { "type": "string", "const": "ok" },
    "tool": { "type": "string", "const": "crispr_offtarget_scan" },
    "n_guides_scanned": { "type": "integer" },
    "n_contigs": { "type": "integer" },
    "reference_bp": { "type": "integer" },
    "max_mismatches": { "type": "integer" },
    "include_nag_pam": { "type": "boolean" },
    "n_total_offtarget_sites": { "type": "integer" },
    "n_high_risk_guides": { "type": "integer" },
    "guide_summaries": { "type": "array", "items": { "type": "object" } },
    "outputs": {
      "type": "object",
      "required": ["offtarget_sites", "guide_specificity_summary", "specificity_plot"],
      "properties": {
        "offtarget_sites": { "type": "string" },
        "guide_specificity_summary": { "type": "string" },
        "specificity_plot": { "type": "string" }
      }
    },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
