{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["tool", "input", "assemblies", "n_assemblies"],
  "properties": {
    "tool": { "type": "string", "const": "mg_assembly_stats" },
    "input": { "type": "string" },
    "assemblies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["assembly", "n50"],
        "properties": {
          "assembly": { "type": "string" },
          "contigs": { "type": ["number", "null"] },
          "total_length": { "type": ["number", "null"] },
          "largest_contig": { "type": ["number", "null"] },
          "n50": { "type": ["number", "null"] },
          "n75": { "type": ["number", "null"] },
          "l50": { "type": ["number", "null"] },
          "l75": { "type": ["number", "null"] },
          "gc_percent": { "type": ["number", "null"] }
        }
      }
    },
    "n_assemblies": { "type": "integer" },
    "note": { "type": "string" }
  }
}