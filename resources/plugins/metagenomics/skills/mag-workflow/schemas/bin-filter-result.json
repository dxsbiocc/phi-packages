{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["tool", "bins_dir", "n_bins_total", "n_passed", "n_rejected", "thresholds", "outputs", "artifacts"],
  "properties": {
    "tool": { "type": "string", "const": "mg_bin_filter" },
    "bins_dir": { "type": "string" },
    "n_bins_total": { "type": "integer" },
    "n_passed": { "type": "integer" },
    "n_rejected": { "type": "integer" },
    "thresholds": {
      "type": "object",
      "required": ["min_completeness", "max_contamination"],
      "properties": {
        "min_completeness": { "type": "number" },
        "max_contamination": { "type": "number" }
      }
    },
    "outputs": {
      "type": "object",
      "required": ["dir", "manifest"],
      "properties": {
        "dir": { "type": "string" },
        "manifest": { "type": "string" }
      }
    },
    "artifacts": { "type": "array", "items": { "type": "string" } }
  }
}