{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "clinical",
    "outcome_col",
    "model_type",
    "n_samples",
    "n_events",
    "events_per_variable",
    "discrimination_metric",
    "apparent_discrimination",
    "total_points_max",
    "predictors",
    "model_terms",
    "scorecard_table",
    "lookup_table",
    "figures",
    "artifacts",
    "warnings"
  ],
  "properties": {
    "clinical": { "type": "string" },
    "outcome_col": { "type": "string" },
    "model_type": { "type": "string", "enum": ["cox", "logistic"] },
    "time_col": { "type": ["string", "null"] },
    "time_label": { "type": ["string", "null"] },
    "n_samples": { "type": "integer" },
    "n_events": { "type": "integer" },
    "events_per_variable": { "type": "number" },
    "discrimination_metric": { "type": "string", "enum": ["c_index", "roc_auc"] },
    "apparent_discrimination": { "type": "number" },
    "total_points_max": { "type": "number" },
    "lp_at_zero_points": { "type": "number" },
    "points_per_unit_lp": { "type": "number" },
    "landmarks": { "type": "array", "items": { "type": "number" } },
    "baseline_survival_at_landmarks": { "type": "object" },
    "predictors": { "type": "array", "items": { "type": "object" } },
    "model_terms": { "type": "array", "items": { "type": "object" } },
    "scorecard_table": { "type": "string" },
    "lookup_table": { "type": "string" },
    "figures": { "type": "array", "items": { "type": "string" } },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
