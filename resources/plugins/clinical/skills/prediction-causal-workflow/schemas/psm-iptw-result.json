{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "clinical",
    "treatment_col",
    "method",
    "n_samples",
    "n_treated",
    "n_control",
    "positivity_audit",
    "covariate_balance",
    "balance_table",
    "figures",
    "artifacts",
    "warnings"
  ],
  "properties": {
    "clinical": { "type": "string" },
    "treatment_col": { "type": "string" },
    "treatment_mapping": { "type": "object" },
    "method": { "type": "string" },
    "n_samples": { "type": "integer" },
    "n_treated": { "type": "integer" },
    "n_control": { "type": "integer" },
    "positivity_audit": { "type": "object" },
    "psm_summary": { "type": ["object", "null"] },
    "iptw_summary": { "type": ["object", "null"] },
    "covariate_balance": { "type": "array", "items": { "type": "object" } },
    "treatment_effects": { "type": ["object", "null"] },
    "balance_table": { "type": "string" },
    "matched_cohort_table": { "type": ["string", "null"] },
    "figures": { "type": "array", "items": { "type": "string" } },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
