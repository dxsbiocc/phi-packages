{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "status",
    "tool",
    "n_sv_calls",
    "tier_counts",
    "n_pathogenic_or_likely",
    "n_snv_cnv_compound_hits",
    "compound_hits",
    "outputs",
    "artifacts",
    "warnings"
  ],
  "properties": {
    "status": { "type": "string", "const": "ok" },
    "tool": { "type": "string", "const": "germ_cnv_sv_integrate" },
    "n_sv_calls": { "type": "integer" },
    "tier_counts": { "type": "object" },
    "n_pathogenic_or_likely": { "type": "integer" },
    "n_snv_cnv_compound_hits": { "type": "integer" },
    "compound_hits": { "type": "array", "items": { "type": "object" } },
    "outputs": {
      "type": "object",
      "required": [
        "classified_germline_cnv_sv",
        "snv_cnv_compound_hits",
        "germline_cnv_dosage_summary"
      ],
      "properties": {
        "classified_germline_cnv_sv": { "type": "string" },
        "snv_cnv_compound_hits": { "type": "string" },
        "germline_cnv_dosage_summary": { "type": "string" }
      }
    },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
