{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phi.local/skills/omics-visualization/viz-prepare.json",
  "title": "viz prepare result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "template_id",
    "script",
    "common_r",
    "purpose",
    "inputs",
    "run",
    "dependencies",
    "r_packages"
  ],
  "properties": {
    "template_id": {
      "type": "string",
      "minLength": 1
    },
    "script": {
      "type": "string",
      "minLength": 1
    },
    "common_r": {
      "type": "string",
      "minLength": 1
    },
    "existing": {
      "const": true
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "purpose": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "run": {
      "type": "string",
      "minLength": 1
    },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "r_packages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checked",
        "missing"
      ],
      "properties": {
        "checked": {
          "type": "boolean"
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "column_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "mapped",
        "problems"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "mapped": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "column",
              "expects",
              "tables"
            ],
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1
              },
              "column": {
                "type": "string",
                "minLength": 1
              },
              "expects": {
                "enum": [
                  "number",
                  "numbers",
                  "any",
                  "table"
                ]
              },
              "tables": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "problems": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "not_checked": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "adaptation": {
      "type": "string"
    },
    "assumptions": {
      "type": "string"
    },
    "config": {
      "$ref": "#/$defs/section"
    },
    "data_preparation": {
      "$ref": "#/$defs/section"
    },
    "plot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_line",
        "end_line"
      ],
      "properties": {
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_line",
        "end_line",
        "text"
      ],
      "properties": {
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string"
        }
      }
    }
  }
}
