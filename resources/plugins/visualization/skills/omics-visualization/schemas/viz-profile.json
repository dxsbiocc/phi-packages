{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phi.local/skills/omics-visualization/viz-profile.json",
  "title": "viz profile result",
  "type": "object",
  "additionalProperties": false,
  "required": ["tables"],
  "properties": {
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "kind"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["table", "file"] },
          "bytes": { "type": "integer", "minimum": 0 },
          "rows": { "type": "integer", "minimum": 0 },
          "column_count": { "type": "integer", "minimum": 0 },
          "columns": { "type": "array", "items": { "$ref": "#/$defs/column" } },
          "more_columns": {
            "type": "object",
            "additionalProperties": false,
            "required": ["count", "number", "text", "empty"],
            "properties": {
              "count": { "type": "integer", "minimum": 1 },
              "number": { "type": "integer", "minimum": 0 },
              "text": { "type": "integer", "minimum": 0 },
              "empty": { "type": "integer", "minimum": 0 }
            }
          },
          "duplicate_headers": { "type": "array", "items": { "type": "string" } },
          "ragged_rows": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "other_files": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "joins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "join",
          "left_distinct",
          "right_distinct",
          "shared",
          "left_only",
          "right_only",
          "left_only_examples",
          "right_only_examples"
        ],
        "properties": {
          "join": { "type": "string", "minLength": 1 },
          "left_distinct": { "type": "integer", "minimum": 0 },
          "right_distinct": { "type": "integer", "minimum": 0 },
          "shared": { "type": "integer", "minimum": 0 },
          "left_only": { "type": "integer", "minimum": 0 },
          "right_only": { "type": "integer", "minimum": 0 },
          "left_only_examples": { "type": "array", "items": { "type": "string" } },
          "right_only_examples": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "$defs": {
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "missing"],
      "properties": {
        "name": { "type": "string" },
        "type": { "enum": ["number", "text", "empty"] },
        "missing": { "type": "integer", "minimum": 0 },
        "numeric_values": { "type": "integer", "minimum": 1 },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "non_finite": { "type": "integer", "minimum": 1 },
        "distinct": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "string", "pattern": "^>\\d+$" }] },
        "unique": { "type": "boolean" },
        "examples": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
