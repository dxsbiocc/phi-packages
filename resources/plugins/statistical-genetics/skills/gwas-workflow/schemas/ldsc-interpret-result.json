{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "tool",
    "n_snps_merged",
    "n_blocks",
    "ld_score_source",
    "mean_chi2",
    "h2_observed",
    "h2_observed_se",
    "ldsc_intercept",
    "ldsc_intercept_se",
    "bivariate_executed",
    "outputs",
    "figures",
    "artifacts",
    "warnings"
  ],
  "properties": {
    "tool": { "const": "gwas_ldsc_interpret" },
    "n_snps_merged": { "type": "integer" },
    "n_blocks": { "type": "integer" },
    "ld_score_source": { "type": "string" },
    "mean_chi2": { "type": "number" },
    "h2_observed": { "type": "number" },
    "h2_observed_se": { "type": "number" },
    "h2_z": { "type": ["number", "null"] },
    "h2_p": { "type": ["number", "null"] },
    "ldsc_intercept": { "type": "number" },
    "ldsc_intercept_se": { "type": "number" },
    "attenuation_ratio": { "type": ["number", "null"] },
    "h2_liability": { "type": ["number", "null"] },
    "h2_liability_se": { "type": ["number", "null"] },
    "sample_prev": { "type": ["number", "null"] },
    "pop_prev": { "type": ["number", "null"] },
    "bivariate_executed": { "type": "boolean" },
    "trait2_h2_observed": { "type": ["number", "null"] },
    "trait2_h2_observed_se": { "type": ["number", "null"] },
    "trait2_ldsc_intercept": { "type": ["number", "null"] },
    "gcov_observed": { "type": ["number", "null"] },
    "gcov_se": { "type": ["number", "null"] },
    "gcov_intercept": { "type": ["number", "null"] },
    "rg": { "type": ["number", "null"] },
    "rg_se": { "type": ["number", "null"] },
    "rg_z": { "type": ["number", "null"] },
    "rg_p": { "type": ["number", "null"] },
    "outputs": { "type": "object" },
    "figures": { "type": "array", "items": { "type": "string" } },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
