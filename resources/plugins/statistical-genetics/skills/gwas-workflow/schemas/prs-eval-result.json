{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "tool",
    "outcome_mode",
    "n_samples",
    "prs_col",
    "outcome_col",
    "covariates_used",
    "prs_effect_measure",
    "prs_effect_per_sd",
    "prs_ci_lower",
    "prs_ci_upper",
    "prs_p_value",
    "model_comparison",
    "quantile_risk",
    "outputs",
    "figures",
    "artifacts",
    "warnings"
  ],
  "properties": {
    "tool": { "const": "gwas_prs_eval" },
    "outcome_mode": { "type": "string", "enum": ["binary", "quantitative", "survival"] },
    "n_samples": { "type": "integer" },
    "n_events": { "type": ["integer", "null"] },
    "prs_col": { "type": "string" },
    "outcome_col": { "type": "string" },
    "time_col": { "type": ["string", "null"] },
    "pop_prev": { "type": ["number", "null"] },
    "covariates_used": { "type": "array", "items": { "type": "string" } },
    "prs_effect_measure": { "type": "string" },
    "prs_effect_per_sd": { "type": "number" },
    "prs_ci_lower": { "type": "number" },
    "prs_ci_upper": { "type": "number" },
    "prs_p_value": { "type": "number" },
    "model_comparison": { "type": "object" },
    "quantile_risk": { "type": "array", "items": { "type": "object" } },
    "outputs": { "type": "object" },
    "figures": { "type": "array", "items": { "type": "string" } },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
