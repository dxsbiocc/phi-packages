{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "status",
    "tool",
    "backend",
    "n_input",
    "n_valid",
    "n_invalid",
    "n_salts_stripped",
    "n_neutralized",
    "n_duplicates",
    "n_output",
    "keep_duplicates",
    "outputs",
    "artifacts",
    "warnings"
  ],
  "properties": {
    "status": { "type": "string", "const": "ok" },
    "tool": { "type": "string", "const": "chem_standardize" },
    "backend": { "type": "string", "enum": ["rdkit", "pure_python_smiles"] },
    "n_input": { "type": "integer" },
    "n_valid": { "type": "integer" },
    "n_invalid": { "type": "integer" },
    "n_salts_stripped": { "type": "integer" },
    "n_neutralized": { "type": "integer" },
    "n_stereochemistry": { "type": "integer" },
    "n_duplicates": { "type": "integer" },
    "n_output": { "type": "integer" },
    "keep_duplicates": { "type": "boolean" },
    "invalid_records": { "type": "array", "items": { "type": "object" } },
    "outputs": {
      "type": "object",
      "required": ["standardized_compounds", "standardization_summary"],
      "properties": {
        "standardized_compounds": { "type": "string" },
        "standardization_summary": { "type": "string" }
      }
    },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
