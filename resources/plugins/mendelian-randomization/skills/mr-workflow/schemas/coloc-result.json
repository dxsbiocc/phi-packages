    "priors": { "type": "object" },
    "posteriors": { "type": "object" },
    "coloc_call": { "type": "string" },
    "top_snp": { "type": "object" },
    "credible_set_95": { "type": "array", "items": { "type": "object" } },
    "outputs": { "type": "object" },
