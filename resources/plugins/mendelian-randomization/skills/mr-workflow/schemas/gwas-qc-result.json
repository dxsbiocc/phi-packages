{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["tool", "n_variants_input", "n_variants_clean", "lambda_gc", "n_lead_loci", "outputs", "artifacts", "warnings"],
  "properties": {
    "tool": { "const": "mr_gwas_qc" },
    "n_variants_input": { "type": "integer" },
    "n_variants_clean": { "type": "integer" },
    "effect_scale_input": { "type": "string" },
    "lambda_gc": { "type": "number" },
    "n_genome_wide_sig": { "type": "integer" },
    "n_lead_loci": { "type": "integer" },
    "top_leads": { "type": "array", "items": { "type": "object" } },
    "outputs": { "type": "object" },
    "figures": { "type": "array", "items": { "type": "string" } },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
