{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["tool", "n_samples", "n_cpgs_union", "n_cpgs_retained", "outputs", "artifacts", "warnings"],
  "properties": {
    "tool": { "const": "meth_merge" },
    "n_samples": { "type": "integer" },
    "samples": { "type": "array", "items": { "type": "string" } },
    "min_cov": { "type": "integer" },
    "min_samples_required": { "type": "integer" },
    "n_cpgs_union": { "type": "integer" },
    "n_cpgs_retained": { "type": "integer" },
    "outputs": { "type": "object" },
    "scientificContext": { "type": "object" },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
