#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { NUMORPH_INTENSITY } from '../main.nf'

params.img_directory = null
params.parameter_file = null
params.outdir = "results"

workflow {
    img_directory_ch = Channel
        .fromPath(params.img_directory, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    parameter_file_ch = params.parameter_file ? Channel.fromPath(params.parameter_file, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    NUMORPH_INTENSITY(img_directory_ch.combine(parameter_file_ch))
}
