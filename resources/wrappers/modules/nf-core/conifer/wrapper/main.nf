#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { CONIFER } from '../main.nf'

params.kraken_result = null
params.kraken_taxon_db = null
params.args = ""
params.outdir = "results"

workflow {
    kraken_result_ch = Channel
        .fromPath(params.kraken_result, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    kraken_taxon_db_ch = params.kraken_taxon_db ? Channel.fromPath(params.kraken_taxon_db, checkIfExists: true).first() : Channel.value([])

    CONIFER(kraken_result_ch, kraken_taxon_db_ch)
}
