#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { LAST_MAFCONVERT } from '../main.nf'

params.maf = null
params.format = null
params.fasta = null
params.fai = null
params.gzi = null
params.sizes = null
params.dict = null
params.args = ""
params.outdir = "results"

workflow {
    maf_ch = Channel
        .fromPath(params.maf, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fai_ch = params.fai ? Channel.fromPath(params.fai, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    gzi_ch = params.gzi ? Channel.fromPath(params.gzi, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    sizes_ch = params.sizes ? Channel.fromPath(params.sizes, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    dict_ch = params.dict ? Channel.fromPath(params.dict, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    LAST_MAFCONVERT(maf_ch.map { t -> t + [params.format] }, fasta_ch.combine(fai_ch).combine(gzi_ch).combine(sizes_ch).combine(dict_ch).first())
}
