#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { LAST_LASTAL } from '../main.nf'

params.fastx = null
params.param_file = null
params.index = null
params.args = ""
params.outdir = "results"

workflow {
    fastx_ch = Channel
        .fromFilePairs(params.fastx, size: -1)
        .map { sample, reads -> [[id: sample, single_end: reads instanceof List ? reads.size() == 1 : true], reads] }
    param_file_ch = params.param_file ? Channel.fromPath(params.param_file, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    index_ch = params.index ? Channel.fromPath(params.index, checkIfExists: true).first() : Channel.value([])

    LAST_LASTAL(fastx_ch.combine(param_file_ch), index_ch)
}
