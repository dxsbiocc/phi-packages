#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { LAST_DOTPLOT } from '../main.nf'

params.maf = null
params.annot_b = null
params.annot_a = null
params.format = null
params.filter = false
params.args = ""
params.outdir = "results"

workflow {
    maf_ch = Channel
        .fromPath(params.maf, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    annot_b_ch = params.annot_b ? Channel.fromPath(params.annot_b, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    annot_a_ch = Channel
        .fromPath(params.annot_a, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    LAST_DOTPLOT(maf_ch.combine(annot_b_ch), annot_a_ch.first(), params.format, params.filter)
}
