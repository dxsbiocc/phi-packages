#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { STRDROP_CALL } from '../main.nf'

params.vcf = null
params.training_set_json = null
params.training_set_vcfs = null
params.args = ""
params.outdir = "results"

workflow {
    vcf_ch = Channel
        .fromPath(params.vcf, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    training_set_json_ch = Channel
        .fromPath(params.training_set_json, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    training_set_vcfs_ch = Channel
        .fromPath("${params.training_set_vcfs}/*", checkIfExists: true)
        .collect()
        .map { files -> [[id: 'input'], files] }

    STRDROP_CALL(vcf_ch, training_set_json_ch.first(), training_set_vcfs_ch.first())
}
