#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { LIFTOFF } from '../main.nf'

params.target_fa = null
params.ref_fa = null
params.ref_annotation = null
params.ref_db = null
params.args = ""
params.outdir = "results"

workflow {
    target_fa_ch = Channel
        .fromPath(params.target_fa, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    ref_fa_ch = params.ref_fa ? Channel.fromPath(params.ref_fa, checkIfExists: true).first() : Channel.value([])
    ref_annotation_ch = Channel.fromPath(params.ref_annotation, checkIfExists: true)
    ref_db_ch = params.ref_db ? Channel.fromPath(params.ref_db, checkIfExists: true).first() : Channel.value([])

    LIFTOFF(target_fa_ch, ref_fa_ch, ref_annotation_ch, ref_db_ch)
}
