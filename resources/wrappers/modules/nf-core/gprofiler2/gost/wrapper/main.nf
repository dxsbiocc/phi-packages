#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { GPROFILER2_GOST } from '../main.nf'

params.de_file = null
params.gmt_file = null
params.background_file = null
params.outdir = "results"

workflow {
    de_file_ch = Channel
        .fromPath(params.de_file, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    gmt_file_ch = Channel
        .fromPath(params.gmt_file, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    background_file_ch = Channel
        .fromPath(params.background_file, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    GPROFILER2_GOST(de_file_ch, gmt_file_ch.first(), background_file_ch.first())
}
