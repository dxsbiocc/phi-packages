// Launcher config for the gprofiler2 gost wrapper adapter. Not part of the fixed
// wrapper/{main.nf,params.json,wrapper.yaml} contract — Nextflow picks this
// up automatically because it sits beside wrapper/main.nf.

process {
    cpus   = 1
    memory = '2.GB'
    time   = '1.h'

    withName: 'GPROFILER2_GOST' {
        publishDir = [
            path: { "${params.outdir}/gprofiler2_gost" },
            mode: 'copy',
            pattern: '{*.gprofiler2.*.sub_enriched_pathways.png,*.gprofiler2.*.sub_enriched_pathways.tsv,*.gprofiler2.all_enriched_pathways.tsv,*.gprofiler2.gost_results.rds,*.gprofiler2.gostplot.html,*.gprofiler2.gostplot.png,*ENSG_filtered.gmt,*R_sessionInfo.log}'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}
