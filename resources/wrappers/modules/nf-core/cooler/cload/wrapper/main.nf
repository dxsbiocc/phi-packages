#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { COOLER_CLOAD } from '../main.nf'

params.contacts = null
params.index = null
params.chromsizes = null
params.mode = null
params.cool_bin = null
params.args = ""
params.outdir = "results"

workflow {
    contacts_ch = Channel
        .fromPath(params.contacts, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    index_ch = params.index ? Channel.fromPath(params.index, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    chromsizes_ch = Channel
        .fromPath(params.chromsizes, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    COOLER_CLOAD(contacts_ch.combine(index_ch), chromsizes_ch.first(), params.mode, params.cool_bin)
}
