#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SEMIBIN_MULTIEASYBIN } from '../main.nf'

params.fasta = null
params.bam = null
params.depths = null
params.args = ""
params.outdir = "results"

workflow {
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bam_ch = params.bam ? Channel.fromPath(params.bam, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    depths_ch = params.depths ? Channel.fromPath(params.depths, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    SEMIBIN_MULTIEASYBIN(fasta_ch.combine(bam_ch).combine(depths_ch))
}
