#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { TD2_LONGORFS } from '../main.nf'

params.fasta = null
params.min_len = null
params.abs_min_len = null
params.gene_transmap = null
params.args = ""
params.outdir = "results"

workflow {
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    gene_transmap_ch = Channel
        .fromPath(params.gene_transmap, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    TD2_LONGORFS(fasta_ch, Channel.value([[id: 'input'], params.min_len, params.abs_min_len]), gene_transmap_ch.first())
}
