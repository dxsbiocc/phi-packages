#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { PANACUS_HISTGROWTH } from '../main.nf'

params.gfa = null
params.bed_subset = null
params.bed_exclude = null
params.tsv_groupby = null
params.args = ""
params.outdir = "results"

workflow {
    gfa_ch = Channel
        .fromPath(params.gfa, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bed_subset_ch = Channel.fromPath(params.bed_subset, checkIfExists: true)
    bed_exclude_ch = Channel.fromPath(params.bed_exclude, checkIfExists: true)
    tsv_groupby_ch = Channel.fromPath(params.tsv_groupby, checkIfExists: true)

    PANACUS_HISTGROWTH(gfa_ch, bed_subset_ch, bed_exclude_ch, tsv_groupby_ch)
}
