#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { MM2PLUS_ALIGN } from '../main.nf'

params.reads = null
params.reference = null
params.bam_format = false
params.bam_index_extension = null
params.cigar_paf_format = false
params.cigar_bam = false
params.args = ""
params.outdir = "results"

workflow {
    reads_ch = Channel
        .fromPath(params.reads, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    reference_ch = Channel
        .fromPath(params.reference, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    MM2PLUS_ALIGN(reads_ch, reference_ch.first(), params.bam_format, params.bam_index_extension, params.cigar_paf_format, params.cigar_bam)
}
