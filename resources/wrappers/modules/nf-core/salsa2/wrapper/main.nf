#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SALSA2 } from '../main.nf'

params.fasta = null
params.index = null
params.bed = null
params.gfa = null
params.dup = null
params.filter_bed = null
params.args = ""
params.outdir = "results"

workflow {
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    index_ch = params.index ? Channel.fromPath(params.index, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    bed_ch = params.bed ? Channel.fromPath(params.bed, checkIfExists: true).first() : Channel.value([])
    gfa_ch = params.gfa ? Channel.fromPath(params.gfa, checkIfExists: true).first() : Channel.value([])
    dup_ch = Channel.fromPath(params.dup, checkIfExists: true)
    filter_bed_ch = params.filter_bed ? Channel.fromPath(params.filter_bed, checkIfExists: true).first() : Channel.value([])

    SALSA2(fasta_ch.combine(index_ch), bed_ch, gfa_ch, dup_ch, filter_bed_ch)
}
