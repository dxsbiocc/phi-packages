#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { QUILT_QUILT } from '../main.nf'

params.bams = null
params.bais = null
params.bamlist = null
params.samplename = null
params.reference_haplotype_file = null
params.reference_legend_file = null
params.posfile = null
params.phasefile = null
params.genfile = null
params.genetic_map = null
params.chr = null
params.regions_start = null
params.regions_end = null
params.ngen = null
params.buffer = null
params.fasta = null
params.fasta_fai = null
params.args = ""
params.outdir = "results"

workflow {
    bams_ch = Channel
        .fromPath(params.bams, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bais_ch = params.bais ? Channel.fromPath(params.bais, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    bamlist_ch = params.bamlist ? Channel.fromPath(params.bamlist, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    samplename_ch = params.samplename ? Channel.fromPath(params.samplename, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    reference_haplotype_file_ch = params.reference_haplotype_file ? Channel.fromPath(params.reference_haplotype_file, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    reference_legend_file_ch = params.reference_legend_file ? Channel.fromPath(params.reference_legend_file, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    posfile_ch = params.posfile ? Channel.fromPath(params.posfile, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    phasefile_ch = params.phasefile ? Channel.fromPath(params.phasefile, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    genfile_ch = params.genfile ? Channel.fromPath(params.genfile, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    genetic_map_ch = params.genetic_map ? Channel.fromPath(params.genetic_map, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fasta_fai_ch = params.fasta_fai ? Channel.fromPath(params.fasta_fai, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    QUILT_QUILT(bams_ch.combine(bais_ch).combine(bamlist_ch).combine(samplename_ch).combine(reference_haplotype_file_ch).combine(reference_legend_file_ch).combine(posfile_ch).combine(phasefile_ch).combine(genfile_ch).combine(genetic_map_ch).map { t -> t + [params.chr] }.map { t -> t + [params.regions_start] }.map { t -> t + [params.regions_end] }.map { t -> t + [params.ngen] }.map { t -> t + [params.buffer] }, fasta_ch.combine(fasta_fai_ch).first())
}
