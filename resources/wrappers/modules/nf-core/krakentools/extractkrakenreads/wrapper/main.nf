#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { KRAKENTOOLS_EXTRACTKRAKENREADS } from '../main.nf'

params.taxid = null
params.classified_reads_assignment = null
params.classified_reads_fastq = null
params.report = null
params.args = ""
params.outdir = "results"

workflow {
    classified_reads_assignment_ch = Channel
        .fromFilePairs(params.classified_reads_assignment, size: -1)
        .map { sample, reads -> [[id: sample, single_end: reads instanceof List ? reads.size() == 1 : true], reads] }
    classified_reads_fastq_ch = Channel
        .fromPath(params.classified_reads_fastq, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    report_ch = Channel
        .fromPath(params.report, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    KRAKENTOOLS_EXTRACTKRAKENREADS(params.taxid, classified_reads_assignment_ch, classified_reads_fastq_ch.first(), report_ch.first())
}
