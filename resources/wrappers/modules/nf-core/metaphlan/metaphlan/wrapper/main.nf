#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { METAPHLAN_METAPHLAN } from '../main.nf'

params.input = null
params.db_metaphlan_latest = null
params.save_samfile = false
params.args = ""
params.outdir = "results"

workflow {
    input_ch = Channel
        .fromFilePairs(params.input, size: -1)
        .map { sample, reads -> [[id: sample, single_end: reads instanceof List ? reads.size() == 1 : true], reads] }
    db_metaphlan_latest_ch = Channel.fromPath(params.db_metaphlan_latest, checkIfExists: true)

    METAPHLAN_METAPHLAN(input_ch, db_metaphlan_latest_ch, params.save_samfile)
}
