#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SHINYNGS_VALIDATEFOMCOMPONENTS } from '../main.nf'

params.sample = null
params.assay_files = null
params.feature_meta = null
params.contrasts = null
params.args = ""
params.outdir = "results"

workflow {
    sample_ch = Channel
        .fromPath(params.sample, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    assay_files_ch = params.assay_files ? Channel.fromPath(params.assay_files, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    feature_meta_ch = Channel
        .fromPath(params.feature_meta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    contrasts_ch = Channel
        .fromPath(params.contrasts, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    SHINYNGS_VALIDATEFOMCOMPONENTS(sample_ch.combine(assay_files_ch), feature_meta_ch.first(), contrasts_ch.first())
}
