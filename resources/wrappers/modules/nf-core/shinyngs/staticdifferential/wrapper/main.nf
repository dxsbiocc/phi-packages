#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SHINYNGS_STATICDIFFERENTIAL } from '../main.nf'

params.differential_result = null
params.sample = null
params.feature_meta = null
params.assay_file = null
params.args = ""
params.outdir = "results"

workflow {
    differential_result_ch = Channel
        .fromPath(params.differential_result, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    sample_ch = Channel
        .fromPath(params.sample, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    feature_meta_ch = params.feature_meta ? Channel.fromPath(params.feature_meta, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    assay_file_ch = params.assay_file ? Channel.fromPath(params.assay_file, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    SHINYNGS_STATICDIFFERENTIAL(differential_result_ch, sample_ch.combine(feature_meta_ch).combine(assay_file_ch).first())
}
