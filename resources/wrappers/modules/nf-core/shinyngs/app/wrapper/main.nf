#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SHINYNGS_APP } from '../main.nf'

params.sample = null
params.feature_meta = null
params.assay_files = null
params.contrasts = null
params.differential_results = null
params.contrast_stats_assay = null
params.gene_sets = null
params.enrichment_results = null
params.args = ""
params.outdir = "results"

workflow {
    sample_ch = Channel
        .fromPath(params.sample, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    feature_meta_ch = params.feature_meta ? Channel.fromPath(params.feature_meta, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    assay_files_ch = params.assay_files ? Channel.fromPath(params.assay_files, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    contrasts_ch = Channel
        .fromPath(params.contrasts, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    differential_results_ch = params.differential_results ? Channel.fromPath(params.differential_results, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    gene_sets_ch = Channel.fromPath(params.gene_sets, checkIfExists: true)
    enrichment_results_ch = Channel.fromPath(params.enrichment_results, checkIfExists: true)

    SHINYNGS_APP(sample_ch.combine(feature_meta_ch).combine(assay_files_ch), contrasts_ch.combine(differential_results_ch).first(), params.contrast_stats_assay, gene_sets_ch, enrichment_results_ch)
}
