#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SHINYNGS_STATICEXPLORATORY } from '../main.nf'

params.sample = null
params.feature_meta = null
params.assay_files = null
params.variable = null
params.args = ""
params.outdir = "results"

workflow {
    sample_ch = Channel
        .fromPath(params.sample, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    feature_meta_ch = params.feature_meta ? Channel.fromPath(params.feature_meta, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    assay_files_ch = params.assay_files ? Channel.fromPath(params.assay_files, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    SHINYNGS_STATICEXPLORATORY(sample_ch.combine(feature_meta_ch).combine(assay_files_ch).map { t -> t + [params.variable] })
}
