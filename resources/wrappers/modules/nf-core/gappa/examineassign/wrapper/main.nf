#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { GAPPA_EXAMINEASSIGN } from '../main.nf'

params.jplace = null
params.taxonomy = null
params.args = ""
params.outdir = "results"

workflow {
    jplace_ch = Channel
        .fromPath(params.jplace, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    taxonomy_ch = params.taxonomy ? Channel.fromPath(params.taxonomy, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    GAPPA_EXAMINEASSIGN(jplace_ch.combine(taxonomy_ch))
}
