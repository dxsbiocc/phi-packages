#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { DECOUPLER_DECOUPLER } from '../main.nf'

params.mat = null
params.net = null
params.annot = null
params.outdir = "results"

workflow {
    mat_ch = Channel
        .fromPath(params.mat, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    net_ch = Channel
        .fromPath(params.net, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    annot_ch = Channel
        .fromPath(params.annot, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    DECOUPLER_DECOUPLER(mat_ch, net_ch.first(), annot_ch.first())
}
