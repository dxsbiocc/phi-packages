#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { ANGSD_GL } from '../main.nf'

params.bam = null
params.bai = null
params.fasta = null
params.fai = null
params.error_file = null
params.args = ""
params.outdir = "results"

workflow {
    bam_ch = Channel
        .fromPath(params.bam, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bai_ch = params.bai ? Channel.fromPath(params.bai, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fai_ch = params.fai ? Channel.fromPath(params.fai, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    error_file_ch = Channel
        .fromPath(params.error_file, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    ANGSD_GL(bam_ch.combine(bai_ch), fasta_ch.combine(fai_ch).first(), error_file_ch.first())
}
