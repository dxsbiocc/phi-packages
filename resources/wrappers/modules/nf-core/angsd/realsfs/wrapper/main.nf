#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { ANGSD_REALSFS } from '../main.nf'

params.pop1_saf_idx = null
params.pop1_saf_pos = null
params.pop1_saf = null
params.pop2_saf_idx = null
params.pop2_saf_pos = null
params.pop2_saf = null
params.args = ""
params.outdir = "results"

workflow {
    pop1_saf_idx_ch = Channel
        .fromPath(params.pop1_saf_idx, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    pop1_saf_pos_ch = params.pop1_saf_pos ? Channel.fromPath(params.pop1_saf_pos, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    pop1_saf_ch = params.pop1_saf ? Channel.fromPath(params.pop1_saf, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    pop2_saf_idx_ch = Channel
        .fromPath(params.pop2_saf_idx, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    pop2_saf_pos_ch = params.pop2_saf_pos ? Channel.fromPath(params.pop2_saf_pos, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    pop2_saf_ch = params.pop2_saf ? Channel.fromPath(params.pop2_saf, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    ANGSD_REALSFS(pop1_saf_idx_ch.combine(pop1_saf_pos_ch).combine(pop1_saf_ch), pop2_saf_idx_ch.combine(pop2_saf_pos_ch).combine(pop2_saf_ch).first())
}
