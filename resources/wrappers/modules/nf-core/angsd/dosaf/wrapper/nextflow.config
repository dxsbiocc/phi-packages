// Launcher config for the angsd dosaf wrapper adapter. Not part of the fixed
// wrapper/{main.nf,params.json,wrapper.yaml} contract — Nextflow picks this
// up automatically because it sits beside wrapper/main.nf.

process {
    cpus   = 4
    memory = '8.GB'
    time   = '4.h'

    withName: 'ANGSD_DOSAF' {
        publishDir = [
            path: { "${params.outdir}/angsd_dosaf" },
            mode: 'copy',
            pattern: '{*.saf.gz,*.saf.idx,*.saf.pos.gz}'
        ]
        ext.args = { params.args ?: '' }
    }
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}
