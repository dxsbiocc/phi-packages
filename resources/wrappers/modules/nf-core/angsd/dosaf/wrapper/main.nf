#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { ANGSD_DOSAF } from '../main.nf'

params.bams = null
params.bam_indices = null
params.reference_fasta = null
params.reference_fai = null
params.ancestral_fasta = null
params.ancestral_fai = null
params.error_file = null
params.inbreeding_coefficients = null
params.soapsnp_calibration = null
params.gl_model = null
params.dosaf_mode = null
params.args = ""
params.outdir = "results"

workflow {
    bams_ch = Channel
        .fromPath(params.bams, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bam_indices_ch = params.bam_indices ? Channel.fromPath(params.bam_indices, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    reference_fasta_ch = Channel
        .fromPath(params.reference_fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    reference_fai_ch = params.reference_fai ? Channel.fromPath(params.reference_fai, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    ancestral_fasta_ch = Channel
        .fromPath(params.ancestral_fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    ancestral_fai_ch = params.ancestral_fai ? Channel.fromPath(params.ancestral_fai, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    error_file_ch = Channel.fromPath(params.error_file, checkIfExists: true)
    inbreeding_coefficients_ch = Channel.fromPath(params.inbreeding_coefficients, checkIfExists: true)
    soapsnp_calibration_ch = Channel.fromPath(params.soapsnp_calibration, checkIfExists: true)

    ANGSD_DOSAF(bams_ch.combine(bam_indices_ch), reference_fasta_ch.combine(reference_fai_ch).first(), ancestral_fasta_ch.combine(ancestral_fai_ch).first(), error_file_ch, inbreeding_coefficients_ch, soapsnp_calibration_ch, params.gl_model, params.dosaf_mode)
}
