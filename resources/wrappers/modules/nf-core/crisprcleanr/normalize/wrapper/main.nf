#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { CRISPRCLEANR_NORMALIZE } from '../main.nf'

params.count_file = null
params.library_file = null
params.min_reads = null
params.min_targeted_genes = null
params.outdir = "results"

workflow {
    count_file_ch = Channel
        .fromPath(params.count_file, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    library_file_ch = params.library_file ? Channel.fromPath(params.library_file, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    CRISPRCLEANR_NORMALIZE(count_file_ch.combine(library_file_ch), params.min_reads, params.min_targeted_genes)
}
