#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { PURGEDUPS_GETSEQS } from '../main.nf'

params.assembly = null
params.bed = null
params.args = ""
params.outdir = "results"

workflow {
    assembly_ch = Channel
        .fromPath(params.assembly, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bed_ch = params.bed ? Channel.fromPath(params.bed, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    PURGEDUPS_GETSEQS(assembly_ch.combine(bed_ch))
}
