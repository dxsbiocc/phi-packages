#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { PURGEDUPS_PURGEDUPS } from '../main.nf'

params.basecov = null
params.cutoff = null
params.paf = null
params.args = ""
params.outdir = "results"

workflow {
    basecov_ch = Channel
        .fromPath(params.basecov, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    cutoff_ch = params.cutoff ? Channel.fromPath(params.cutoff, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    paf_ch = params.paf ? Channel.fromPath(params.paf, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    PURGEDUPS_PURGEDUPS(basecov_ch.combine(cutoff_ch).combine(paf_ch))
}
