#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { FASTME } from '../main.nf'

params.infile = null
params.initial_tree = null
params.args = ""
params.outdir = "results"

workflow {
    infile_ch = Channel
        .fromPath(params.infile, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    initial_tree_ch = params.initial_tree ? Channel.fromPath(params.initial_tree, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    FASTME(infile_ch.combine(initial_tree_ch))
}
