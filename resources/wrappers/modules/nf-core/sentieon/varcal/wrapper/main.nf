#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SENTIEON_VARCAL } from '../main.nf'

params.vcf = null
params.tbi = null
params.resource_vcf = null
params.resource_tbi = null
params.labels = null
params.fasta = null
params.fai = null
params.args = ""
params.outdir = "results"

workflow {
    vcf_ch = Channel
        .fromPath(params.vcf, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    tbi_ch = params.tbi ? Channel.fromPath(params.tbi, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    resource_vcf_ch = Channel.fromPath(params.resource_vcf, checkIfExists: true)
    resource_tbi_ch = Channel.fromPath(params.resource_tbi, checkIfExists: true)
    fasta_ch = params.fasta ? Channel.fromPath(params.fasta, checkIfExists: true).first() : Channel.value([])
    fai_ch = params.fai ? Channel.fromPath(params.fai, checkIfExists: true).first() : Channel.value([])

    SENTIEON_VARCAL(vcf_ch.combine(tbi_ch), resource_vcf_ch, resource_tbi_ch, params.labels, fasta_ch, fai_ch)
}
