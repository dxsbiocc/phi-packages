#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SENTIEON_DEDUP } from '../main.nf'

params.bam = "https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/modules/data/genomics/sarscov2/genome/genome.fasta"
params.bai = null
params.fasta = null
params.fasta_fai = null
params.args = ""
params.outdir = "results"

workflow {
    bam_ch = Channel
        .fromPath(params.bam, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bai_ch = params.bai ? Channel.fromPath(params.bai, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fasta_fai_ch = Channel
        .fromPath(params.fasta_fai, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    SENTIEON_DEDUP(bam_ch.combine(bai_ch), fasta_ch.first(), fasta_fai_ch.first())
}
