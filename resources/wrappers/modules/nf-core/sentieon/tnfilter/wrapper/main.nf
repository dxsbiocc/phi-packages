#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SENTIEON_TNFILTER } from '../main.nf'

params.vcf = null
params.vcf_tbi = null
params.stats = null
params.contamination = null
params.segments = null
params.orientation_priors = null
params.fasta = null
params.fai = null
params.args = ""
params.outdir = "results"

workflow {
    vcf_ch = Channel
        .fromPath(params.vcf, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    vcf_tbi_ch = params.vcf_tbi ? Channel.fromPath(params.vcf_tbi, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    stats_ch = params.stats ? Channel.fromPath(params.stats, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    contamination_ch = params.contamination ? Channel.fromPath(params.contamination, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    segments_ch = params.segments ? Channel.fromPath(params.segments, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    orientation_priors_ch = params.orientation_priors ? Channel.fromPath(params.orientation_priors, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fai_ch = Channel
        .fromPath(params.fai, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    SENTIEON_TNFILTER(vcf_ch.combine(vcf_tbi_ch).combine(stats_ch).combine(contamination_ch).combine(segments_ch).combine(orientation_priors_ch), fasta_ch.first(), fai_ch.first())
}
