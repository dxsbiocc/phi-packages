#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SENTIEON_DNASCOPE } from '../main.nf'

params.bam = null
params.bai = null
params.intervals = null
params.fasta = null
params.fai = null
params.dbsnp = null
params.dbsnp_tbi = null
params.ml_model = null
params.pcr_indel_model = null
params.emit_vcf = false
params.emit_gvcf = false
params.args = ""
params.outdir = "results"

workflow {
    bam_ch = Channel
        .fromPath(params.bam, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bai_ch = params.bai ? Channel.fromPath(params.bai, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    intervals_ch = params.intervals ? Channel.fromPath(params.intervals, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fai_ch = Channel
        .fromPath(params.fai, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    dbsnp_ch = Channel
        .fromPath(params.dbsnp, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    dbsnp_tbi_ch = Channel
        .fromPath(params.dbsnp_tbi, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    ml_model_ch = Channel
        .fromPath(params.ml_model, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    SENTIEON_DNASCOPE(bam_ch.combine(bai_ch).combine(intervals_ch), fasta_ch.first(), fai_ch.first(), dbsnp_ch.first(), dbsnp_tbi_ch.first(), ml_model_ch.first(), params.pcr_indel_model, params.emit_vcf, params.emit_gvcf)
}
