#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SENTIEON_DNAMODELAPPLY } from '../main.nf'

params.vcf = null
params.idx = null
params.fasta = null
params.fai = null
params.ml_model = null
params.args = ""
params.outdir = "results"

workflow {
    vcf_ch = Channel
        .fromPath(params.vcf, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    idx_ch = params.idx ? Channel.fromPath(params.idx, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fai_ch = Channel
        .fromPath(params.fai, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    ml_model_ch = Channel
        .fromPath(params.ml_model, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    SENTIEON_DNAMODELAPPLY(vcf_ch.combine(idx_ch), fasta_ch.first(), fai_ch.first(), ml_model_ch.first())
}
