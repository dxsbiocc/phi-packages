#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SENTIEON_QUALCAL } from '../main.nf'

params.input = "https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/genome.fasta"
params.input_index = null
params.fasta = null
params.fai = null
params.known_sites = null
params.known_sites_tbi = null
params.recalibration_table = null
params.generate_recalibrated_bams = false
params.args = ""
params.outdir = "results"

workflow {
    input_ch = Channel
        .fromPath(params.input, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    input_index_ch = params.input_index ? Channel.fromPath(params.input_index, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fai_ch = Channel
        .fromPath(params.fai, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    known_sites_ch = Channel
        .fromPath(params.known_sites, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    known_sites_tbi_ch = Channel
        .fromPath(params.known_sites_tbi, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    recalibration_table_ch = Channel
        .fromPath(params.recalibration_table, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    SENTIEON_QUALCAL(input_ch.combine(input_index_ch), fasta_ch.first(), fai_ch.first(), known_sites_ch.first(), known_sites_tbi_ch.first(), recalibration_table_ch.first(), params.generate_recalibrated_bams)
}
