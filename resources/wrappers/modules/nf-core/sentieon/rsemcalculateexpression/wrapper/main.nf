#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SENTIEON_RSEMCALCULATEEXPRESSION } from '../main.nf'

params.reads = null
params.s = null
params.for = null
params.index = null
params.args = ""
params.outdir = "results"

workflow {
    reads_ch = Channel
        .fromFilePairs(params.reads, size: -1)
        .map { sample, reads -> [[id: sample, single_end: reads instanceof List ? reads.size() == 1 : true], reads] }
    s_ch = params.s ? Channel.fromPath(params.s, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    for_ch = params.for ? Channel.fromPath(params.for, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    index_ch = params.index ? Channel.fromPath(params.index, checkIfExists: true).first() : Channel.value([])

    SENTIEON_RSEMCALCULATEEXPRESSION(reads_ch.combine(s_ch).combine(for_ch), index_ch)
}
