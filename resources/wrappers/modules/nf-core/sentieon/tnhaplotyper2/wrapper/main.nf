#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SENTIEON_TNHAPLOTYPER2 } from '../main.nf'

params.input = null
params.input_index = null
params.intervals = null
params.dict = null
params.fasta = null
params.fai = null
params.germline_resource = null
params.germline_resource_tbi = null
params.panel_of_normals = null
params.panel_of_normals_tbi = null
params.emit_orientation_data = false
params.emit_contamination_data = false
params.args = ""
params.outdir = "results"

workflow {
    input_ch = Channel
        .fromPath(params.input, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    input_index_ch = params.input_index ? Channel.fromPath(params.input_index, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    intervals_ch = params.intervals ? Channel.fromPath(params.intervals, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    dict_ch = Channel
        .fromPath(params.dict, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fai_ch = Channel
        .fromPath(params.fai, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    germline_resource_ch = Channel
        .fromPath(params.germline_resource, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    germline_resource_tbi_ch = Channel
        .fromPath(params.germline_resource_tbi, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    panel_of_normals_ch = Channel
        .fromPath(params.panel_of_normals, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    panel_of_normals_tbi_ch = Channel
        .fromPath(params.panel_of_normals_tbi, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    SENTIEON_TNHAPLOTYPER2(input_ch.combine(input_index_ch).combine(intervals_ch), dict_ch.first(), fasta_ch.first(), fai_ch.first(), germline_resource_ch.first(), germline_resource_tbi_ch.first(), panel_of_normals_ch.first(), panel_of_normals_tbi_ch.first(), params.emit_orientation_data, params.emit_contamination_data)
}
