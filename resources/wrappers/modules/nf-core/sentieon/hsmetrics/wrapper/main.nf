#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SENTIEON_HSMETRICS } from '../main.nf'

params.bam = null
params.bai = null
params.bait_intervals = null
params.target_intervals = null
params.fasta = null
params.fai = null
params.args = ""
params.outdir = "results"

workflow {
    bam_ch = Channel
        .fromPath(params.bam, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bai_ch = params.bai ? Channel.fromPath(params.bai, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    bait_intervals_ch = params.bait_intervals ? Channel.fromPath(params.bait_intervals, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    target_intervals_ch = params.target_intervals ? Channel.fromPath(params.target_intervals, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fai_ch = Channel
        .fromPath(params.fai, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    SENTIEON_HSMETRICS(bam_ch.combine(bai_ch).combine(bait_intervals_ch).combine(target_intervals_ch), fasta_ch.first(), fai_ch.first())
}
