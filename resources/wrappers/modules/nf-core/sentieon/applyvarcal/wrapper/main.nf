#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SENTIEON_APPLYVARCAL } from '../main.nf'

params.vcf = null
params.vcf_tbi = null
params.recal = null
params.recal_index = null
params.tranches = null
params.fasta = null
params.fai = null
params.args = ""
params.outdir = "results"

workflow {
    vcf_ch = Channel
        .fromPath(params.vcf, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    vcf_tbi_ch = params.vcf_tbi ? Channel.fromPath(params.vcf_tbi, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    recal_ch = params.recal ? Channel.fromPath(params.recal, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    recal_index_ch = params.recal_index ? Channel.fromPath(params.recal_index, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    tranches_ch = params.tranches ? Channel.fromPath(params.tranches, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fai_ch = Channel
        .fromPath(params.fai, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    SENTIEON_APPLYVARCAL(vcf_ch.combine(vcf_tbi_ch).combine(recal_ch).combine(recal_index_ch).combine(tranches_ch), fasta_ch.first(), fai_ch.first())
}
