#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SENTIEON_COLLECTVCMETRICS } from '../main.nf'

params.vcf = null
params.tbi = null
params.dbsnp = null
params.dbsnp_tbi = null
params.fasta = null
params.fai = null
params.interval = null
params.args = ""
params.outdir = "results"

workflow {
    vcf_ch = Channel
        .fromPath(params.vcf, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    tbi_ch = params.tbi ? Channel.fromPath(params.tbi, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    dbsnp_ch = Channel
        .fromPath(params.dbsnp, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    dbsnp_tbi_ch = params.dbsnp_tbi ? Channel.fromPath(params.dbsnp_tbi, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fai_ch = Channel
        .fromPath(params.fai, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    interval_ch = Channel
        .fromPath(params.interval, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    SENTIEON_COLLECTVCMETRICS(vcf_ch.combine(tbi_ch), dbsnp_ch.combine(dbsnp_tbi_ch).first(), fasta_ch.first(), fai_ch.first(), interval_ch.first())
}
