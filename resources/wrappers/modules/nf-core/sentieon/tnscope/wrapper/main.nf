#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SENTIEON_TNSCOPE } from '../main.nf'

params.input = null
params.input_index = null
params.intervals = null
params.fasta = null
params.fai = null
params.dbsnp = null
params.dbsnp_tbi = null
params.pon = null
params.pon_tbi = null
params.cosmic = null
params.cosmic_tbi = null
params.args = ""
params.outdir = "results"

workflow {
    input_ch = Channel
        .fromPath(params.input, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    input_index_ch = params.input_index ? Channel.fromPath(params.input_index, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    intervals_ch = params.intervals ? Channel.fromPath(params.intervals, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fai_ch = Channel
        .fromPath(params.fai, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    dbsnp_ch = Channel
        .fromPath(params.dbsnp, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    dbsnp_tbi_ch = Channel
        .fromPath(params.dbsnp_tbi, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    pon_ch = Channel
        .fromPath(params.pon, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    pon_tbi_ch = Channel
        .fromPath(params.pon_tbi, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    cosmic_ch = Channel
        .fromPath(params.cosmic, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    cosmic_tbi_ch = Channel
        .fromPath(params.cosmic_tbi, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    SENTIEON_TNSCOPE(input_ch.combine(input_index_ch).combine(intervals_ch), fasta_ch.first(), fai_ch.first(), dbsnp_ch.first(), dbsnp_tbi_ch.first(), pon_ch.first(), pon_tbi_ch.first(), cosmic_ch.first(), cosmic_tbi_ch.first())
}
