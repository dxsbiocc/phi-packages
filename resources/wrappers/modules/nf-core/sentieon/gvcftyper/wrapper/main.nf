#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SENTIEON_GVCFTYPER } from '../main.nf'

params.gvcfs = null
params.tbis = null
params.intervals = null
params.fasta = null
params.fai = null
params.dbsnp = null
params.dbsnp_tbi = null
params.args = ""
params.outdir = "results"

workflow {
    gvcfs_ch = Channel
        .fromPath(params.gvcfs, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    tbis_ch = params.tbis ? Channel.fromPath(params.tbis, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    intervals_ch = params.intervals ? Channel.fromPath(params.intervals, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fai_ch = Channel
        .fromPath(params.fai, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    dbsnp_ch = Channel
        .fromPath(params.dbsnp, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    dbsnp_tbi_ch = Channel
        .fromPath(params.dbsnp_tbi, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    SENTIEON_GVCFTYPER(gvcfs_ch.combine(tbis_ch).combine(intervals_ch), fasta_ch.first(), fai_ch.first(), dbsnp_ch.first(), dbsnp_tbi_ch.first())
}
