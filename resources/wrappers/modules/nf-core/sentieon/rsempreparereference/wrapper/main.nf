#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SENTIEON_RSEMPREPAREREFERENCE } from '../main.nf'

params.fasta = null
params.gtf = null
params.args = ""
params.outdir = "results"

workflow {
    fasta_ch = Channel.fromPath("${params.fasta}/*", checkIfExists: true).collect()
    gtf_ch = params.gtf ? Channel.fromPath(params.gtf, checkIfExists: true).first() : Channel.value([])

    SENTIEON_RSEMPREPAREREFERENCE(fasta_ch, gtf_ch)
}
