#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { MOBSUITE_TYPER } from '../main.nf'

params.fasta = null
params.db = null
params.plasmid_mash_db = null
params.plasmid_meta_txt = null
params.plasmid_replicons_fas = null
params.repetitive_mask_fas = null
params.plasmid_mob_faa = null
params.plasmid_mpf_faa = null
params.plasmid_orit_fas = null
params.generate_biomarker_report = false
params.generate_mge_report = false
params.args = ""
params.outdir = "results"

workflow {
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    db_ch = params.db ? Channel.fromPath(params.db, checkIfExists: true).first() : Channel.value([])
    plasmid_mash_db_ch = params.plasmid_mash_db ? Channel.fromPath(params.plasmid_mash_db, checkIfExists: true).first() : Channel.value([])
    plasmid_meta_txt_ch = Channel.fromPath(params.plasmid_meta_txt, checkIfExists: true)
    plasmid_replicons_fas_ch = Channel.fromPath(params.plasmid_replicons_fas, checkIfExists: true)
    repetitive_mask_fas_ch = Channel.fromPath(params.repetitive_mask_fas, checkIfExists: true)
    plasmid_mob_faa_ch = Channel.fromPath(params.plasmid_mob_faa, checkIfExists: true)
    plasmid_mpf_faa_ch = Channel.fromPath(params.plasmid_mpf_faa, checkIfExists: true)
    plasmid_orit_fas_ch = Channel.fromPath(params.plasmid_orit_fas, checkIfExists: true)

    MOBSUITE_TYPER(fasta_ch, db_ch, plasmid_mash_db_ch, plasmid_meta_txt_ch, plasmid_replicons_fas_ch, repetitive_mask_fas_ch, plasmid_mob_faa_ch, plasmid_mpf_faa_ch, plasmid_orit_fas_ch, params.generate_biomarker_report, params.generate_mge_report)
}
