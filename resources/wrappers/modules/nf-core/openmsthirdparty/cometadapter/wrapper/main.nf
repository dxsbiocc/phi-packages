#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { OPENMSTHIRDPARTY_COMETADAPTER } from '../main.nf'

params.mzml = null
params.fasta = null
params.args = ""
params.outdir = "results"

workflow {
    mzml_ch = Channel
        .fromPath(params.mzml, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fasta_ch = params.fasta ? Channel.fromPath(params.fasta, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    OPENMSTHIRDPARTY_COMETADAPTER(mzml_ch.combine(fasta_ch))
}
