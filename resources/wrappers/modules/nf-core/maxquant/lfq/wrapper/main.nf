#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { MAXQUANT_LFQ } from '../main.nf'

params.fasta = null
params.paramfile = null
params.raw = null
params.args = ""
params.outdir = "results"

workflow {
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    paramfile_ch = params.paramfile ? Channel.fromPath(params.paramfile, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    raw_ch = Channel.fromPath(params.raw, checkIfExists: true)

    MAXQUANT_LFQ(fasta_ch.combine(paramfile_ch), raw_ch)
}
