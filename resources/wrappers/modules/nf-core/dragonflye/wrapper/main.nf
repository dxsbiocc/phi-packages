#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { DRAGONFLYE } from '../main.nf'

params.shortreads = "https://raw.githubusercontent.com/nf-core/test-datasets/bacass/"
params.longreads = null
params.args = ""
params.outdir = "results"

workflow {
    shortreads_ch = Channel
        .fromFilePairs(params.shortreads, size: -1)
        .map { sample, reads -> [[id: sample, single_end: reads instanceof List ? reads.size() == 1 : true], reads] }
    longreads_ch = params.longreads ? Channel.fromPath(params.longreads, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    DRAGONFLYE(shortreads_ch.combine(longreads_ch))
}
