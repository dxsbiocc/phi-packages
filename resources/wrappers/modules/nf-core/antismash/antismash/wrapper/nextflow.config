// Launcher config for the antismash antismash wrapper adapter. Not part of the fixed
// wrapper/{main.nf,params.json,wrapper.yaml} contract — Nextflow picks this
// up automatically because it sits beside wrapper/main.nf.

process {
    cpus   = 4
    memory = '8.GB'
    time   = '4.h'

    withName: 'ANTISMASH_ANTISMASH' {
        publishDir = [
            path: { "${params.outdir}/antismash_antismash" },
            mode: 'copy',
            pattern: '{${prefix}/*.gbk,${prefix}/*.json,${prefix}/*.log,${prefix}/*.zip,${prefix}/*region*.gbk,${prefix}/clusterblast/*_c*.txt,${prefix}/knownclusterblast/*_c*.txt,${prefix}/knownclusterblast/region*/ctg*.html,${prefix}/svg/clusterblast*.svg,${prefix}/svg/knownclusterblast*.svg}'
        ]
        ext.args = { params.args ?: '' }
    }
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}
