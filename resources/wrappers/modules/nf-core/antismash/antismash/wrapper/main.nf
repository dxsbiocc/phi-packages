#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { ANTISMASH_ANTISMASH } from '../main.nf'

params.sequence_input = null
params.databases = null
params.gff = null
params.args = ""
params.outdir = "results"

workflow {
    sequence_input_ch = Channel
        .fromPath(params.sequence_input, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    databases_ch = params.databases ? Channel.fromPath(params.databases, checkIfExists: true).first() : Channel.value([])
    gff_ch = params.gff ? Channel.fromPath(params.gff, checkIfExists: true).first() : Channel.value([])

    ANTISMASH_ANTISMASH(sequence_input_ch, databases_ch, gff_ch)
}
