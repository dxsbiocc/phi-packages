#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { RMATS_PREP } from '../main.nf'

params.genome_bam = null
params.reference_gtf = null
params.read_length = null
params.args = ""
params.outdir = "results"

workflow {
    genome_bam_ch = Channel
        .fromPath(params.genome_bam, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    reference_gtf_ch = Channel
        .fromPath(params.reference_gtf, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    RMATS_PREP(genome_bam_ch, reference_gtf_ch.first(), params.read_length)
}
