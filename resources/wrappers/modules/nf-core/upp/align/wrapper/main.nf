#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { UPP_ALIGN } from '../main.nf'

params.fasta_unaligned = null
params.fasta_aligned = null
params.tree = null
params.compress = false
params.args = ""
params.outdir = "results"

workflow {
    fasta_unaligned_ch = Channel
        .fromPath(params.fasta_unaligned, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fasta_aligned_ch = params.fasta_aligned ? Channel.fromPath(params.fasta_aligned, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    tree_ch = Channel
        .fromPath(params.tree, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    UPP_ALIGN(fasta_unaligned_ch.combine(fasta_aligned_ch), tree_ch.first(), params.compress)
}
