#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { CNAQC } from '../main.nf'

params.snv_rds = null
params.cna_rds = null
params.tumour_sample = null
params.args = ""
params.outdir = "results"

workflow {
    snv_rds_ch = Channel
        .fromPath(params.snv_rds, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    cna_rds_ch = params.cna_rds ? Channel.fromPath(params.cna_rds, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    CNAQC(snv_rds_ch.combine(cna_rds_ch).map { t -> t + [params.tumour_sample] })
}
