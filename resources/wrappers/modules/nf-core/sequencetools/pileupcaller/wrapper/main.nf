#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SEQUENCETOOLS_PILEUPCALLER } from '../main.nf'

params.mpileup = null
params.snpfile = null
params.sample_names_fn = null
params.args = ""
params.outdir = "results"

workflow {
    mpileup_ch = Channel
        .fromPath(params.mpileup, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    snpfile_ch = Channel.fromPath(params.snpfile, checkIfExists: true)
    sample_names_fn_ch = Channel.fromPath(params.sample_names_fn, checkIfExists: true)

    SEQUENCETOOLS_PILEUPCALLER(mpileup_ch, snpfile_ch, sample_names_fn_ch)
}
