#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { OPENMS_PEPTIDEINDEXER } from '../main.nf'

params.idxml = null
params.fasta = null
params.args = ""
params.outdir = "results"

workflow {
    idxml_ch = Channel
        .fromPath(params.idxml, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fasta_ch = params.fasta ? Channel.fromPath(params.fasta, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    OPENMS_PEPTIDEINDEXER(idxml_ch.combine(fasta_ch))
}
