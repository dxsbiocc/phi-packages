#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { OPENMS_IDFILTER } from '../main.nf'

params.id_file = null
params.filter_file = null
params.args = ""
params.outdir = "results"

workflow {
    id_file_ch = Channel
        .fromPath(params.id_file, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    filter_file_ch = params.filter_file ? Channel.fromPath(params.filter_file, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    OPENMS_IDFILTER(id_file_ch.combine(filter_file_ch))
}
