// Launcher config for the proteus readproteingroups wrapper adapter. Not part of the fixed
// wrapper/{main.nf,params.json,wrapper.yaml} contract — Nextflow picks this
// up automatically because it sits beside wrapper/main.nf.

process {
    cpus   = 1
    memory = '2.GB'
    time   = '1.h'

    withName: 'PROTEUS_READPROTEINGROUPS' {
        publishDir = [
            path: { "${params.outdir}/proteus_readproteingroups" },
            mode: 'copy',
            pattern: '{*R_sessionInfo.log,*dendrogram.png,*mean_variance_relationship.png,*normalized_distributions.png,*normalized_proteingroups.rds,*normalized_proteingroups_tab.tsv,*raw_distributions.png,*raw_proteingroups.rds,*raw_proteingroups_tab.tsv}'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}
