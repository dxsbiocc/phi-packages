#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { TOPAS_GENCONS } from '../main.nf'

params.vcf = null
params.vcf_indels = null
params.reference = null
params.fai = null
params.vcf_output = false
params.args = ""
params.outdir = "results"

workflow {
    vcf_ch = Channel
        .fromPath(params.vcf, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    vcf_indels_ch = Channel
        .fromPath(params.vcf_indels, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    reference_ch = Channel
        .fromPath(params.reference, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fai_ch = Channel
        .fromPath(params.fai, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    TOPAS_GENCONS(vcf_ch, vcf_indels_ch.first(), reference_ch.first(), fai_ch.first(), params.vcf_output)
}
