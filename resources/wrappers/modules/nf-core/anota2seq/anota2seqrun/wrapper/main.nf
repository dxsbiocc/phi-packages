#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { ANOTA2SEQ_ANOTA2SEQRUN } from '../main.nf'

params.sample_treatment_col = null
params.reference = null
params.target = null
params.samplesheet = null
params.counts = null
params.outdir = "results"

workflow {
    samplesheet_ch = Channel
        .fromPath(params.samplesheet, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    counts_ch = params.counts ? Channel.fromPath(params.counts, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    ANOTA2SEQ_ANOTA2SEQRUN(Channel.value([[id: 'input'], params.sample_treatment_col, params.reference, params.target]), samplesheet_ch.combine(counts_ch).first())
}
