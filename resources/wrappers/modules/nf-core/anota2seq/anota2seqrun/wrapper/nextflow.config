// Launcher config for the anota2seq anota2seqrun wrapper adapter. Not part of the fixed
// wrapper/{main.nf,params.json,wrapper.yaml} contract — Nextflow picks this
// up automatically because it sits beside wrapper/main.nf.

process {
    cpus   = 1
    memory = '2.GB'
    time   = '1.h'

    withName: 'ANOTA2SEQ_ANOTA2SEQRUN' {
        publishDir = [
            path: { "${params.outdir}/anota2seq_anota2seqrun" },
            mode: 'copy',
            pattern: '{*.Anota2seqDataSet.rds,*.R_sessionInfo.log,*.buffering.anota2seq.results.tsv,*.fold_change.png,*.interaction_p_distribution.pdf,*.mRNA_abundance.anota2seq.results.tsv,*.residual_distribution_summary.jpeg,*.residual_vs_fitted.jpeg,*.rvm_fit_for_all_contrasts_group.jpg,*.rvm_fit_for_interactions.jpg,*.rvm_fit_for_omnibus_group.jpg,*.simulated_vs_obt_dfbetas_without_interaction.pdf,*.total_mRNA.anota2seq.results.tsv,*.translated_mRNA.anota2seq.results.tsv,*.translation.anota2seq.results.tsv}'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}
