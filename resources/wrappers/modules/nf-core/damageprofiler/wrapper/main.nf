#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { DAMAGEPROFILER } from '../main.nf'

params.bam = null
params.fasta = null
params.fai = null
params.specieslist = null
params.args = ""
params.outdir = "results"

workflow {
    bam_ch = Channel
        .fromPath(params.bam, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fasta_ch = params.fasta ? Channel.fromPath(params.fasta, checkIfExists: true).first() : Channel.value([])
    fai_ch = params.fai ? Channel.fromPath(params.fai, checkIfExists: true).first() : Channel.value([])
    specieslist_ch = Channel.fromPath(params.specieslist, checkIfExists: true)

    DAMAGEPROFILER(bam_ch, fasta_ch, fai_ch, specieslist_ch)
}
