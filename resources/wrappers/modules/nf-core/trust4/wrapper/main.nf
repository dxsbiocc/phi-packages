#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { TRUST4 } from '../main.nf'

params.bam = null
params.reads = null
params.fasta = null
params.vdj_reference = null
params.barcode_whitelist = null
params.cell_barcode_read = null
params.umi_read = null
params.read_format = null
params.args = ""
params.outdir = "results"

workflow {
    bam_ch = Channel
        .fromPath(params.bam, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    reads_ch = params.reads ? Channel.fromPath(params.reads, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_ch = params.fasta ? Channel.fromPath(params.fasta, checkIfExists: true).first() : Channel.value([])
    vdj_reference_ch = params.vdj_reference ? Channel.fromPath(params.vdj_reference, checkIfExists: true).first() : Channel.value([])
    barcode_whitelist_ch = Channel.fromPath(params.barcode_whitelist, checkIfExists: true)

    TRUST4(bam_ch.combine(reads_ch), fasta_ch, vdj_reference_ch, barcode_whitelist_ch, params.cell_barcode_read, params.umi_read, params.read_format)
}
