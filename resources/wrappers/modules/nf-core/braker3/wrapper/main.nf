#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { BRAKER3 } from '../main.nf'

params.fasta = null
params.bam = null
params.rnaseq_sets_dirs = null
params.rnaseq_sets_ids = null
params.proteins = null
params.hintsfile = null
params.args = ""
params.outdir = "results"

workflow {
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bam_ch = Channel.fromPath(params.bam, checkIfExists: true)
    rnaseq_sets_dirs_ch = Channel.fromPath(params.rnaseq_sets_dirs, checkIfExists: true)
    rnaseq_sets_ids_ch = Channel.fromPath(params.rnaseq_sets_ids, checkIfExists: true)
    proteins_ch = Channel.fromPath(params.proteins, checkIfExists: true)
    hintsfile_ch = Channel.fromPath(params.hintsfile, checkIfExists: true)

    BRAKER3(fasta_ch, bam_ch, rnaseq_sets_dirs_ch, rnaseq_sets_ids_ch, proteins_ch, hintsfile_ch)
}
