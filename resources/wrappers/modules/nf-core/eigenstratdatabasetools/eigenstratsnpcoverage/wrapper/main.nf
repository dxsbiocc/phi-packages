#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { EIGENSTRATDATABASETOOLS_EIGENSTRATSNPCOVERAGE } from '../main.nf'

params.geno = null
params.snp = null
params.ind = null
params.args = ""
params.outdir = "results"

workflow {
    geno_ch = Channel
        .fromPath(params.geno, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    snp_ch = params.snp ? Channel.fromPath(params.snp, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    ind_ch = params.ind ? Channel.fromPath(params.ind, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    EIGENSTRATDATABASETOOLS_EIGENSTRATSNPCOVERAGE(geno_ch.combine(snp_ch).combine(ind_ch))
}
