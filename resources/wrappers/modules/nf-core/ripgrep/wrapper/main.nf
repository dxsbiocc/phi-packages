#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { RIPGREP } from '../main.nf'

params.files = null
params.pattern = null
params.pattern_file = null
params.compress = false
params.args = ""
params.outdir = "results"

workflow {
    files_ch = Channel
        .fromPath(params.files, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    pattern_file_ch = Channel.fromPath(params.pattern_file, checkIfExists: true)

    RIPGREP(files_ch, params.pattern, pattern_file_ch, params.compress)
}
