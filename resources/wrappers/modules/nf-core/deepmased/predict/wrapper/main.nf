#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { DEEPMASED_PREDICT } from '../main.nf'

params.feature_file_table = null
params.feature_files = null
params.args = ""
params.outdir = "results"

workflow {
    feature_file_table_ch = Channel
        .fromPath(params.feature_file_table, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    feature_files_ch = params.feature_files ? Channel.fromPath(params.feature_files, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    DEEPMASED_PREDICT(feature_file_table_ch.combine(feature_files_ch))
}
