#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SVDB_QUERY } from '../main.nf'

params.vcf = null
params.in_occs = null
params.in_frqs = null
params.out_occs = null
params.out_frqs = null
params.vcf_dbs = null
params.bedpe_dbs = null
params.args = ""
params.outdir = "results"

workflow {
    vcf_ch = Channel
        .fromPath(params.vcf, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    vcf_dbs_ch = Channel.fromPath(params.vcf_dbs, checkIfExists: true)
    bedpe_dbs_ch = Channel.fromPath(params.bedpe_dbs, checkIfExists: true)

    SVDB_QUERY(vcf_ch, params.in_occs, params.in_frqs, params.out_occs, params.out_frqs, vcf_dbs_ch, bedpe_dbs_ch)
}
