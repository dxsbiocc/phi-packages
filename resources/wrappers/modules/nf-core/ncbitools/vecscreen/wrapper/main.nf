#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { NCBITOOLS_VECSCREEN } from '../main.nf'

params.fasta_file = null
params.adapters_database_directory = null
params.args = ""
params.outdir = "results"

workflow {
    fasta_file_ch = Channel
        .fromPath(params.fasta_file, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    adapters_database_directory_ch = Channel
        .fromPath(params.adapters_database_directory, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    NCBITOOLS_VECSCREEN(fasta_file_ch, adapters_database_directory_ch.first())
}
