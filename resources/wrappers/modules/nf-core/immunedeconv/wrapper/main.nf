#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { IMMUNEDECONV } from '../main.nf'

params.input_file = null
params.method = null
params.function = null
params.gene_symbol_col = null
params.outdir = "results"

workflow {
    input_file_ch = Channel
        .fromPath(params.input_file, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    IMMUNEDECONV(input_file_ch.map { t -> t + [params.method] }.map { t -> t + [params.function] }, params.gene_symbol_col)
}
