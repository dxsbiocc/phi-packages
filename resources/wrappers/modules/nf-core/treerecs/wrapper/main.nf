#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { TREERECS } from '../main.nf'

params.genetree = null
params.speciestree = null
params.args = ""
params.outdir = "results"

workflow {
    genetree_ch = Channel
        .fromPath(params.genetree, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    speciestree_ch = params.speciestree ? Channel.fromPath(params.speciestree, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    TREERECS(genetree_ch.combine(speciestree_ch))
}
