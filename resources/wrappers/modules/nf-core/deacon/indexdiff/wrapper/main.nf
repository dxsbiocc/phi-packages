#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { DEACON_INDEXDIFF } from '../main.nf'

params.index = null
params.genome = null
params.to = null
params.args = ""
params.outdir = "results"

workflow {
    index_ch = Channel
        .fromPath(params.index, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    genome_ch = Channel
        .fromPath(params.genome, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    to_ch = params.to ? Channel.fromPath(params.to, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    DEACON_INDEXDIFF(index_ch, genome_ch.combine(to_ch).first())
}
