#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { DEACON_INDEXUNION } from '../main.nf'

params.indices = null
params.s = null
params.args = ""
params.outdir = "results"

workflow {
    indices_ch = Channel
        .fromPath(params.indices, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    s_ch = params.s ? Channel.fromPath(params.s, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    DEACON_INDEXUNION(indices_ch.combine(s_ch))
}
