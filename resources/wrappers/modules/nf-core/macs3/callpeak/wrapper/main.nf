#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { MACS3_CALLPEAK } from '../main.nf'

params.ipbam = null
params.controlbam = null
params.macs3_gsize = null
params.args = ""
params.outdir = "results"

workflow {
    ipbam_ch = Channel
        .fromPath(params.ipbam, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    controlbam_ch = params.controlbam ? Channel.fromPath(params.controlbam, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    MACS3_CALLPEAK(ipbam_ch.combine(controlbam_ch), params.macs3_gsize)
}
