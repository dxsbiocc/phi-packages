#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { FORCE_CUBE } from '../main.nf'

params.aoi = null
params.mask = null
params.shapefile_dbf = null
params.shapefile_prj = null
params.shapefile_shx = null
params.args = ""
params.outdir = "results"

workflow {
    aoi_ch = Channel.fromPath(params.aoi, checkIfExists: true)
    mask_ch = Channel.fromPath(params.mask, checkIfExists: true).collect()
    shapefile_dbf_ch = Channel.fromPath(params.shapefile_dbf, checkIfExists: true)
    shapefile_prj_ch = Channel.fromPath(params.shapefile_prj, checkIfExists: true)
    shapefile_shx_ch = Channel.fromPath(params.shapefile_shx, checkIfExists: true)

    FORCE_CUBE(aoi_ch, mask_ch, shapefile_dbf_ch, shapefile_prj_ch, shapefile_shx_ch)
}
