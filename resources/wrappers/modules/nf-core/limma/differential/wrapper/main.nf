#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { LIMMA_DIFFERENTIAL } from '../main.nf'

params.contrast_variable = null
params.reference = null
params.target = null
params.formula = null
params.comparison = null
params.samplesheet = null
params.intensities = null
params.outdir = "results"

workflow {
    samplesheet_ch = Channel
        .fromPath(params.samplesheet, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    intensities_ch = params.intensities ? Channel.fromPath(params.intensities, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    LIMMA_DIFFERENTIAL(Channel.value([[id: 'input'], params.contrast_variable, params.reference, params.target, params.formula, params.comparison]), samplesheet_ch.combine(intensities_ch).first())
}
