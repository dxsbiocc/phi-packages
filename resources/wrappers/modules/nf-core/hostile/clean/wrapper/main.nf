#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { HOSTILE_CLEAN } from '../main.nf'

params.reads = null
params.reference_dir = null
params.reference_name = null
params.args = ""
params.outdir = "results"

workflow {
    reads_ch = Channel
        .fromPath("${params.reads}/*", checkIfExists: true)
        .collect()
        .map { files -> [[id: 'input'], files] }
    reference_dir_ch = Channel
        .fromPath(params.reference_dir, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    HOSTILE_CLEAN(reads_ch, reference_dir_ch.map { t -> t + [params.reference_name] }.first())
}
