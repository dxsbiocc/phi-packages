#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { RPBP_EXTRACTORFPROFILES } from '../main.nf'

params.bam = null
params.bai = null
params.lengths_offsets = null
params.orfs_genomic_bed = null
params.exons_bed = null
params.args = ""
params.outdir = "results"

workflow {
    bam_ch = Channel
        .fromPath(params.bam, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bai_ch = params.bai ? Channel.fromPath(params.bai, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    lengths_offsets_ch = params.lengths_offsets ? Channel.fromPath(params.lengths_offsets, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    orfs_genomic_bed_ch = Channel
        .fromPath(params.orfs_genomic_bed, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    exons_bed_ch = Channel
        .fromPath(params.exons_bed, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    RPBP_EXTRACTORFPROFILES(bam_ch.combine(bai_ch).combine(lengths_offsets_ch), orfs_genomic_bed_ch.first(), exons_bed_ch.first())
}
