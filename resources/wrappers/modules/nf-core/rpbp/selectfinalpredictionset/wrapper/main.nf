#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { RPBP_SELECTFINALPREDICTIONSET } from '../main.nf'

params.bayes_factors = null
params.genome_fasta = null
params.args = ""
params.outdir = "results"

workflow {
    bayes_factors_ch = Channel
        .fromPath(params.bayes_factors, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    genome_fasta_ch = Channel
        .fromPath(params.genome_fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    RPBP_SELECTFINALPREDICTIONSET(bayes_factors_ch, genome_fasta_ch.first())
}
