#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { RCLONE_CHECKSUM } from '../main.nf'

params.sumfile = null
params.hash = null
params.destination = null
params.rclone_config = null
params.args = ""
params.outdir = "results"

workflow {
    sumfile_ch = Channel
        .fromPath(params.sumfile, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    rclone_config_ch = Channel.fromPath(params.rclone_config, checkIfExists: true)

    RCLONE_CHECKSUM(sumfile_ch.map { t -> t + [params.hash] }.map { t -> t + [params.destination] }, rclone_config_ch)
}
