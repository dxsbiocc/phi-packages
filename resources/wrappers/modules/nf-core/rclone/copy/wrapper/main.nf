#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { RCLONE_COPY } from '../main.nf'

params.filter_file = null
params.source_path = null
params.destination_path = null
params.rclone_config = null
params.args = ""
params.outdir = "results"

workflow {
    filter_file_ch = Channel
        .fromPath(params.filter_file, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    rclone_config_ch = Channel.fromPath(params.rclone_config, checkIfExists: true)

    RCLONE_COPY(filter_file_ch.map { t -> t + [params.source_path] }.map { t -> t + [params.destination_path] }, rclone_config_ch)
}
