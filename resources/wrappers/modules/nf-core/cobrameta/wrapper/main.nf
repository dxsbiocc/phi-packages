#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { COBRAMETA } from '../main.nf'

params.fasta = null
params.coverage = null
params.query = null
params.bam = null
params.assembler = null
params.mink = null
params.maxk = null
params.args = ""
params.outdir = "results"

workflow {
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    coverage_ch = Channel
        .fromPath(params.coverage, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    query_ch = Channel
        .fromPath(params.query, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bam_ch = Channel
        .fromPath(params.bam, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    COBRAMETA(fasta_ch, coverage_ch.first(), query_ch.first(), bam_ch.first(), params.assembler, params.mink, params.maxk)
}
