#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { CHECKM_QA } from '../main.nf'

params.analysis_dir = null
params.marker_file = null
params.coverage_file = null
params.exclude_marker_file = null
params.db = null
params.args = ""
params.outdir = "results"

workflow {
    analysis_dir_ch = Channel
        .fromPath(params.analysis_dir, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    marker_file_ch = params.marker_file ? Channel.fromPath(params.marker_file, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    coverage_file_ch = params.coverage_file ? Channel.fromPath(params.coverage_file, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    exclude_marker_file_ch = Channel.fromPath(params.exclude_marker_file, checkIfExists: true)
    db_ch = params.db ? Channel.fromPath(params.db, checkIfExists: true).first() : Channel.value([])

    CHECKM_QA(analysis_dir_ch.combine(marker_file_ch).combine(coverage_file_ch), exclude_marker_file_ch, db_ch)
}
