#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { JVARKIT_VCF2TABLE } from '../main.nf'

params.vcf = null
params.tbi = null
params.regions_file = null
params.pedigree = null
params.args = ""
params.outdir = "results"

workflow {
    vcf_ch = Channel
        .fromPath(params.vcf, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    tbi_ch = params.tbi ? Channel.fromPath(params.tbi, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    regions_file_ch = params.regions_file ? Channel.fromPath(params.regions_file, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    pedigree_ch = Channel
        .fromPath(params.pedigree, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    JVARKIT_VCF2TABLE(vcf_ch.combine(tbi_ch).combine(regions_file_ch), pedigree_ch.first())
}
