#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { JVARKIT_SAM2TSV } from '../main.nf'

params.bam = null
params.bai = null
params.regions_file = null
params.fasta = null
params.fasta_index = null
params.fasta_dict = null
params.args = ""
params.outdir = "results"

workflow {
    bam_ch = Channel
        .fromPath(params.bam, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bai_ch = params.bai ? Channel.fromPath(params.bai, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    regions_file_ch = params.regions_file ? Channel.fromPath(params.regions_file, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fasta_index_ch = params.fasta_index ? Channel.fromPath(params.fasta_index, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_dict_ch = params.fasta_dict ? Channel.fromPath(params.fasta_dict, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    JVARKIT_SAM2TSV(bam_ch.combine(bai_ch).combine(regions_file_ch), fasta_ch.combine(fasta_index_ch).combine(fasta_dict_ch).first())
}
