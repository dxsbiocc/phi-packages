#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { GTDBTK_GTDBTONCBIMAJORITYVOTE } from '../main.nf'

params.gtdbtk_outdir = null
params.gtdbtk_prefix = null
params.ar53_metadata = null
params.bac120_metadata = null
params.args = ""
params.outdir = "results"

workflow {
    gtdbtk_outdir_ch = Channel
        .fromPath(params.gtdbtk_outdir, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    ar53_metadata_ch = Channel
        .fromPath(params.ar53_metadata, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bac120_metadata_ch = Channel
        .fromPath(params.bac120_metadata, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    GTDBTK_GTDBTONCBIMAJORITYVOTE(gtdbtk_outdir_ch.map { t -> t + [params.gtdbtk_prefix] }, ar53_metadata_ch.first(), bac120_metadata_ch.first())
}
