#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { GTDBTK_CLASSIFYWF } from '../main.nf'

params.bins = null
params.db = null
params.db_name = null
params.use_pplacer_scratch_dir = false
params.args = ""
params.outdir = "results"

workflow {
    bins_ch = Channel
        .fromPath(params.bins, checkIfExists: true)
        .collect()
        .map { files -> [[id: 'input'], files] }
    db_ch = Channel
        .fromPath(params.db, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    GTDBTK_CLASSIFYWF(bins_ch, db_ch.map { t -> t + [params.db_name] }.first(), params.use_pplacer_scratch_dir)
}
