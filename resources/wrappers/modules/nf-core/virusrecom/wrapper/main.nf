#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { VIRUSRECOM } from '../main.nf'

params.alignment = null
params.mapping = null
params.iwic = null
params.query = null
params.args = ""
params.outdir = "results"

workflow {
    alignment_ch = Channel
        .fromPath(params.alignment, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    mapping_ch = params.mapping ? Channel.fromPath(params.mapping, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    iwic_ch = params.iwic ? Channel.fromPath(params.iwic, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    VIRUSRECOM(alignment_ch.combine(mapping_ch).combine(iwic_ch), params.query)
}
