#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { WFMASH } from '../main.nf'

params.fasta_gz = null
params.paf = null
params.gzi = null
params.fai = null
params.query_self = false
params.fasta_query_list = null
params.args = ""
params.outdir = "results"

workflow {
    fasta_gz_ch = Channel
        .fromPath(params.fasta_gz, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    paf_ch = params.paf ? Channel.fromPath(params.paf, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    gzi_ch = params.gzi ? Channel.fromPath(params.gzi, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fai_ch = params.fai ? Channel.fromPath(params.fai, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_query_list_ch = params.fasta_query_list ? Channel.fromPath(params.fasta_query_list, checkIfExists: true).first() : Channel.value([])

    WFMASH(fasta_gz_ch.combine(paf_ch).combine(gzi_ch).combine(fai_ch), params.query_self, fasta_query_list_ch)
}
