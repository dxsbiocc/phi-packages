#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SRATOOLS_FASTERQDUMP } from '../main.nf'

params.sra = null
params.ncbi_settings = null
params.certificate = null
params.args = ""
params.outdir = "results"

workflow {
    sra_ch = Channel
        .fromPath(params.sra, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    ncbi_settings_ch = Channel.fromPath(params.ncbi_settings, checkIfExists: true)
    certificate_ch = Channel.fromPath(params.certificate, checkIfExists: true)

    SRATOOLS_FASTERQDUMP(sra_ch, ncbi_settings_ch, certificate_ch)
}
