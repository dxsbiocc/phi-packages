#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { DREP_DEREPLICATE } from '../main.nf'

params.fastas = null
params.drep_work = null
params.args = ""
params.outdir = "results"

workflow {
    fastas_ch = Channel
        .fromPath("${params.fastas}/*", checkIfExists: true)
        .collect()
        .map { files -> [[id: 'input'], files] }
    drep_work_ch = Channel
        .fromPath("${params.drep_work}/*", checkIfExists: true)
        .collect()
        .map { files -> [[id: 'input'], files] }

    DREP_DEREPLICATE(fastas_ch, drep_work_ch.first())
}
