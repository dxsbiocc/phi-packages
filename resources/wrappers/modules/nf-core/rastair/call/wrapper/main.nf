#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { RASTAIR_CALL } from '../main.nf'

params.bam = null
params.bai = null
params.fasta = null
params.fai = null
params.parsed_trim__o_t = null
params.parsed_trim__o_b = null
params.args = ""
params.outdir = "results"

workflow {
    bam_ch = Channel
        .fromPath(params.bam, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bai_ch = Channel
        .fromPath(params.bai, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fai_ch = Channel
        .fromPath(params.fai, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    RASTAIR_CALL(bam_ch, bai_ch.first(), fasta_ch.first(), fai_ch.first(), Channel.value([[id: 'input'], params.parsed_trim__o_t]), Channel.value([[id: 'input'], params.parsed_trim__o_b]))
}
