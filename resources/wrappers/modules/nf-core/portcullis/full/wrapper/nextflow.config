// Launcher config for the portcullis full wrapper adapter. Not part of the fixed
// wrapper/{main.nf,params.json,wrapper.yaml} contract — Nextflow picks this
// up automatically because it sits beside wrapper/main.nf.

process {
    cpus   = 8
    memory = '16.GB'
    time   = '8.h'

    withName: 'PORTCULLIS_FULL' {
        publishDir = [
            path: { "${params.outdir}/portcullis_full" },
            mode: 'copy',
            pattern: '{*.exon.gff3,*.intron.gff3,*.pass.junctions.bed,*.pass.junctions.tab,*.portcullis.log,*.spliced.bam,*.spliced.bam.bai}'
        ]
        ext.args = { params.args ?: '' }
    }
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}
