#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { HIPSTR } from '../main.nf'

params.alignment_files = null
params.alignment_indices = null
params.alignment_file_list = null
params.fasta = null
params.fai = null
params.ref_regions = null
params.ref_vcf = null
params.ref_vcf_tbi = null
params.snp_vcf = null
params.snp_vcf_tbi = null
params.stutter_in = null
params.fam = null
params.hap_chr_file = null
params.save_log = false
params.save_viz = false
params.save_stutter = false
params.args = ""
params.outdir = "results"

workflow {
    alignment_files_ch = Channel
        .fromPath(params.alignment_files, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    alignment_indices_ch = params.alignment_indices ? Channel.fromPath(params.alignment_indices, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    alignment_file_list_ch = params.alignment_file_list ? Channel.fromPath(params.alignment_file_list, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fai_ch = params.fai ? Channel.fromPath(params.fai, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    ref_regions_ch = Channel
        .fromPath(params.ref_regions, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    ref_vcf_ch = Channel
        .fromPath(params.ref_vcf, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    ref_vcf_tbi_ch = params.ref_vcf_tbi ? Channel.fromPath(params.ref_vcf_tbi, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    snp_vcf_ch = Channel
        .fromPath(params.snp_vcf, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    snp_vcf_tbi_ch = params.snp_vcf_tbi ? Channel.fromPath(params.snp_vcf_tbi, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    stutter_in_ch = Channel.fromPath(params.stutter_in, checkIfExists: true)
    fam_ch = Channel.fromPath(params.fam, checkIfExists: true)
    hap_chr_file_ch = Channel.fromPath(params.hap_chr_file, checkIfExists: true)

    HIPSTR(alignment_files_ch.combine(alignment_indices_ch).combine(alignment_file_list_ch), fasta_ch.combine(fai_ch).first(), ref_regions_ch.first(), ref_vcf_ch.combine(ref_vcf_tbi_ch).first(), snp_vcf_ch.combine(snp_vcf_tbi_ch).first(), stutter_in_ch, fam_ch, hap_chr_file_ch, params.save_log, params.save_viz, params.save_stutter)
}
