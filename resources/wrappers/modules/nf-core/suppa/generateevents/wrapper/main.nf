#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SUPPA_GENERATEEVENTS } from '../main.nf'

params.gtf = null
params.format = null
params.pool_genes = false
params.event_type = null
params.boundary = null
params.threshold = null
params.exon_length = null
params.args = ""
params.outdir = "results"

workflow {
    gtf_ch = Channel
        .fromPath(params.gtf, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    SUPPA_GENERATEEVENTS(gtf_ch, params.format, params.pool_genes, params.event_type, params.boundary, params.threshold, params.exon_length)
}
