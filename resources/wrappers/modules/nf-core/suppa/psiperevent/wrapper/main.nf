#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SUPPA_PSIPEREVENT } from '../main.nf'

params.expression = null
params.ioe = null
params.total_filter = null
params.args = ""
params.outdir = "results"

workflow {
    expression_ch = Channel
        .fromPath(params.expression, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    ioe_ch = Channel
        .fromPath(params.ioe, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    SUPPA_PSIPEREVENT(expression_ch, ioe_ch.first(), params.total_filter)
}
