#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SUPPA_DIFFSPLICE } from '../main.nf'

params.events = null
params.expression1 = null
params.psi1 = null
params.condition1 = null
params.expression2 = null
params.psi2 = null
params.condition2 = null
params.method = null
params.local_area = null
params.lower_bound_delta_psi = null
params.is_paired = false
params.gene_correction = false
params.multi_testing_correction_alpha = null
params.save_tpm_events = false
params.combination_analysis = false
params.use_median_delta_psi = false
params.tpm_threshold = null
params.nan_tpm_threshold = null
params.args = ""
params.outdir = "results"

workflow {
    events_ch = Channel
        .fromPath(params.events, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    expression1_ch = Channel
        .fromPath(params.expression1, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    psi1_ch = params.psi1 ? Channel.fromPath(params.psi1, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    expression2_ch = Channel
        .fromPath(params.expression2, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    psi2_ch = params.psi2 ? Channel.fromPath(params.psi2, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    SUPPA_DIFFSPLICE(events_ch, expression1_ch.combine(psi1_ch).map { t -> t + [params.condition1] }.first(), expression2_ch.combine(psi2_ch).map { t -> t + [params.condition2] }.first(), params.method, params.local_area, params.lower_bound_delta_psi, params.is_paired, params.gene_correction, params.multi_testing_correction_alpha, params.save_tpm_events, params.combination_analysis, params.use_median_delta_psi, params.tpm_threshold, params.nan_tpm_threshold)
}
