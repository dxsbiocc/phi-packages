#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SUPPA_CLUSTEREVENTS } from '../main.nf'

params.dpsi = null
params.psivec = null
params.significance_threshold = null
params.dpsi_threshold = null
params.maximum_distance = null
params.metric = null
params.separation = null
params.min_number_events = null
params.groups = null
params.clustering_method = null
params.args = ""
params.outdir = "results"

workflow {
    dpsi_ch = Channel
        .fromPath(params.dpsi, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    psivec_ch = params.psivec ? Channel.fromPath(params.psivec, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    SUPPA_CLUSTEREVENTS(dpsi_ch.combine(psivec_ch), params.significance_threshold, params.dpsi_threshold, params.maximum_distance, params.metric, params.separation, params.min_number_events, params.groups, params.clustering_method)
}
