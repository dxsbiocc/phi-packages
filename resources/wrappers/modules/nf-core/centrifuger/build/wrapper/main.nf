#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { CENTRIFUGER_BUILD } from '../main.nf'

params.references = null
params.taxonomy_nodes = null
params.taxonomy_names = null
params.conversion_table = null
params.args = ""
params.outdir = "results"

workflow {
    references_ch = Channel
        .fromPath("${params.references}/*", checkIfExists: true)
        .collect()
        .map { files -> [[id: 'input'], files] }
    taxonomy_nodes_ch = Channel.fromPath(params.taxonomy_nodes, checkIfExists: true)
    taxonomy_names_ch = Channel.fromPath(params.taxonomy_names, checkIfExists: true)
    conversion_table_ch = Channel.fromPath(params.conversion_table, checkIfExists: true)

    CENTRIFUGER_BUILD(references_ch, taxonomy_nodes_ch, taxonomy_names_ch, conversion_table_ch)
}
