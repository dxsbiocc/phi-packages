#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { CENTRIFUGER_QUANTIFICATION } from '../main.nf'

params.classification_file = null
params.db = null
params.taxonomy_nodes = null
params.taxonomy_names = null
params.size_table = null
params.args = ""
params.outdir = "results"

workflow {
    classification_file_ch = Channel
        .fromPath(params.classification_file, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    db_ch = Channel
        .fromPath(params.db, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    taxonomy_nodes_ch = Channel.fromPath(params.taxonomy_nodes, checkIfExists: true)
    taxonomy_names_ch = Channel.fromPath(params.taxonomy_names, checkIfExists: true)
    size_table_ch = Channel.fromPath(params.size_table, checkIfExists: true)

    CENTRIFUGER_QUANTIFICATION(classification_file_ch, db_ch.first(), taxonomy_nodes_ch, taxonomy_names_ch, size_table_ch)
}
