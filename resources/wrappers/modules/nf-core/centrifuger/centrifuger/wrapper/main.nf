#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { CENTRIFUGER_CENTRIFUGER } from '../main.nf'

params.reads = null
params.db = null
params.save_unclassified = false
params.save_classified = false
params.barcode = null
params.umi = null
params.args = ""
params.outdir = "results"

workflow {
    reads_ch = Channel
        .fromFilePairs(params.reads, size: -1)
        .map { sample, reads -> [[id: sample, single_end: reads instanceof List ? reads.size() == 1 : true], reads] }
    db_ch = Channel
        .fromPath(params.db, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    barcode_ch = Channel.fromPath(params.barcode, checkIfExists: true)
    umi_ch = Channel.fromPath(params.umi, checkIfExists: true)

    CENTRIFUGER_CENTRIFUGER(reads_ch, db_ch.first(), params.save_unclassified, params.save_classified, barcode_ch, umi_ch)
}
