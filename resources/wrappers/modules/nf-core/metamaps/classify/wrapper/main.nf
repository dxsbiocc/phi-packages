#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { METAMAPS_CLASSIFY } from '../main.nf'

params.classification_res = null
params.meta_file = null
params.meta_unmappedreads_lengths = null
params.para_file = null
params.database_folder = null
params.args = ""
params.outdir = "results"

workflow {
    classification_res_ch = Channel
        .fromPath(params.classification_res, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    meta_file_ch = params.meta_file ? Channel.fromPath(params.meta_file, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    meta_unmappedreads_lengths_ch = params.meta_unmappedreads_lengths ? Channel.fromPath(params.meta_unmappedreads_lengths, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    para_file_ch = params.para_file ? Channel.fromPath(params.para_file, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    database_folder_ch = params.database_folder ? Channel.fromPath(params.database_folder, checkIfExists: true).first() : Channel.value([])

    METAMAPS_CLASSIFY(classification_res_ch.combine(meta_file_ch).combine(meta_unmappedreads_lengths_ch).combine(para_file_ch), database_folder_ch)
}
