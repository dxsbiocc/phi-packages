#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { BIOAWK } from '../main.nf'

params.input = null
params.program_file = null
params.disable_redirect_output = false
params.output_file_extension = null
params.args = ""
params.outdir = "results"

workflow {
    input_ch = Channel
        .fromFilePairs(params.input, size: -1)
        .map { sample, reads -> [[id: sample, single_end: reads instanceof List ? reads.size() == 1 : true], reads] }
    program_file_ch = Channel.fromPath(params.program_file, checkIfExists: true)

    BIOAWK(input_ch, program_file_ch, params.disable_redirect_output, params.output_file_extension)
}
