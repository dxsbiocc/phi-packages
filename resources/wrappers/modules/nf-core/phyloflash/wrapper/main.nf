#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { PHYLOFLASH } from '../main.nf'

params.reads = null
params.silva_db = null
params.univec_db = null
params.args = ""
params.outdir = "results"

workflow {
    reads_ch = Channel
        .fromFilePairs(params.reads, size: -1)
        .map { sample, reads -> [[id: sample, single_end: reads instanceof List ? reads.size() == 1 : true], reads] }
    silva_db_ch = params.silva_db ? Channel.fromPath(params.silva_db, checkIfExists: true).first() : Channel.value([])
    univec_db_ch = params.univec_db ? Channel.fromPath(params.univec_db, checkIfExists: true).first() : Channel.value([])

    PHYLOFLASH(reads_ch, silva_db_ch, univec_db_ch)
}
