#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { REGENIE_STEP1 } from '../main.nf'

params.plink_genotype_file = null
params.plink_variant_file = null
params.plink_sample_file = null
params.pheno = null
params.covar = null
params.bsize = null
params.args = ""
params.outdir = "results"

workflow {
    plink_genotype_file_ch = Channel
        .fromPath(params.plink_genotype_file, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    plink_variant_file_ch = params.plink_variant_file ? Channel.fromPath(params.plink_variant_file, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    plink_sample_file_ch = params.plink_sample_file ? Channel.fromPath(params.plink_sample_file, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    pheno_ch = Channel
        .fromPath(params.pheno, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    covar_ch = Channel
        .fromPath(params.covar, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    REGENIE_STEP1(plink_genotype_file_ch.combine(plink_variant_file_ch).combine(plink_sample_file_ch), pheno_ch.first(), covar_ch.first(), params.bsize)
}
