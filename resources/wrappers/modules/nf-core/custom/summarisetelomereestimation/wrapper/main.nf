#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { CUSTOM_SUMMARISETELOMEREESTIMATION } from '../main.nf'

params.length_tsv = null
params.content_tsv = null
params.length_tool = null
params.outdir = "results"

workflow {
    length_tsv_ch = Channel
        .fromPath(params.length_tsv, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    content_tsv_ch = params.content_tsv ? Channel.fromPath(params.content_tsv, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    CUSTOM_SUMMARISETELOMEREESTIMATION(length_tsv_ch.combine(content_tsv_ch).map { t -> t + [params.length_tool] })
}
