#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { CUSTOM_COLLECTSTATS } from '../main.nf'

params.trimlogs = null
params.bblogs = null
params.idxstats = null
params.fcs = null
params.mergetab = null
params.samples_meta = null
params.outdir = "results"

workflow {
    trimlogs_ch = Channel
        .fromPath(params.trimlogs, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bblogs_ch = params.bblogs ? Channel.fromPath(params.bblogs, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    idxstats_ch = params.idxstats ? Channel.fromPath(params.idxstats, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fcs_ch = params.fcs ? Channel.fromPath(params.fcs, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    mergetab_ch = params.mergetab ? Channel.fromPath(params.mergetab, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    CUSTOM_COLLECTSTATS(trimlogs_ch.combine(bblogs_ch).combine(idxstats_ch).combine(fcs_ch).combine(mergetab_ch).map { t -> t + [params.samples_meta] })
}
