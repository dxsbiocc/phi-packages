#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { GMMDEMUX } from '../main.nf'

params.hto_matrix = null
params.hto_names = null
params.type_report = false
params.summary_report = false
params.skip = null
params.examine = null
params.args = ""
params.outdir = "results"

workflow {
    hto_matrix_ch = Channel
        .fromPath(params.hto_matrix, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    skip_ch = Channel.fromPath(params.skip, checkIfExists: true)
    examine_ch = Channel.fromPath(params.examine, checkIfExists: true)

    GMMDEMUX(hto_matrix_ch.map { t -> t + [params.hto_names] }, params.type_report, params.summary_report, skip_ch, examine_ch)
}
