#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { PARABRICKS_STARFUSION } from '../main.nf'

params.chimeric_junction = null
params.genome_lib_dir = null
params.args = ""
params.outdir = "results"

workflow {
    chimeric_junction_ch = Channel
        .fromPath(params.chimeric_junction, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    genome_lib_dir_ch = Channel
        .fromPath(params.genome_lib_dir, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    PARABRICKS_STARFUSION(chimeric_junction_ch, genome_lib_dir_ch.first())
}
