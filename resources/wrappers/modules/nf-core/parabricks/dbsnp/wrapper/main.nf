#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { PARABRICKS_DBSNP } from '../main.nf'

params.vcf_file = null
params.dbsnp_file = null
params.tabix_file = null
params.args = ""
params.outdir = "results"

workflow {
    vcf_file_ch = Channel
        .fromPath(params.vcf_file, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    dbsnp_file_ch = params.dbsnp_file ? Channel.fromPath(params.dbsnp_file, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    tabix_file_ch = params.tabix_file ? Channel.fromPath(params.tabix_file, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    PARABRICKS_DBSNP(vcf_file_ch.combine(dbsnp_file_ch).combine(tabix_file_ch))
}
