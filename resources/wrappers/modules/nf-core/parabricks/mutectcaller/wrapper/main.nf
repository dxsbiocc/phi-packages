#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { PARABRICKS_MUTECTCALLER } from '../main.nf'

params.tumor_bam = null
params.tumor_bam_index = null
params.normal_bam = null
params.normal_bam_index = null
params.intervals = null
params.fasta = null
params.fasta_fai = null
params.panel_of_normals = null
params.panel_of_normals_index = null
params.args = ""
params.outdir = "results"

workflow {
    tumor_bam_ch = Channel
        .fromPath(params.tumor_bam, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    tumor_bam_index_ch = params.tumor_bam_index ? Channel.fromPath(params.tumor_bam_index, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    normal_bam_ch = params.normal_bam ? Channel.fromPath(params.normal_bam, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    normal_bam_index_ch = params.normal_bam_index ? Channel.fromPath(params.normal_bam_index, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    intervals_ch = params.intervals ? Channel.fromPath(params.intervals, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fasta_fai_ch = params.fasta_fai ? Channel.fromPath(params.fasta_fai, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    panel_of_normals_ch = Channel.fromPath(params.panel_of_normals, checkIfExists: true)
    panel_of_normals_index_ch = params.panel_of_normals_index ? Channel.fromPath(params.panel_of_normals_index, checkIfExists: true).first() : Channel.value([])

    PARABRICKS_MUTECTCALLER(tumor_bam_ch.combine(tumor_bam_index_ch).combine(normal_bam_ch).combine(normal_bam_index_ch).combine(intervals_ch), fasta_ch.combine(fasta_fai_ch).first(), panel_of_normals_ch, panel_of_normals_index_ch)
}
