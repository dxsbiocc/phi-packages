#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { PARABRICKS_FQ2BAM } from '../main.nf'

params.reads = "https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/modules/data/genomics/sarscov2/genome/genome.fasta"
params.fasta = null
params.index = null
params.intervals = null
params.known_sites = null
params.output_fmt = null
params.args = ""
params.outdir = "results"

workflow {
    reads_ch = Channel
        .fromFilePairs(params.reads, size: -1)
        .map { sample, reads -> [[id: sample, single_end: reads instanceof List ? reads.size() == 1 : true], reads] }
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    index_ch = Channel
        .fromPath(params.index, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    intervals_ch = Channel
        .fromPath(params.intervals, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    known_sites_ch = Channel
        .fromPath(params.known_sites, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    PARABRICKS_FQ2BAM(reads_ch, fasta_ch.first(), index_ch.first(), intervals_ch.first(), known_sites_ch.first(), params.output_fmt)
}
