#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { PARABRICKS_DEEPVARIANT } from '../main.nf'

params.input = null
params.input_index = null
params.intervals = null
params.fasta = null
params.ref_meta = null
params.args = ""
params.outdir = "results"

workflow {
    input_ch = Channel
        .fromPath(params.input, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    input_index_ch = params.input_index ? Channel.fromPath(params.input_index, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    intervals_ch = params.intervals ? Channel.fromPath(params.intervals, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    PARABRICKS_DEEPVARIANT(input_ch.combine(input_index_ch).combine(intervals_ch), fasta_ch.map { t -> t + [params.ref_meta] }.first())
}
