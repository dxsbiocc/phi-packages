#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { PARABRICKS_APPLYBQSR } from '../main.nf'

params.bam = "https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/modules/data/genomics/sarscov2/genome/genome.fasta"
params.bai = null
params.bqsr_table = null
params.intervals = null
params.fasta = null
params.output_fmt = null
params.args = ""
params.outdir = "results"

workflow {
    bam_ch = Channel
        .fromPath(params.bam, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bai_ch = params.bai ? Channel.fromPath(params.bai, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    bqsr_table_ch = Channel
        .fromPath(params.bqsr_table, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    intervals_ch = Channel
        .fromPath(params.intervals, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    PARABRICKS_APPLYBQSR(bam_ch.combine(bai_ch), bqsr_table_ch.first(), intervals_ch.first(), fasta_ch.first(), params.output_fmt)
}
