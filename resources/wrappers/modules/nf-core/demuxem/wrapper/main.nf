#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { DEMUXEM } from '../main.nf'

params.input_raw_gene_bc_matrices_h5 = null
params.input_hto_csv_file = null
params.generate_gender_plot = null
params.genome = null
params.generate_diagnostic_plots = null
params.args = ""
params.outdir = "results"

workflow {
    input_raw_gene_bc_matrices_h5_ch = Channel
        .fromPath(params.input_raw_gene_bc_matrices_h5, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    input_hto_csv_file_ch = params.input_hto_csv_file ? Channel.fromPath(params.input_hto_csv_file, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    DEMUXEM(input_raw_gene_bc_matrices_h5_ch.combine(input_hto_csv_file_ch), params.generate_gender_plot, params.genome, params.generate_diagnostic_plots)
}
