#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { PORTELLO } from '../main.nf'

params.asm_to_ref_bam = null
params.asm_to_ref_bai = null
params.read_to_asm_bam = null
params.read_to_asm_bai = null
params.ref_fasta = null
params.assembly_mode = null
params.output_vcf = false
params.args = ""
params.outdir = "results"

workflow {
    asm_to_ref_bam_ch = Channel
        .fromPath(params.asm_to_ref_bam, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    asm_to_ref_bai_ch = params.asm_to_ref_bai ? Channel.fromPath(params.asm_to_ref_bai, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    read_to_asm_bam_ch = params.read_to_asm_bam ? Channel.fromPath(params.read_to_asm_bam, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    read_to_asm_bai_ch = params.read_to_asm_bai ? Channel.fromPath(params.read_to_asm_bai, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    ref_fasta_ch = params.ref_fasta ? Channel.fromPath(params.ref_fasta, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    PORTELLO(asm_to_ref_bam_ch.combine(asm_to_ref_bai_ch).combine(read_to_asm_bam_ch).combine(read_to_asm_bai_ch).combine(ref_fasta_ch).map { t -> t + [params.assembly_mode] }.map { t -> t + [params.output_vcf] })
}
