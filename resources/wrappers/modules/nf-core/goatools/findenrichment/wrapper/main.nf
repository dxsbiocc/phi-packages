#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { GOATOOLS_FINDENRICHMENT } from '../main.nf'

params.study_list = null
params.population_list = null
params.annotation = null
params.obo = null
params.goslim = null
params.args = ""
params.outdir = "results"

workflow {
    study_list_ch = Channel
        .fromPath(params.study_list, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    population_list_ch = params.population_list ? Channel.fromPath(params.population_list, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    annotation_ch = params.annotation ? Channel.fromPath(params.annotation, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    obo_ch = Channel.fromPath(params.obo, checkIfExists: true)
    goslim_ch = Channel.fromPath(params.goslim, checkIfExists: true)

    GOATOOLS_FINDENRICHMENT(study_list_ch.combine(population_list_ch).combine(annotation_ch), obo_ch, goslim_ch)
}
