#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { VG_CONSTRUCT } from '../main.nf'

params.input = null
params.tbis = null
params.insertions_fasta = null
params.fasta = null
params.fasta_fai = null
params.args = ""
params.outdir = "results"

workflow {
    input_ch = Channel
        .fromPath(params.input, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    tbis_ch = params.tbis ? Channel.fromPath(params.tbis, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    insertions_fasta_ch = params.insertions_fasta ? Channel.fromPath(params.insertions_fasta, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fasta_fai_ch = Channel
        .fromPath(params.fasta_fai, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    VG_CONSTRUCT(input_ch.combine(tbis_ch).combine(insertions_fasta_ch), fasta_ch.first(), fasta_fai_ch.first())
}
