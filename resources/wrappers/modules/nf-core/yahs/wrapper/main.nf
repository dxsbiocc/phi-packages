#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { YAHS } from '../main.nf'

params.fasta = null
params.fai = null
params.hic_map = null
params.agp = null
params.args = ""
params.outdir = "results"

workflow {
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fai_ch = params.fai ? Channel.fromPath(params.fai, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    hic_map_ch = params.hic_map ? Channel.fromPath(params.hic_map, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    agp_ch = params.agp ? Channel.fromPath(params.agp, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    YAHS(fasta_ch.combine(fai_ch).combine(hic_map_ch).combine(agp_ch))
}
