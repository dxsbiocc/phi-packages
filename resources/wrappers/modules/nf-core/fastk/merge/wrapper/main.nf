#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { FASTK_MERGE } from '../main.nf'

params.hist = null
params.ktab = null
params.prof = null
params.args = ""
params.outdir = "results"

workflow {
    hist_ch = Channel
        .fromPath(params.hist, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    ktab_ch = params.ktab ? Channel.fromPath(params.ktab, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    prof_ch = params.prof ? Channel.fromPath(params.prof, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    FASTK_MERGE(hist_ch.combine(ktab_ch).combine(prof_ch))
}
