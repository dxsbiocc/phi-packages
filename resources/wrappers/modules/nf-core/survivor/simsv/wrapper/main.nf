#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SURVIVOR_SIMSV } from '../main.nf'

params.fasta = null
params.fai = null
params.parameters = null
params.snp_mutation_frequency = null
params.sim_reads = null
params.outdir = "results"

workflow {
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fai_ch = Channel
        .fromPath(params.fai, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    parameters_ch = Channel
        .fromPath(params.parameters, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    SURVIVOR_SIMSV(fasta_ch, fai_ch.first(), parameters_ch.first(), params.snp_mutation_frequency, params.sim_reads)
}
