#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { FOLDMASON_MSA2LDDTREPORT } from '../main.nf'

params.msa = null
params.db = null
params.pdbs = null
params.tree = null
params.args = ""
params.outdir = "results"

workflow {
    msa_ch = Channel
        .fromPath(params.msa, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    db_ch = Channel
        .fromPath(params.db, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    pdbs_ch = Channel
        .fromPath(params.pdbs, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    tree_ch = Channel
        .fromPath(params.tree, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    FOLDMASON_MSA2LDDTREPORT(msa_ch, db_ch.first(), pdbs_ch.first(), tree_ch.first())
}
