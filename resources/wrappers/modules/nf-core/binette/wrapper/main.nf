#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { BINETTE } from '../main.nf'

params.contig2bin = null
params.bindirs = null
params.contigs = null
params.proteins = null
params.checkm2_db = null
params.args = ""
params.outdir = "results"

workflow {
    contig2bin_ch = Channel
        .fromPath(params.contig2bin, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bindirs_ch = params.bindirs ? Channel.fromPath(params.bindirs, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    contigs_ch = params.contigs ? Channel.fromPath(params.contigs, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    proteins_ch = params.proteins ? Channel.fromPath(params.proteins, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    checkm2_db_ch = Channel
        .fromPath(params.checkm2_db, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    BINETTE(contig2bin_ch.combine(bindirs_ch).combine(contigs_ch).combine(proteins_ch), checkm2_db_ch.first())
}
