#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { CELLRANGER_MKFASTQ } from '../main.nf'

params.csv = null
params.bcl = null
params.args = ""
params.outdir = "results"

workflow {
    csv_ch = Channel
        .fromPath(params.csv, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bcl_ch = params.bcl ? Channel.fromPath(params.bcl, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    CELLRANGER_MKFASTQ(csv_ch.combine(bcl_ch))
}
