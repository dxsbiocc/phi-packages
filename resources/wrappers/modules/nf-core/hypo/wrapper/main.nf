#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { HYPO } from '../main.nf'

params.sr_bam = null
params.reads = null
params.draft = null
params.genome_size = null
params.reads_coverage = null
params.args = ""
params.outdir = "results"

workflow {
    sr_bam_ch = Channel
        .fromPath(params.sr_bam, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    reads_ch = Channel
        .fromPath(params.reads, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    draft_ch = Channel.fromPath(params.draft, checkIfExists: true)

    HYPO(sr_bam_ch, reads_ch.first(), draft_ch, params.genome_size, params.reads_coverage)
}
