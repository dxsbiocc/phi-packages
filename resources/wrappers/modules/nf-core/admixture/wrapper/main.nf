#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { ADMIXTURE } from '../main.nf'

params.bed_ped_geno = null
params.bim_map = null
params.fam = null
params.k = null
params.args = ""
params.outdir = "results"

workflow {
    bed_ped_geno_ch = Channel
        .fromPath(params.bed_ped_geno, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bim_map_ch = params.bim_map ? Channel.fromPath(params.bim_map, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fam_ch = params.fam ? Channel.fromPath(params.fam, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    ADMIXTURE(bed_ped_geno_ch.combine(bim_map_ch).combine(fam_ch), params.k)
}
