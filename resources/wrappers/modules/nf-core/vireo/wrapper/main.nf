#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { VIREO } from '../main.nf'

params.cell_data = null
params.donor_file = null
params.vartrix_data = null
params.n_donor = null
params.args = ""
params.outdir = "results"

workflow {
    cell_data_ch = Channel
        .fromPath(params.cell_data, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    donor_file_ch = params.donor_file ? Channel.fromPath(params.donor_file, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    vartrix_data_ch = params.vartrix_data ? Channel.fromPath(params.vartrix_data, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    VIREO(cell_data_ch.combine(donor_file_ch).combine(vartrix_data_ch).map { t -> t + [params.n_donor] })
}
