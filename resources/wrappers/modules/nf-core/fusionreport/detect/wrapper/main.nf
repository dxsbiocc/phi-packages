#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { FUSIONREPORT_DETECT } from '../main.nf'

params.arriba_fusions = null
params.starfusion_fusions = null
params.fusioncatcher_fusions = null
params.fusionreport_ref = null
params.tools_cutoff = null
params.args = ""
params.outdir = "results"

workflow {
    arriba_fusions_ch = Channel
        .fromPath(params.arriba_fusions, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    starfusion_fusions_ch = params.starfusion_fusions ? Channel.fromPath(params.starfusion_fusions, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fusioncatcher_fusions_ch = params.fusioncatcher_fusions ? Channel.fromPath(params.fusioncatcher_fusions, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fusionreport_ref_ch = Channel
        .fromPath(params.fusionreport_ref, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    FUSIONREPORT_DETECT(arriba_fusions_ch.combine(starfusion_fusions_ch).combine(fusioncatcher_fusions_ch), fusionreport_ref_ch.first(), params.tools_cutoff)
}
