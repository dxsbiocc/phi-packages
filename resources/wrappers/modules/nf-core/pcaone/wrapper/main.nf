#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { PCAONE } from '../main.nf'

params.bed = null
params.bim = null
params.fam = null
params.args = ""
params.outdir = "results"

workflow {
    bed_ch = Channel
        .fromPath(params.bed, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bim_ch = params.bim ? Channel.fromPath(params.bim, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fam_ch = params.fam ? Channel.fromPath(params.fam, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    PCAONE(bed_ch.combine(bim_ch).combine(fam_ch))
}
