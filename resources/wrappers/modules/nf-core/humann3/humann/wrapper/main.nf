#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { HUMANN3_HUMANN } from '../main.nf'

params.input = null
params.profile = null
params.nucleotide_db = null
params.protein_db = null
params.utility_db = null
params.args = ""
params.outdir = "results"

workflow {
    input_ch = Channel
        .fromFilePairs(params.input, size: -1)
        .map { sample, reads -> [[id: sample, single_end: reads instanceof List ? reads.size() == 1 : true], reads] }
    profile_ch = Channel
        .fromPath(params.profile, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    nucleotide_db_ch = params.nucleotide_db ? Channel.fromPath(params.nucleotide_db, checkIfExists: true).first() : Channel.value([])
    protein_db_ch = params.protein_db ? Channel.fromPath(params.protein_db, checkIfExists: true).first() : Channel.value([])
    utility_db_ch = params.utility_db ? Channel.fromPath(params.utility_db, checkIfExists: true).first() : Channel.value([])

    HUMANN3_HUMANN(input_ch, profile_ch.first(), nucleotide_db_ch, protein_db_ch, utility_db_ch)
}
