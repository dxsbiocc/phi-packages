#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SIGPROFILER } from '../main.nf'

params.tsv_list = null
params.genome = null
params.genome_installed_path = null
params.seeds = null
params.outdir = "results"

workflow {
    tsv_list_ch = Channel
        .fromPath(params.tsv_list, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    genome_installed_path_ch = params.genome_installed_path ? Channel.fromPath(params.genome_installed_path, checkIfExists: true).first() : Channel.value([])
    seeds_ch = Channel.fromPath(params.seeds, checkIfExists: true)

    SIGPROFILER(tsv_list_ch, params.genome, genome_installed_path_ch, seeds_ch)
}
