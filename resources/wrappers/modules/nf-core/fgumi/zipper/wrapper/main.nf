#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { FGUMI_ZIPPER } from '../main.nf'

params.bam = null
params.unmapped = null
params.fasta = null
params.fai = null
params.dict = null
params.args = ""
params.outdir = "results"

workflow {
    bam_ch = Channel
        .fromPath(params.bam, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    unmapped_ch = params.unmapped ? Channel.fromPath(params.unmapped, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fai_ch = params.fai ? Channel.fromPath(params.fai, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    dict_ch = params.dict ? Channel.fromPath(params.dict, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    FGUMI_ZIPPER(bam_ch.combine(unmapped_ch), fasta_ch.combine(fai_ch).combine(dict_ch).first())
}
