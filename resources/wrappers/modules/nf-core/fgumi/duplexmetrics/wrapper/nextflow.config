// Launcher config for the fgumi duplexmetrics wrapper adapter. Not part of the fixed
// wrapper/{main.nf,params.json,wrapper.yaml} contract — Nextflow picks this
// up automatically because it sits beside wrapper/main.nf.

process {
    cpus   = 1
    memory = '2.GB'
    time   = '1.h'

    withName: 'FGUMI_DUPLEXMETRICS' {
        publishDir = [
            path: { "${params.outdir}/fgumi_duplexmetrics" },
            mode: 'copy',
            pattern: '{*.duplex_family_sizes.txt,*.duplex_qc.pdf,*.duplex_umi_counts.txt,*.duplex_yield_metrics.txt,*.family_sizes.txt,*.umi_counts.txt}'
        ]
        ext.args = { params.args ?: '' }
    }
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}
