#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { HTSNIMTOOLS_VCFCHECK } from '../main.nf'

params.vcf = null
params.tbi = null
params.background_vcf = null
params.background_tbi = null
params.args = ""
params.outdir = "results"

workflow {
    vcf_ch = Channel
        .fromPath(params.vcf, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    tbi_ch = params.tbi ? Channel.fromPath(params.tbi, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    background_vcf_ch = Channel
        .fromPath(params.background_vcf, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    background_tbi_ch = params.background_tbi ? Channel.fromPath(params.background_tbi, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    HTSNIMTOOLS_VCFCHECK(vcf_ch.combine(tbi_ch), background_vcf_ch.combine(background_tbi_ch).first())
}
