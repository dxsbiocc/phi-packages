#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { CIRCULARMAPPER_REALIGNSAMFILE } from '../main.nf'

params.bam = null
params.fasta = null
params.elongation_factor = null
params.elongated_chr_list = null
params.args = ""
params.outdir = "results"

workflow {
    bam_ch = Channel
        .fromPath(params.bam, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    elongated_chr_list_ch = Channel
        .fromPath(params.elongated_chr_list, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    CIRCULARMAPPER_REALIGNSAMFILE(bam_ch, fasta_ch.first(), Channel.value([[id: 'input'], params.elongation_factor]), elongated_chr_list_ch.first())
}
