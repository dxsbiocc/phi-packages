#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { PICRUST2_PIPELINE } from '../main.nf'

params.sequences = null
params.otu_table = null
params.args = ""
params.outdir = "results"

workflow {
    sequences_ch = Channel
        .fromPath(params.sequences, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    otu_table_ch = params.otu_table ? Channel.fromPath(params.otu_table, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    PICRUST2_PIPELINE(sequences_ch.combine(otu_table_ch))
}
