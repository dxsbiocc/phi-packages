#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { T1K_RUN } from '../main.nf'

params.input = null
params.fasta = null
params.cordinates = null
params.barcodes = null
params.barcodewhitelist = null
params.args = ""
params.outdir = "results"

workflow {
    input_ch = Channel
        .fromFilePairs(params.input, size: -1)
        .map { sample, reads -> [[id: sample, single_end: reads instanceof List ? reads.size() == 1 : true], reads] }
    fasta_ch = params.fasta ? Channel.fromPath(params.fasta, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    cordinates_ch = params.cordinates ? Channel.fromPath(params.cordinates, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    barcodes_ch = params.barcodes ? Channel.fromPath(params.barcodes, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    barcodewhitelist_ch = params.barcodewhitelist ? Channel.fromPath(params.barcodewhitelist, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    T1K_RUN(input_ch.combine(fasta_ch).combine(cordinates_ch).combine(barcodes_ch).combine(barcodewhitelist_ch))
}
