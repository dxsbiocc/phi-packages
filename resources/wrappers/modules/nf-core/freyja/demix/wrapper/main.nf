#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { FREYJA_DEMIX } from '../main.nf'

params.variants = null
params.depths = null
params.barcodes = null
params.lineages_meta = null
params.lineages_topology = null
params.args = ""
params.outdir = "results"

workflow {
    variants_ch = Channel
        .fromPath(params.variants, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    depths_ch = params.depths ? Channel.fromPath(params.depths, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    barcodes_ch = Channel.fromPath(params.barcodes, checkIfExists: true)
    lineages_meta_ch = Channel.fromPath(params.lineages_meta, checkIfExists: true)
    lineages_topology_ch = Channel.fromPath(params.lineages_topology, checkIfExists: true)

    FREYJA_DEMIX(variants_ch.combine(depths_ch), barcodes_ch, lineages_meta_ch, lineages_topology_ch)
}
