// Launcher config for the longstitch wrapper adapter. Not part of the fixed
// wrapper/{main.nf,params.json,wrapper.yaml} contract — Nextflow picks this
// up automatically because it sits beside wrapper/main.nf.

process {
    cpus   = 4
    memory = '8.GB'
    time   = '4.h'

    withName: 'LONGSTITCH' {
        publishDir = [
            path: { "${params.outdir}/longstitch" },
            mode: 'copy',
            pattern: '{*.k*.w???.tsv,*.ntLink-arks.fa,*.tigmint-ntLink-arks.fa,*.tigmint-ntLink.fa,*k*.w*.z*.n*.scaffold.dot,*k*.w*.z*.ntLink.scaffolds.fa,*k*.w*.z*.ntLink.scaffolds.renamed.fa,*k*.w*.z*.ntLink.scaffolds_*.dist.gv,*k*.w*.z*.ntLink.scaffolds_*.tigpair_checkpoint.tsv,*k*.w*.z*.ntLink.scaffolds_*_l*.*.tigpair_checkpoint.tsv,*k*.w*.z*.ntLink.scaffolds_*_l*.assembly_correspondence.tsv,*k*.w*.z*.ntLink.scaffolds_*_l*.gv,*k*.w*.z*.ntLink.scaffolds_*_l*.log,*k*.w*.z*.ntLink.scaffolds_*_l*.scaffolds,*k*.w*.z*.ntLink.scaffolds_*_l*.scaffolds.fa,*k*.w*.z*.ntLink.scaffolds_*_main.tsv,*k*.w*.z*.ntLink.scaffolds_*_original.gv,*k*.w*.z*.stitch.abyss-scaffold.fa,*k*.w*.z*.stitch.path,*k*.w*.z*.trimmed_scafs.agp,*k*.w*.z*.trimmed_scafs.fa,*k*.w*.z*.trimmed_scafs.path,*k*.w*.z*.trimmed_scafs.tsv,*k*.w*.z*.verbose_mapping.tsv}'
        ]
        ext.args = { params.args ?: '' }
    }
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}
