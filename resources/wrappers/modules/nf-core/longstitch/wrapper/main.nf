#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { LONGSTITCH } from '../main.nf'

params.assembly = null
params.reads = null
params.command = null
params.span = null
params.genomesize = null
params.longmap = null
params.args = ""
params.outdir = "results"

workflow {
    assembly_ch = Channel
        .fromPath(params.assembly, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    reads_ch = Channel
        .fromPath(params.reads, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    LONGSTITCH(assembly_ch, reads_ch.first(), params.command, params.span, params.genomesize, params.longmap)
}
