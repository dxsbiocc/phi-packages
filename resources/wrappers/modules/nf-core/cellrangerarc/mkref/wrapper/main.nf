#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { CELLRANGERARC_MKREF } from '../main.nf'

params.fasta = null
params.gtf = null
params.motifs = null
params.reference_config = null
params.args = ""
params.outdir = "results"

workflow {
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    gtf_ch = params.gtf ? Channel.fromPath(params.gtf, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    motifs_ch = params.motifs ? Channel.fromPath(params.motifs, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    reference_config_ch = params.reference_config ? Channel.fromPath(params.reference_config, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    CELLRANGERARC_MKREF(fasta_ch.combine(gtf_ch).combine(motifs_ch).combine(reference_config_ch))
}
