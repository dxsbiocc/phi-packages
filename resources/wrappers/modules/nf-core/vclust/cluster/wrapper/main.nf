#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { VCLUST_CLUSTER } from '../main.nf'

params.tsv = null
params.ids = null
params.metric = null
params.tani = null
params.gani = null
params.ani = null
params.args = ""
params.outdir = "results"

workflow {
    tsv_ch = Channel
        .fromPath(params.tsv, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    ids_ch = Channel
        .fromPath(params.ids, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    VCLUST_CLUSTER(tsv_ch, ids_ch.first(), params.metric, params.tani, params.gani, params.ani)
}
