#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { CONCOCT_EXTRACTFASTABINS } from '../main.nf'

params.original_fasta = null
params.csv = null
params.args = ""
params.outdir = "results"

workflow {
    original_fasta_ch = Channel
        .fromPath(params.original_fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    csv_ch = params.csv ? Channel.fromPath(params.csv, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    CONCOCT_EXTRACTFASTABINS(original_fasta_ch.combine(csv_ch))
}
