#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { CONCOCT_CONCOCTCOVERAGETABLE } from '../main.nf'

params.bed = null
params.bamfiles = null
params.baifiles = null
params.args = ""
params.outdir = "results"

workflow {
    bed_ch = Channel
        .fromPath(params.bed, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bamfiles_ch = params.bamfiles ? Channel.fromPath(params.bamfiles, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    baifiles_ch = params.baifiles ? Channel.fromPath(params.baifiles, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    CONCOCT_CONCOCTCOVERAGETABLE(bed_ch.combine(bamfiles_ch).combine(baifiles_ch))
}
