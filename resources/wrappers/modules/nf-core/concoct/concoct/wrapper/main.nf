#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { CONCOCT_CONCOCT } from '../main.nf'

params.coverage_file = null
params.fasta = null
params.args = ""
params.outdir = "results"

workflow {
    coverage_file_ch = Channel
        .fromPath(params.coverage_file, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fasta_ch = params.fasta ? Channel.fromPath(params.fasta, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    CONCOCT_CONCOCT(coverage_file_ch.combine(fasta_ch))
}
