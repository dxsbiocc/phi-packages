#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { MUDSKIPPER_BULK } from '../main.nf'

params.bam = null
params.index = null
params.gtf = null
params.rad = null
params.args = ""
params.outdir = "results"

workflow {
    bam_ch = Channel
        .fromPath(params.bam, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    index_ch = Channel
        .fromPath(params.index, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    gtf_ch = params.gtf ? Channel.fromPath(params.gtf, checkIfExists: true).first() : Channel.value([])

    MUDSKIPPER_BULK(bam_ch, index_ch.first(), gtf_ch, params.rad)
}
