#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { AMULETY_TRANSLATE } from '../main.nf'

params.tsv = null
params.reference_igblast = null
params.args = ""
params.outdir = "results"

workflow {
    tsv_ch = Channel
        .fromPath(params.tsv, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    reference_igblast_ch = params.reference_igblast ? Channel.fromPath(params.reference_igblast, checkIfExists: true).first() : Channel.value([])

    AMULETY_TRANSLATE(tsv_ch, reference_igblast_ch)
}
