#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { MSISENSORPRO_BASELINE } from '../main.nf'

params.list = null
params.pro_all_files = null
params.args = ""
params.outdir = "results"

workflow {
    list_ch = Channel
        .fromPath(params.list, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    pro_all_files_ch = Channel
        .fromPath("${params.pro_all_files}/*", checkIfExists: true)
        .collect()
        .map { files -> [[id: 'input'], files] }

    MSISENSORPRO_BASELINE(list_ch, pro_all_files_ch.first())
}
