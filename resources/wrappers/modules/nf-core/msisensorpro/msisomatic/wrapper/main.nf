#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { MSISENSORPRO_MSISOMATIC } from '../main.nf'

params.normal = null
params.normal_index = null
params.tumor = null
params.tumor_index = null
params.intervals = null
params.fasta = null
params.msisensor_scan = null
params.args = ""
params.outdir = "results"

workflow {
    normal_ch = Channel
        .fromPath(params.normal, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    normal_index_ch = params.normal_index ? Channel.fromPath(params.normal_index, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    tumor_ch = params.tumor ? Channel.fromPath(params.tumor, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    tumor_index_ch = params.tumor_index ? Channel.fromPath(params.tumor_index, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    intervals_ch = params.intervals ? Channel.fromPath(params.intervals, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    msisensor_scan_ch = Channel.fromPath(params.msisensor_scan, checkIfExists: true)

    MSISENSORPRO_MSISOMATIC(normal_ch.combine(normal_index_ch).combine(tumor_ch).combine(tumor_index_ch).combine(intervals_ch), fasta_ch.first(), msisensor_scan_ch)
}
