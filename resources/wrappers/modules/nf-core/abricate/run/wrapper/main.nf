#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { ABRICATE_RUN } from '../main.nf'

params.assembly = null
params.databasedir = null
params.args = ""
params.outdir = "results"

workflow {
    assembly_ch = Channel
        .fromPath(params.assembly, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    databasedir_ch = params.databasedir ? Channel.fromPath(params.databasedir, checkIfExists: true).first() : Channel.value([])

    ABRICATE_RUN(assembly_ch, databasedir_ch)
}
