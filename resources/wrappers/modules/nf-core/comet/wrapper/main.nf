#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { COMET } from '../main.nf'

params.mzml = null
params.fasta = null
params.comet_params = null
params.args = ""
params.outdir = "results"

workflow {
    mzml_ch = Channel
        .fromPath(params.mzml, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fasta_ch = params.fasta ? Channel.fromPath(params.fasta, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    comet_params_ch = params.comet_params ? Channel.fromPath(params.comet_params, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    COMET(mzml_ch.combine(fasta_ch).combine(comet_params_ch))
}
