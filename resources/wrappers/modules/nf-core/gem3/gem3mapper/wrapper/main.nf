#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { GEM3_GEM3MAPPER } from '../main.nf'

params.gem = null
params.fastq = null
params.sort_bam = false
params.args = ""
params.outdir = "results"

workflow {
    gem_ch = Channel
        .fromPath(params.gem, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fastq_ch = Channel
        .fromPath(params.fastq, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    GEM3_GEM3MAPPER(gem_ch, fastq_ch.first(), params.sort_bam)
}
