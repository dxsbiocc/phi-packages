#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { PERBASE } from '../main.nf'

params.bam = null
params.index = null
params.bed = null
params.fasta = null
params.fai = null
params.args = ""
params.outdir = "results"

workflow {
    bam_ch = Channel
        .fromPath(params.bam, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    index_ch = params.index ? Channel.fromPath(params.index, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    bed_ch = params.bed ? Channel.fromPath(params.bed, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fai_ch = params.fai ? Channel.fromPath(params.fai, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    PERBASE(bam_ch.combine(index_ch).combine(bed_ch), fasta_ch.combine(fai_ch).first())
}
