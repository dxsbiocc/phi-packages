#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { CHROMOGRAPH } from '../main.nf'

params.autozyg = null
params.coverage = null
params.exome = null
params.fracsnp = null
params.ideogram = null
params.regions = null
params.sites = null
params.args = ""
params.outdir = "results"

workflow {
    autozyg_ch = Channel
        .fromPath(params.autozyg, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    coverage_ch = Channel
        .fromPath(params.coverage, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    exome_ch = Channel
        .fromPath(params.exome, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fracsnp_ch = Channel
        .fromPath(params.fracsnp, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    ideogram_ch = Channel
        .fromPath(params.ideogram, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    regions_ch = Channel
        .fromPath(params.regions, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    sites_ch = Channel
        .fromPath(params.sites, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    CHROMOGRAPH(autozyg_ch, coverage_ch.first(), exome_ch.first(), fracsnp_ch.first(), ideogram_ch.first(), regions_ch.first(), sites_ch.first())
}
