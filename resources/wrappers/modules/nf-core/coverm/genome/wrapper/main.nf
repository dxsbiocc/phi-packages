#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { COVERM_GENOME } from '../main.nf'

params.input = null
params.reference = null
params.bam_input = false
params.interleaved = false
params.ref_mode = null
params.enable_bam_output = false
params.args = ""
params.outdir = "results"

workflow {
    input_ch = Channel
        .fromFilePairs(params.input, size: -1)
        .map { sample, reads -> [[id: sample, single_end: reads instanceof List ? reads.size() == 1 : true], reads] }
    reference_ch = Channel
        .fromPath(params.reference, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    COVERM_GENOME(input_ch, reference_ch.first(), params.bam_input, params.interleaved, params.ref_mode, params.enable_bam_output)
}
