#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { HICAP } from '../main.nf'

params.fasta = null
params.database_dir = null
params.model_fp = null
params.args = ""
params.outdir = "results"

workflow {
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    database_dir_ch = params.database_dir ? Channel.fromPath(params.database_dir, checkIfExists: true).first() : Channel.value([])
    model_fp_ch = Channel.fromPath(params.model_fp, checkIfExists: true)

    HICAP(fasta_ch, database_dir_ch, model_fp_ch)
}
