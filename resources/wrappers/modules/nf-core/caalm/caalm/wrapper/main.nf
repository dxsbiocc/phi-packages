#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { CAALM_CAALM } from '../main.nf'

params.fasta = null
params.level0 = null
params.level1 = null
params.level2 = null
params.args = ""
params.outdir = "results"

workflow {
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    level0_ch = Channel
        .fromPath(params.level0, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    level1_ch = params.level1 ? Channel.fromPath(params.level1, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    level2_ch = params.level2 ? Channel.fromPath(params.level2, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    CAALM_CAALM(fasta_ch, level0_ch.combine(level1_ch).combine(level2_ch).first())
}
