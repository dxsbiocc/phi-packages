#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { RHOCALL_ANNOTATE } from '../main.nf'

params.vcf = null
params.tbi = null
params.roh = null
params.bed = null
params.args = ""
params.outdir = "results"

workflow {
    vcf_ch = Channel
        .fromPath(params.vcf, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    tbi_ch = params.tbi ? Channel.fromPath(params.tbi, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    roh_ch = Channel
        .fromPath(params.roh, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bed_ch = params.bed ? Channel.fromPath(params.bed, checkIfExists: true).first() : Channel.value([])

    RHOCALL_ANNOTATE(vcf_ch.combine(tbi_ch), roh_ch.first(), bed_ch)
}
