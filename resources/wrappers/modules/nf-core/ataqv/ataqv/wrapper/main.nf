#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { ATAQV_ATAQV } from '../main.nf'

params.bam = null
params.bai = null
params.peak_file = null
params.organism = null
params.mito_name = null
params.tss_file = null
params.excl_regs_file = null
params.autosom_ref_file = null
params.args = ""
params.outdir = "results"

workflow {
    bam_ch = Channel
        .fromPath(params.bam, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bai_ch = params.bai ? Channel.fromPath(params.bai, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    peak_file_ch = params.peak_file ? Channel.fromPath(params.peak_file, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    tss_file_ch = Channel.fromPath(params.tss_file, checkIfExists: true)
    excl_regs_file_ch = Channel.fromPath(params.excl_regs_file, checkIfExists: true)
    autosom_ref_file_ch = Channel.fromPath(params.autosom_ref_file, checkIfExists: true)

    ATAQV_ATAQV(bam_ch.combine(bai_ch).combine(peak_file_ch), params.organism, params.mito_name, tss_file_ch, excl_regs_file_ch, autosom_ref_file_ch)
}
