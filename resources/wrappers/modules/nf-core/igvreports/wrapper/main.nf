#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { IGVREPORTS } from '../main.nf'

params.sites = null
params.tracks = null
params.tracks_indices = null
params.fasta = null
params.fai = null
params.args = ""
params.outdir = "results"

workflow {
    sites_ch = Channel
        .fromPath(params.sites, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    tracks_ch = params.tracks ? Channel.fromPath(params.tracks, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    tracks_indices_ch = params.tracks_indices ? Channel.fromPath(params.tracks_indices, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fai_ch = params.fai ? Channel.fromPath(params.fai, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    IGVREPORTS(sites_ch.combine(tracks_ch).combine(tracks_indices_ch), fasta_ch.combine(fai_ch).first())
}
