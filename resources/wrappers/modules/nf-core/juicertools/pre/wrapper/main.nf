#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { JUICERTOOLS_PRE } from '../main.nf'

params.pairs = null
params.chromsizes = null
params.genome_id = null
params.args = ""
params.outdir = "results"

workflow {
    pairs_ch = Channel
        .fromPath(params.pairs, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    chromsizes_ch = Channel
        .fromPath(params.chromsizes, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    JUICERTOOLS_PRE(pairs_ch, chromsizes_ch.map { t -> t + [params.genome_id] }.first())
}
