#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { CLUSTALO_ALIGN } from '../main.nf'

params.fasta = null
params.tree = null
params.hmm_in = null
params.hmm_batch = null
params.profile1 = null
params.profile2 = null
params.compress = false
params.args = ""
params.outdir = "results"

workflow {
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    tree_ch = Channel
        .fromPath(params.tree, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    hmm_in_ch = Channel.fromPath(params.hmm_in, checkIfExists: true)
    hmm_batch_ch = Channel.fromPath(params.hmm_batch, checkIfExists: true)
    profile1_ch = Channel.fromPath(params.profile1, checkIfExists: true)
    profile2_ch = Channel.fromPath(params.profile2, checkIfExists: true)

    CLUSTALO_ALIGN(fasta_ch, tree_ch.first(), hmm_in_ch, hmm_batch_ch, profile1_ch, profile2_ch, params.compress)
}
