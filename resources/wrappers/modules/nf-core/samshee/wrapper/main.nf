#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SAMSHEE } from '../main.nf'

params.samplesheet = null
params.file_schema_validator = null
params.args = ""
params.outdir = "results"

workflow {
    samplesheet_ch = Channel
        .fromPath(params.samplesheet, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    file_schema_validator_ch = Channel.fromPath(params.file_schema_validator, checkIfExists: true)

    SAMSHEE(samplesheet_ch, file_schema_validator_ch)
}
