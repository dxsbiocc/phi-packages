#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { PLASTID_MAKEWIGGLE } from '../main.nf'

params.bam = null
params.bam_index = null
params.p_offsets = null
params.mapping_rule = null
params.args = ""
params.outdir = "results"

workflow {
    bam_ch = Channel
        .fromPath(params.bam, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bam_index_ch = params.bam_index ? Channel.fromPath(params.bam_index, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    p_offsets_ch = params.p_offsets ? Channel.fromPath(params.p_offsets, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    PLASTID_MAKEWIGGLE(bam_ch.combine(bam_index_ch).combine(p_offsets_ch), params.mapping_rule)
}
