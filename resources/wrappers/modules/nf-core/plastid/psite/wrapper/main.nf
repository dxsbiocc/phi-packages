#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { PLASTID_PSITE } from '../main.nf'

params.bam = null
params.bam_index = null
params.rois_txt = null
params.args = ""
params.outdir = "results"

workflow {
    bam_ch = Channel
        .fromPath(params.bam, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bam_index_ch = params.bam_index ? Channel.fromPath(params.bam_index, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    rois_txt_ch = Channel
        .fromPath(params.rois_txt, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    PLASTID_PSITE(bam_ch.combine(bam_index_ch), rois_txt_ch.first())
}
