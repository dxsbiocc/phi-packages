#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { KHMER_NORMALIZEBYMEDIAN } from '../main.nf'

params.fastq_paired = null
params.fastq_unpaired = null
params.args = ""
params.outdir = "results"

workflow {
    fastq_paired_ch = Channel
        .fromFilePairs(params.fastq_paired, size: -1)
        .map { sample, reads -> [[id: sample, single_end: reads instanceof List ? reads.size() == 1 : true], reads] }
    fastq_unpaired_ch = params.fastq_unpaired ? Channel.fromPath(params.fastq_unpaired, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    KHMER_NORMALIZEBYMEDIAN(fastq_paired_ch.combine(fastq_unpaired_ch))
}
