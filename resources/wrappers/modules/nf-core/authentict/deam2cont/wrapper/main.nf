#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { AUTHENTICT_DEAM2CONT } from '../main.nf'

params.bam = null
params.config = null
params.positions = null
params.args = ""
params.outdir = "results"

workflow {
    bam_ch = Channel
        .fromPath(params.bam, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    config_ch = Channel
        .fromPath(params.config, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    positions_ch = Channel
        .fromPath(params.positions, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    AUTHENTICT_DEAM2CONT(bam_ch, config_ch.first(), positions_ch.first())
}
