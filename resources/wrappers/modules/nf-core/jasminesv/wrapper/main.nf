#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { JASMINESV } from '../main.nf'

params.vcfs = null
params.bams = null
params.bais = null
params.sample_dists = null
params.fasta = null
params.fasta_fai = null
params.chr_norm = null
params.args = ""
params.outdir = "results"

workflow {
    vcfs_ch = Channel
        .fromPath(params.vcfs, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bams_ch = params.bams ? Channel.fromPath(params.bams, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    bais_ch = params.bais ? Channel.fromPath(params.bais, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    sample_dists_ch = params.sample_dists ? Channel.fromPath(params.sample_dists, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fasta_fai_ch = Channel
        .fromPath(params.fasta_fai, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    chr_norm_ch = Channel.fromPath(params.chr_norm, checkIfExists: true)

    JASMINESV(vcfs_ch.combine(bams_ch).combine(bais_ch).combine(sample_dists_ch), fasta_ch.first(), fasta_fai_ch.first(), chr_norm_ch)
}
