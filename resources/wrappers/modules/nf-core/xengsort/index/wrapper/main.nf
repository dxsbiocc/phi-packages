#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { XENGSORT_INDEX } from '../main.nf'

params.host_fasta = null
params.graft_fasta = null
params.nobjects = null
params.args = ""
params.outdir = "results"

workflow {
    host_fasta_ch = Channel
        .fromPath("${params.host_fasta}/*", checkIfExists: true)
        .collect()
        .map { files -> [[id: 'input'], files] }
    graft_fasta_ch = Channel
        .fromPath("${params.graft_fasta}/*", checkIfExists: true)
        .collect()
        .map { files -> [[id: 'input'], files] }

    XENGSORT_INDEX(host_fasta_ch, graft_fasta_ch.first(), params.nobjects)
}
