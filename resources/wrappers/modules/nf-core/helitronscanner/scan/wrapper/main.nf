#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { HELITRONSCANNER_SCAN } from '../main.nf'

params.fasta = null
params.command = null
params.lcv_filepath = null
params.buffer_size = null
params.args = ""
params.outdir = "results"

workflow {
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    lcv_filepath_ch = Channel.fromPath(params.lcv_filepath, checkIfExists: true)

    HELITRONSCANNER_SCAN(fasta_ch, params.command, lcv_filepath_ch, params.buffer_size)
}
