// Launcher config for the genomad endtoend wrapper adapter. Not part of the fixed
// wrapper/{main.nf,params.json,wrapper.yaml} contract — Nextflow picks this
// up automatically because it sits beside wrapper/main.nf.

process {
    cpus   = 8
    memory = '16.GB'
    time   = '8.h'

    withName: 'GENOMAD_ENDTOEND' {
        publishDir = [
            path: { "${params.outdir}/genomad_endtoend" },
            mode: 'copy',
            pattern: '{${prefix}/*_aggregated_classification/*_aggregated_classification.tsv,${prefix}/*_annotate/*_taxonomy.tsv,${prefix}/*_find_proviruses/*_provirus.tsv,${prefix}/*_marker_classification/*_marker_classification.tsv,${prefix}/*_score_calibration/*_calibrated_aggregated_classification.tsv,${prefix}/*_score_calibration/*_compositions.tsv,${prefix}/*_summary/*_plasmid.fna.gz,${prefix}/*_summary/*_plasmid_genes.tsv,${prefix}/*_summary/*_plasmid_proteins.faa.gz,${prefix}/*_summary/*_plasmid_summary.tsv,${prefix}/*_summary/*_virus.fna.gz,${prefix}/*_summary/*_virus_genes.tsv,${prefix}/*_summary/*_virus_proteins.faa.gz,${prefix}/*_summary/*_virus_summary.tsv}'
        ]
        ext.args = { params.args ?: '' }
    }
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}
