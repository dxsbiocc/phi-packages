#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { QUANTMSUTILS_DIANN2MZTAB } from '../main.nf'

params.report = null
params.report_pg = null
params.report_pr = null
params.exp_design = null
params.ms_information = null
params.fasta = null
params.diann_version = null
params.args = ""
params.outdir = "results"

workflow {
    report_ch = Channel
        .fromPath(params.report, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    report_pg_ch = params.report_pg ? Channel.fromPath(params.report_pg, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    report_pr_ch = params.report_pr ? Channel.fromPath(params.report_pr, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    exp_design_ch = params.exp_design ? Channel.fromPath(params.exp_design, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    ms_information_ch = params.ms_information ? Channel.fromPath(params.ms_information, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_ch = params.fasta ? Channel.fromPath(params.fasta, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    QUANTMSUTILS_DIANN2MZTAB(report_ch.combine(report_pg_ch).combine(report_pr_ch).combine(exp_design_ch).combine(ms_information_ch).combine(fasta_ch).map { t -> t + [params.diann_version] })
}
