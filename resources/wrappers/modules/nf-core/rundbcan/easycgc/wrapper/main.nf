#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { RUNDBCAN_EASYCGC } from '../main.nf'

params.input_raw_data = null
params.input_gff = null
params.gff_type = null
params.dbcan_db = null
params.args = ""
params.outdir = "results"

workflow {
    input_raw_data_ch = Channel
        .fromPath(params.input_raw_data, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    input_gff_ch = Channel
        .fromPath(params.input_gff, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    dbcan_db_ch = params.dbcan_db ? Channel.fromPath(params.dbcan_db, checkIfExists: true).first() : Channel.value([])

    RUNDBCAN_EASYCGC(input_raw_data_ch, input_gff_ch.map { t -> t + [params.gff_type] }.first(), dbcan_db_ch)
}
