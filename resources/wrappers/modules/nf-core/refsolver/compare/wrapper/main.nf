#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { REFSOLVER_COMPARE } from '../main.nf'

params.input_a = null
params.input_b = null
params.args = ""
params.outdir = "results"

workflow {
    input_a_ch = Channel
        .fromPath(params.input_a, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    input_b_ch = params.input_b ? Channel.fromPath(params.input_b, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    REFSOLVER_COMPARE(input_a_ch.combine(input_b_ch))
}
