#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { DISAMBIGUATE } from '../main.nf'

params.bam_a = null
params.bam_b = null
params.args = ""
params.outdir = "results"

workflow {
    bam_a_ch = Channel
        .fromPath(params.bam_a, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bam_b_ch = params.bam_b ? Channel.fromPath(params.bam_b, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    DISAMBIGUATE(bam_a_ch.combine(bam_b_ch))
}
