#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { EASYPQP_CONVERT } from '../main.nf'

params.id_file = null
params.spectra = null
params.unimod = null
params.args = ""
params.outdir = "results"

workflow {
    id_file_ch = Channel
        .fromPath(params.id_file, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    spectra_ch = params.spectra ? Channel.fromPath(params.spectra, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    unimod_ch = Channel.fromPath(params.unimod, checkIfExists: true)

    EASYPQP_CONVERT(id_file_ch.combine(spectra_ch), unimod_ch)
}
