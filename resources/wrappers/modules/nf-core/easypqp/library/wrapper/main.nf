#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { EASYPQP_LIBRARY } from '../main.nf'

params.psmpkl = null
params.peakpkl = null
params.args = ""
params.outdir = "results"

workflow {
    psmpkl_ch = Channel
        .fromPath(params.psmpkl, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    peakpkl_ch = params.peakpkl ? Channel.fromPath(params.peakpkl, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    EASYPQP_LIBRARY(psmpkl_ch.combine(peakpkl_ch))
}
