#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { OPT_STAT } from '../main.nf'

params.probe_targets = null
params.fwd_oriented_probes = null
params.gene_synonyms = null
params.args = ""
params.outdir = "results"

workflow {
    probe_targets_ch = Channel
        .fromPath(params.probe_targets, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fwd_oriented_probes_ch = Channel
        .fromPath(params.fwd_oriented_probes, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    gene_synonyms_ch = Channel.fromPath(params.gene_synonyms, checkIfExists: true)

    OPT_STAT(probe_targets_ch, fwd_oriented_probes_ch.first(), gene_synonyms_ch)
}
