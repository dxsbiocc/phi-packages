#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { OPT_FLIP } from '../main.nf'

params.probes_fasta = null
params.ref_annot_gff = null
params.ref_annot_fa = null
params.args = ""
params.outdir = "results"

workflow {
    probes_fasta_ch = Channel
        .fromPath(params.probes_fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    ref_annot_gff_ch = Channel
        .fromPath(params.ref_annot_gff, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    ref_annot_fa_ch = params.ref_annot_fa ? Channel.fromPath(params.ref_annot_fa, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    OPT_FLIP(probes_fasta_ch, ref_annot_gff_ch.combine(ref_annot_fa_ch).first())
}
