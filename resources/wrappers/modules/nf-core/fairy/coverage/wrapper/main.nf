#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { FAIRY_COVERAGE } from '../main.nf'

params.sketches = null
params.contigs = null
params.args = ""
params.outdir = "results"

workflow {
    sketches_ch = Channel
        .fromPath(params.sketches, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    contigs_ch = params.contigs ? Channel.fromPath(params.contigs, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    FAIRY_COVERAGE(sketches_ch.combine(contigs_ch))
}
