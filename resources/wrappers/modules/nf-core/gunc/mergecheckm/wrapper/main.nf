#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { GUNC_MERGECHECKM } from '../main.nf'

params.gunc_file = null
params.checkm_file = null
params.args = ""
params.outdir = "results"

workflow {
    gunc_file_ch = Channel
        .fromPath(params.gunc_file, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    checkm_file_ch = params.checkm_file ? Channel.fromPath(params.checkm_file, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    GUNC_MERGECHECKM(gunc_file_ch.combine(checkm_file_ch))
}
