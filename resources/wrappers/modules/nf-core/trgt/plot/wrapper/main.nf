#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { TRGT_PLOT } from '../main.nf'

params.bam = null
params.bai = null
params.vcf = null
params.tbi = null
params.repeat_id = null
params.fasta = null
params.fai = null
params.repeats = null
params.args = ""
params.outdir = "results"

workflow {
    bam_ch = Channel
        .fromPath(params.bam, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bai_ch = params.bai ? Channel.fromPath(params.bai, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    vcf_ch = params.vcf ? Channel.fromPath(params.vcf, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    tbi_ch = params.tbi ? Channel.fromPath(params.tbi, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fai_ch = Channel
        .fromPath(params.fai, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    repeats_ch = Channel
        .fromPath(params.repeats, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    TRGT_PLOT(bam_ch.combine(bai_ch).combine(vcf_ch).combine(tbi_ch).map { t -> t + [params.repeat_id] }, fasta_ch.first(), fai_ch.first(), repeats_ch.first())
}
