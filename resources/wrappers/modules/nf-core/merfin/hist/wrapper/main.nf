#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { MERFIN_HIST } from '../main.nf'

params.fasta_assembly = null
params.s = null
params.meryl_db_reads = null
params.lookup_table = null
params.seqmers = null
params.peak = null
params.args = ""
params.outdir = "results"

workflow {
    fasta_assembly_ch = Channel
        .fromPath(params.fasta_assembly, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    s_ch = params.s ? Channel.fromPath(params.s, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    meryl_db_reads_ch = Channel
        .fromPath(params.meryl_db_reads, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    lookup_table_ch = Channel.fromPath(params.lookup_table, checkIfExists: true)
    seqmers_ch = Channel.fromPath(params.seqmers, checkIfExists: true)

    MERFIN_HIST(fasta_assembly_ch.combine(s_ch), meryl_db_reads_ch.first(), lookup_table_ch, seqmers_ch, params.peak)
}
