#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { MERQURY_MERQURY } from '../main.nf'

params.meryl_db = null
params.assembly = null
params.args = ""
params.outdir = "results"

workflow {
    meryl_db_ch = Channel
        .fromPath(params.meryl_db, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    assembly_ch = params.assembly ? Channel.fromPath(params.assembly, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    MERQURY_MERQURY(meryl_db_ch.combine(assembly_ch))
}
