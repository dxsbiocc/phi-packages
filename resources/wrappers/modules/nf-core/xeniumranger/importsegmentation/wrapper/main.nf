#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { XENIUMRANGER_IMPORTSEGMENTATION } from '../main.nf'

params.xenium_bundle = null
params.transcript_assignment = null
params.viz_polygons = null
params.nuclei = null
params.cells = null
params.coordinate_transform = null
params.units = null
params.expansion_distance = null
params.args = ""
params.outdir = "results"

workflow {
    xenium_bundle_ch = Channel
        .fromPath("${params.xenium_bundle}/*", checkIfExists: true)
        .collect()
        .map { files -> [[id: 'input'], files] }
    transcript_assignment_ch = params.transcript_assignment ? Channel.fromPath(params.transcript_assignment, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    viz_polygons_ch = params.viz_polygons ? Channel.fromPath(params.viz_polygons, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    nuclei_ch = params.nuclei ? Channel.fromPath(params.nuclei, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    cells_ch = params.cells ? Channel.fromPath(params.cells, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    coordinate_transform_ch = params.coordinate_transform ? Channel.fromPath(params.coordinate_transform, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    XENIUMRANGER_IMPORTSEGMENTATION(xenium_bundle_ch.combine(transcript_assignment_ch).combine(viz_polygons_ch).combine(nuclei_ch).combine(cells_ch).combine(coordinate_transform_ch).map { t -> t + [params.units] }.map { t -> t + [params.expansion_distance] })
}
