#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { MIRDEEP2_MIRDEEP2 } from '../main.nf'

params.processed_reads = null
params.genome_mappings = null
params.fasta = null
params.mature = null
params.hairpin = null
params.mature_other_species = null
params.args = ""
params.outdir = "results"

workflow {
    processed_reads_ch = Channel
        .fromPath(params.processed_reads, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    genome_mappings_ch = params.genome_mappings ? Channel.fromPath(params.genome_mappings, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    mature_ch = Channel
        .fromPath(params.mature, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    hairpin_ch = params.hairpin ? Channel.fromPath(params.hairpin, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    mature_other_species_ch = params.mature_other_species ? Channel.fromPath(params.mature_other_species, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    MIRDEEP2_MIRDEEP2(processed_reads_ch.combine(genome_mappings_ch), fasta_ch.first(), mature_ch.combine(hairpin_ch).combine(mature_other_species_ch).first())
}
