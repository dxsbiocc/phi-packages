#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { DUPHOLD } from '../main.nf'

params.alignment_file = null
params.alignment_index = null
params.sv_variants = null
params.snp_variants = null
params.snp_variants_index = null
params.fasta = null
params.fasta_fai = null
params.args = ""
params.outdir = "results"

workflow {
    alignment_file_ch = Channel
        .fromPath(params.alignment_file, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    alignment_index_ch = params.alignment_index ? Channel.fromPath(params.alignment_index, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    sv_variants_ch = params.sv_variants ? Channel.fromPath(params.sv_variants, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    snp_variants_ch = params.snp_variants ? Channel.fromPath(params.snp_variants, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    snp_variants_index_ch = params.snp_variants_index ? Channel.fromPath(params.snp_variants_index, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_ch = params.fasta ? Channel.fromPath(params.fasta, checkIfExists: true).first() : Channel.value([])
    fasta_fai_ch = params.fasta_fai ? Channel.fromPath(params.fasta_fai, checkIfExists: true).first() : Channel.value([])

    DUPHOLD(alignment_file_ch.combine(alignment_index_ch).combine(sv_variants_ch).combine(snp_variants_ch).combine(snp_variants_index_ch), fasta_ch, fasta_fai_ch)
}
