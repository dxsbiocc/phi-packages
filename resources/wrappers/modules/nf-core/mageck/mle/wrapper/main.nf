#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { MAGECK_MLE } from '../main.nf'

params.count_table = null
params.design_matrix = null
params.args = ""
params.outdir = "results"

workflow {
    count_table_ch = Channel
        .fromPath(params.count_table, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    design_matrix_ch = Channel.fromPath(params.design_matrix, checkIfExists: true)

    MAGECK_MLE(count_table_ch, design_matrix_ch)
}
