#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { GLIMPSE2_PHASE } from '../main.nf'

params.input = null
params.input_index = null
params.bamlist = null
params.samples_file = null
params.reference = null
params.reference_index = null
params.map = null
params.input_region = null
params.output_region = null
params.fasta_reference = null
params.fasta_reference_index = null
params.output_suffix = null
params.args = ""
params.outdir = "results"

workflow {
    input_ch = Channel
        .fromPath(params.input, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    input_index_ch = params.input_index ? Channel.fromPath(params.input_index, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    bamlist_ch = params.bamlist ? Channel.fromPath(params.bamlist, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    samples_file_ch = params.samples_file ? Channel.fromPath(params.samples_file, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    reference_ch = params.reference ? Channel.fromPath(params.reference, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    reference_index_ch = params.reference_index ? Channel.fromPath(params.reference_index, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    map_ch = params.map ? Channel.fromPath(params.map, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_reference_ch = Channel
        .fromPath(params.fasta_reference, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fasta_reference_index_ch = params.fasta_reference_index ? Channel.fromPath(params.fasta_reference_index, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    GLIMPSE2_PHASE(input_ch.combine(input_index_ch).combine(bamlist_ch).combine(samples_file_ch).combine(reference_ch).combine(reference_index_ch).combine(map_ch).map { t -> t + [params.input_region] }.map { t -> t + [params.output_region] }, fasta_reference_ch.combine(fasta_reference_index_ch).first(), params.output_suffix)
}
