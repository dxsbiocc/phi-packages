#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { GLIMPSE2_CONCORDANCE } from '../main.nf'

params.estimate = null
params.estimate_index = null
params.truth = null
params.truth_index = null
params.freq = null
params.freq_index = null
params.samples = null
params.region = null
params.groups = null
params.bins = null
params.ac_bins = null
params.allele_counts = null
params.min_val_gl = null
params.min_val_dp = null
params.args = ""
params.outdir = "results"

workflow {
    estimate_ch = Channel
        .fromPath(params.estimate, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    estimate_index_ch = params.estimate_index ? Channel.fromPath(params.estimate_index, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    truth_ch = params.truth ? Channel.fromPath(params.truth, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    truth_index_ch = params.truth_index ? Channel.fromPath(params.truth_index, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    freq_ch = params.freq ? Channel.fromPath(params.freq, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    freq_index_ch = params.freq_index ? Channel.fromPath(params.freq_index, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    samples_ch = params.samples ? Channel.fromPath(params.samples, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    groups_ch = Channel
        .fromPath(params.groups, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    GLIMPSE2_CONCORDANCE(estimate_ch.combine(estimate_index_ch).combine(truth_ch).combine(truth_index_ch).combine(freq_ch).combine(freq_index_ch).combine(samples_ch).map { t -> t + [params.region] }, groups_ch.map { t -> t + [params.bins] }.map { t -> t + [params.ac_bins] }.map { t -> t + [params.allele_counts] }.map { t -> t + [params.min_val_gl] }.map { t -> t + [params.min_val_dp] }.first())
}
