#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { GLIMPSE2_SPLITREFERENCE } from '../main.nf'

params.reference = null
params.reference_index = null
params.map = null
params.input_region = null
params.output_region = null
params.args = ""
params.outdir = "results"

workflow {
    reference_ch = Channel
        .fromPath(params.reference, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    reference_index_ch = params.reference_index ? Channel.fromPath(params.reference_index, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    map_ch = params.map ? Channel.fromPath(params.map, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    GLIMPSE2_SPLITREFERENCE(reference_ch.combine(reference_index_ch).combine(map_ch).map { t -> t + [params.input_region] }.map { t -> t + [params.output_region] })
}
