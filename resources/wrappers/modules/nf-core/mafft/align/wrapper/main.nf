#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { MAFFT_ALIGN } from '../main.nf'

params.fasta = null
params.add = null
params.addfragments = null
params.addfull = null
params.addprofile = null
params.addlong = null
params.compress = false
params.args = ""
params.outdir = "results"

workflow {
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    add_ch = Channel
        .fromPath(params.add, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    addfragments_ch = Channel
        .fromPath(params.addfragments, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    addfull_ch = Channel
        .fromPath(params.addfull, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    addprofile_ch = Channel
        .fromPath(params.addprofile, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    addlong_ch = Channel
        .fromPath(params.addlong, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    MAFFT_ALIGN(fasta_ch, add_ch.first(), addfragments_ch.first(), addfull_ch.first(), addprofile_ch.first(), addlong_ch.first(), params.compress)
}
