#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { MULTIVCFANALYZER } from '../main.nf'

params.vcfs = null
params.fasta = null
params.snpeff_results = null
params.gff = null
params.allele_freqs = false
params.genotype_quality = null
params.coverage = null
params.homozygous_freq = null
params.heterozygous_freq = null
params.gff_exclude = null
params.args = ""
params.outdir = "results"

workflow {
    vcfs_ch = Channel
        .fromPath(params.vcfs, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    snpeff_results_ch = Channel
        .fromPath(params.snpeff_results, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    gff_ch = Channel
        .fromPath(params.gff, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    gff_exclude_ch = Channel
        .fromPath(params.gff_exclude, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    MULTIVCFANALYZER(vcfs_ch, fasta_ch.first(), snpeff_results_ch.first(), gff_ch.first(), params.allele_freqs, params.genotype_quality, params.coverage, params.homozygous_freq, params.heterozygous_freq, gff_exclude_ch.first())
}
