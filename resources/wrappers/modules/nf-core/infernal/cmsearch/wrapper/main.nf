#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { INFERNAL_CMSEARCH } from '../main.nf'

params.cmfile = null
params.seqdb = null
params.write_align = false
params.write_target = false
params.args = ""
params.outdir = "results"

workflow {
    cmfile_ch = Channel
        .fromPath(params.cmfile, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    seqdb_ch = params.seqdb ? Channel.fromPath(params.seqdb, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    INFERNAL_CMSEARCH(cmfile_ch.combine(seqdb_ch), params.write_align, params.write_target)
}
