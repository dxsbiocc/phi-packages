// Launcher config for the abritamr run wrapper adapter. Not part of the fixed
// wrapper/{main.nf,params.json,wrapper.yaml} contract — Nextflow picks this
// up automatically because it sits beside wrapper/main.nf.

process {
    cpus   = 2
    memory = '4.GB'
    time   = '2.h'

    withName: 'ABRITAMR_RUN' {
        publishDir = [
            path: { "${params.outdir}/abritamr_run" },
            mode: 'copy',
            pattern: '{*.abritamr.txt,*.amrfinder.out,*.summary_matches.txt,*.summary_partials.txt,*.summary_virulence.txt}'
        ]
        ext.args = { params.args ?: '' }
    }
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}
