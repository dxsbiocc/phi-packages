#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { LTRRETRIEVER_LTRRETRIEVER } from '../main.nf'

params.genome = null
params.harvest = null
params.finder = null
params.mgescan = null
params.non_tgca = null
params.args = ""
params.outdir = "results"

workflow {
    genome_ch = Channel
        .fromPath(params.genome, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    harvest_ch = Channel.fromPath(params.harvest, checkIfExists: true)
    finder_ch = Channel.fromPath(params.finder, checkIfExists: true)
    mgescan_ch = Channel.fromPath(params.mgescan, checkIfExists: true)
    non_tgca_ch = Channel.fromPath(params.non_tgca, checkIfExists: true)

    LTRRETRIEVER_LTRRETRIEVER(genome_ch, harvest_ch, finder_ch, mgescan_ch, non_tgca_ch)
}
