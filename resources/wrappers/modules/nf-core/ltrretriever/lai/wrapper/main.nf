#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { LTRRETRIEVER_LAI } from '../main.nf'

params.fasta = null
params.pass_list = null
params.annotation_out = null
params.monoploid_seqs = null
params.args = ""
params.outdir = "results"

workflow {
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    pass_list_ch = Channel.fromPath(params.pass_list, checkIfExists: true)
    annotation_out_ch = Channel.fromPath(params.annotation_out, checkIfExists: true)
    monoploid_seqs_ch = Channel.fromPath(params.monoploid_seqs, checkIfExists: true)

    LTRRETRIEVER_LAI(fasta_ch, pass_list_ch, annotation_out_ch, monoploid_seqs_ch)
}
