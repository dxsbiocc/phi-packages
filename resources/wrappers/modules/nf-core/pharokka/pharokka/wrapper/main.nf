#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { PHAROKKA_PHAROKKA } from '../main.nf'

params.phage_fasta = null
params.pharokka_db = null
params.args = ""
params.outdir = "results"

workflow {
    phage_fasta_ch = Channel
        .fromPath(params.phage_fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    pharokka_db_ch = params.pharokka_db ? Channel.fromPath(params.pharokka_db, checkIfExists: true).first() : Channel.value([])

    PHAROKKA_PHAROKKA(phage_fasta_ch, pharokka_db_ch)
}
