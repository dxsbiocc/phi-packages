#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { MSISENSOR2_MSI } from '../main.nf'

params.tumor_bam = null
params.tumor_bam_index = null
params.models = null
params.args = ""
params.outdir = "results"

workflow {
    tumor_bam_ch = Channel
        .fromPath(params.tumor_bam, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    tumor_bam_index_ch = params.tumor_bam_index ? Channel.fromPath(params.tumor_bam_index, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    models_ch = Channel
        .fromPath(params.models, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    MSISENSOR2_MSI(tumor_bam_ch.combine(tumor_bam_index_ch), models_ch.first())
}
