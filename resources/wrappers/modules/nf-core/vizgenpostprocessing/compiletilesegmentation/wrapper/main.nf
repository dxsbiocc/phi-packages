#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { VIZGENPOSTPROCESSING_COMPILETILESEGMENTATION } from '../main.nf'

params.input_images = null
params.segmentation_params = null
params.algorithm_json = null
params.segmentation_tiles = null
params.args = ""
params.outdir = "results"

workflow {
    input_images_ch = Channel
        .fromPath(params.input_images, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    segmentation_params_ch = params.segmentation_params ? Channel.fromPath(params.segmentation_params, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    algorithm_json_ch = Channel.fromPath(params.algorithm_json, checkIfExists: true)
    segmentation_tiles_ch = Channel.fromPath(params.segmentation_tiles, checkIfExists: true)

    VIZGENPOSTPROCESSING_COMPILETILESEGMENTATION(input_images_ch.combine(segmentation_params_ch), algorithm_json_ch, segmentation_tiles_ch)
}
