#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { OATK } from '../main.nf'

params.reads = null
params.mito_hmm_files = null
params.pltd_hmm_files = null
params.args = ""
params.outdir = "results"

workflow {
    reads_ch = Channel
        .fromPath(params.reads, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    mito_hmm_files_ch = Channel
        .fromPath(params.mito_hmm_files, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    pltd_hmm_files_ch = Channel
        .fromPath(params.pltd_hmm_files, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    OATK(reads_ch, mito_hmm_files_ch.first(), pltd_hmm_files_ch.first())
}
