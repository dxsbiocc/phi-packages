#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SOMALIER_ANCESTRY } from '../main.nf'

params.query_somalier_files = null
params.s = null
params.labels_tsv = null
params.labelled_somalier_files = null
params.s_2 = null
params.args = ""
params.outdir = "results"

workflow {
    query_somalier_files_ch = Channel
        .fromPath(params.query_somalier_files, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    s_ch = params.s ? Channel.fromPath(params.s, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    labels_tsv_ch = Channel
        .fromPath(params.labels_tsv, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    labelled_somalier_files_ch = params.labelled_somalier_files ? Channel.fromPath(params.labelled_somalier_files, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    s_2_ch = params.s_2 ? Channel.fromPath(params.s_2, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    SOMALIER_ANCESTRY(query_somalier_files_ch.combine(s_ch), labels_tsv_ch.combine(labelled_somalier_files_ch).combine(s_2_ch).first())
}
