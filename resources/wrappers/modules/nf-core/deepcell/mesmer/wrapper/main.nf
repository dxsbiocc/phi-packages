#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { DEEPCELL_MESMER } from '../main.nf'

params.img = null
params.membrane_img = null
params.args = ""
params.outdir = "results"

workflow {
    img_ch = Channel
        .fromPath(params.img, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    membrane_img_ch = Channel
        .fromPath(params.membrane_img, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    DEEPCELL_MESMER(img_ch, membrane_img_ch.first())
}
