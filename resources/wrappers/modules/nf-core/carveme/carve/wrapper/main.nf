#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { CARVEME_CARVE } from '../main.nf'

params.fasta = null
params.universe_file = null
params.mediadb = null
params.soft = null
params.hard = null
params.reference = null
params.args = ""
params.outdir = "results"

workflow {
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    universe_file_ch = params.universe_file ? Channel.fromPath(params.universe_file, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    mediadb_ch = params.mediadb ? Channel.fromPath(params.mediadb, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    soft_ch = params.soft ? Channel.fromPath(params.soft, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    hard_ch = params.hard ? Channel.fromPath(params.hard, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    reference_ch = params.reference ? Channel.fromPath(params.reference, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    CARVEME_CARVE(fasta_ch.combine(universe_file_ch).combine(mediadb_ch).combine(soft_ch).combine(hard_ch).combine(reference_ch))
}
