#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { METATOR_PIPELINE } from '../main.nf'

params.contigs = null
params.hic_input = null
params.depths = null
params.args = ""
params.outdir = "results"

workflow {
    contigs_ch = Channel
        .fromPath(params.contigs, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    hic_input_ch = params.hic_input ? Channel.fromPath(params.hic_input, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    depths_ch = params.depths ? Channel.fromPath(params.depths, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    METATOR_PIPELINE(contigs_ch.combine(hic_input_ch).combine(depths_ch))
}
