#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { DATAVZRD } from '../main.nf'

params.config_file = null
params.table = null
params.args = ""
params.outdir = "results"

workflow {
    config_file_ch = Channel
        .fromPath(params.config_file, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    table_ch = params.table ? Channel.fromPath(params.table, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    DATAVZRD(config_file_ch.combine(table_ch))
}
