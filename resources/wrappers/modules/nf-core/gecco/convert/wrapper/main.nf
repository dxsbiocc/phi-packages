#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { GECCO_CONVERT } from '../main.nf'

params.clusters = null
params.gbk = null
params.mode = null
params.format = null
params.args = ""
params.outdir = "results"

workflow {
    clusters_ch = Channel
        .fromPath(params.clusters, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    gbk_ch = params.gbk ? Channel.fromPath(params.gbk, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    GECCO_CONVERT(clusters_ch.combine(gbk_ch), params.mode, params.format)
}
