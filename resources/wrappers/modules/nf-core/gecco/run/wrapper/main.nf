#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { GECCO_RUN } from '../main.nf'

params.input = null
params.hmm = null
params.model_dir = null
params.args = ""
params.outdir = "results"

workflow {
    input_ch = Channel
        .fromPath(params.input, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    hmm_ch = params.hmm ? Channel.fromPath(params.hmm, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    model_dir_ch = Channel.fromPath(params.model_dir, checkIfExists: true)

    GECCO_RUN(input_ch.combine(hmm_ch), model_dir_ch)
}
