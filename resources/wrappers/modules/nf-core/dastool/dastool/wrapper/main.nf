#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { DASTOOL_DASTOOL } from '../main.nf'

params.contigs = null
params.bins = null
params.proteins = null
params.db_directory = null
params.args = ""
params.outdir = "results"

workflow {
    contigs_ch = Channel
        .fromPath(params.contigs, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bins_ch = params.bins ? Channel.fromPath(params.bins, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    proteins_ch = params.proteins ? Channel.fromPath(params.proteins, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    db_directory_ch = Channel.fromPath(params.db_directory, checkIfExists: true)

    DASTOOL_DASTOOL(contigs_ch.combine(bins_ch).combine(proteins_ch), db_directory_ch)
}
