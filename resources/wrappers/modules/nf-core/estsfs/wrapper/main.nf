#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { ESTSFS } from '../main.nf'

params.e_config = null
params.data = null
params.seed = null
params.outdir = "results"

workflow {
    e_config_ch = Channel
        .fromPath(params.e_config, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    data_ch = params.data ? Channel.fromPath(params.data, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    seed_ch = params.seed ? Channel.fromPath(params.seed, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    ESTSFS(e_config_ch.combine(data_ch).combine(seed_ch))
}
