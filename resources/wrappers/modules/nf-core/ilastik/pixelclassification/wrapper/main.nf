#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { ILASTIK_PIXELCLASSIFICATION } from '../main.nf'

params.input_img = null
params.output_format = null
params.export_source = null
params.ilp = null
params.args = ""
params.outdir = "results"

workflow {
    input_img_ch = Channel
        .fromPath(params.input_img, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    ilp_ch = Channel.fromPath(params.ilp, checkIfExists: true)

    ILASTIK_PIXELCLASSIFICATION(input_img_ch.map { t -> t + [params.output_format] }.map { t -> t + [params.export_source] }, ilp_ch)
}
