#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { ILASTIK_MULTICUT } from '../main.nf'

params.h5 = null
params.probs = null
params.ilp = null
params.args = ""
params.outdir = "results"

workflow {
    h5_ch = Channel
        .fromPath(params.h5, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    probs_ch = params.probs ? Channel.fromPath(params.probs, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    ilp_ch = Channel.fromPath(params.ilp, checkIfExists: true)

    ILASTIK_MULTICUT(h5_ch.combine(probs_ch), ilp_ch)
}
