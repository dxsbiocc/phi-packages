#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { CHROMAP_CHROMAP } from '../main.nf'

params.reads = null
params.fasta = null
params.index = null
params.barcodes = null
params.whitelist = null
params.chr_order = null
params.pairs_chr_order = null
params.args = ""
params.outdir = "results"

workflow {
    reads_ch = Channel
        .fromFilePairs(params.reads, size: -1)
        .map { sample, reads -> [[id: sample, single_end: reads instanceof List ? reads.size() == 1 : true], reads] }
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    index_ch = Channel
        .fromPath(params.index, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    barcodes_ch = Channel.fromPath(params.barcodes, checkIfExists: true)
    whitelist_ch = Channel.fromPath(params.whitelist, checkIfExists: true)
    chr_order_ch = Channel.fromPath(params.chr_order, checkIfExists: true)
    pairs_chr_order_ch = Channel.fromPath(params.pairs_chr_order, checkIfExists: true)

    CHROMAP_CHROMAP(reads_ch, fasta_ch.first(), index_ch.first(), barcodes_ch, whitelist_ch, chr_order_ch, pairs_chr_order_ch)
}
