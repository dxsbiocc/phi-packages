#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { VCF2CYTOSURE } from '../main.nf'

params.sv_vcf = null
params.coverage_bed = null
params.cns = null
params.snv_vcf = null
params.blacklist_bed = null
params.args = ""
params.outdir = "results"

workflow {
    sv_vcf_ch = Channel
        .fromPath(params.sv_vcf, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    coverage_bed_ch = Channel
        .fromPath(params.coverage_bed, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    cns_ch = Channel
        .fromPath(params.cns, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    snv_vcf_ch = Channel
        .fromPath(params.snv_vcf, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    blacklist_bed_ch = params.blacklist_bed ? Channel.fromPath(params.blacklist_bed, checkIfExists: true).first() : Channel.value([])

    VCF2CYTOSURE(sv_vcf_ch, coverage_bed_ch.first(), cns_ch.first(), snv_vcf_ch.first(), blacklist_bed_ch)
}
