#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { EGGNOGMAPPER } from '../main.nf'

params.fasta = null
params.db = null
params.search_mode = null
params.eggnog_data_dir = null
params.args = ""
params.outdir = "results"

workflow {
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    db_ch = Channel
        .fromPath(params.db, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    eggnog_data_dir_ch = Channel.fromPath(params.eggnog_data_dir, checkIfExists: true)

    EGGNOGMAPPER(fasta_ch, db_ch.map { t -> t + [params.search_mode] }.first(), eggnog_data_dir_ch)
}
