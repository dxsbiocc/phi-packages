#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { TMB_PYTMB } from '../main.nf'

params.vcf = null
params.bed = null
params.var_config = null
params.db_config = null
params.eff_genome_size = null
params.args = ""
params.outdir = "results"

workflow {
    vcf_ch = Channel
        .fromPath(params.vcf, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bed_ch = params.bed ? Channel.fromPath(params.bed, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    var_config_ch = params.var_config ? Channel.fromPath(params.var_config, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    db_config_ch = params.db_config ? Channel.fromPath(params.db_config, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    TMB_PYTMB(vcf_ch.combine(bed_ch).combine(var_config_ch).combine(db_config_ch).map { t -> t + [params.eff_genome_size] })
}
