#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { GANON_BUILDCUSTOM } from '../main.nf'

params.input = null
params.input_tsv = null
params.taxonomy_files = null
params.genome_size_files = null
params.args = ""
params.outdir = "results"

workflow {
    input_ch = Channel
        .fromPath(params.input, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    input_tsv_ch = Channel.fromPath(params.input_tsv, checkIfExists: true)
    taxonomy_files_ch = Channel.fromPath(params.taxonomy_files, checkIfExists: true)
    genome_size_files_ch = params.genome_size_files ? Channel.fromPath(params.genome_size_files, checkIfExists: true).first() : Channel.value([])

    GANON_BUILDCUSTOM(input_ch, input_tsv_ch, taxonomy_files_ch, genome_size_files_ch)
}
