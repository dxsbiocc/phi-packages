#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { NGSBITS_BEDCOVERAGE } from '../main.nf'

params.reads = null
params.reads_index = null
params.bed = null
params.fasta = null
params.fai = null
params.args = ""
params.outdir = "results"

workflow {
    reads_ch = Channel
        .fromPath(params.reads, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    reads_index_ch = params.reads_index ? Channel.fromPath(params.reads_index, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    bed_ch = params.bed ? Channel.fromPath(params.bed, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fai_ch = Channel
        .fromPath(params.fai, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    NGSBITS_BEDCOVERAGE(reads_ch.combine(reads_index_ch).combine(bed_ch), fasta_ch.first(), fai_ch.first())
}
