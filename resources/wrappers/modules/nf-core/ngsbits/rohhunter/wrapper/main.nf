#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { NGSBITS_ROHHUNTER } from '../main.nf'

params.vcf = null
params.exclude_bed = null
params.annotation_beds = null
params.args = ""
params.outdir = "results"

workflow {
    vcf_ch = Channel
        .fromPath(params.vcf, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    exclude_bed_ch = params.exclude_bed ? Channel.fromPath(params.exclude_bed, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    annotation_beds_ch = Channel
        .fromPath(params.annotation_beds, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    NGSBITS_ROHHUNTER(vcf_ch.combine(exclude_bed_ch), annotation_beds_ch.first())
}
