#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { HASHEDDROPS } from '../main.nf'

params.hto_matrix = null
params.rna_matrix = null
params.run_empty_drops = false
params.outdir = "results"

workflow {
    hto_matrix_ch = Channel
        .fromPath(params.hto_matrix, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    rna_matrix_ch = params.rna_matrix ? Channel.fromPath(params.rna_matrix, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    HASHEDDROPS(hto_matrix_ch.combine(rna_matrix_ch).map { t -> t + [params.run_empty_drops] })
}
