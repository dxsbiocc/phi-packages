#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { GALAH } from '../main.nf'

params.bins = null
params.qc_table = null
params.qc_format = null
params.args = ""
params.outdir = "results"

workflow {
    bins_ch = Channel
        .fromPath(params.bins, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    qc_table_ch = params.qc_table ? Channel.fromPath(params.qc_table, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    GALAH(bins_ch.combine(qc_table_ch).map { t -> t + [params.qc_format] })
}
