#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { MIRTOP_EXPORT } from '../main.nf'

params.mirtop_gff = null
params.hairpin = null
params.gtf = null
params.species = null
params.args = ""
params.outdir = "results"

workflow {
    mirtop_gff_ch = Channel
        .fromPath(params.mirtop_gff, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    hairpin_ch = Channel
        .fromPath(params.hairpin, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    gtf_ch = Channel
        .fromPath(params.gtf, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    MIRTOP_EXPORT(mirtop_gff_ch, hairpin_ch.first(), gtf_ch.map { t -> t + [params.species] }.first())
}
