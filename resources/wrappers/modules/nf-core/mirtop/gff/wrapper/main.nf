#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { MIRTOP_GFF } from '../main.nf'

params.bam = null
params.hairpin = null
params.gtf = null
params.species = null
params.args = ""
params.outdir = "results"

workflow {
    bam_ch = Channel
        .fromPath(params.bam, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    hairpin_ch = Channel
        .fromPath(params.hairpin, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    gtf_ch = Channel
        .fromPath(params.gtf, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    MIRTOP_GFF(bam_ch, hairpin_ch.first(), gtf_ch.map { t -> t + [params.species] }.first())
}
