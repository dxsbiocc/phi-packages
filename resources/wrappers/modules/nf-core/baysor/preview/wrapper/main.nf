#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { BAYSOR_PREVIEW } from '../main.nf'

params.transcripts = null
params.config = null
params.args = ""
params.outdir = "results"

workflow {
    transcripts_ch = Channel
        .fromPath(params.transcripts, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    config_ch = params.config ? Channel.fromPath(params.config, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    BAYSOR_PREVIEW(transcripts_ch.combine(config_ch))
}
