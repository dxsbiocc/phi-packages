#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { BAYSOR_RUN } from '../main.nf'

params.transcripts = null
params.prior_segmentation = null
params.config = null
params.scale = null
params.prior_confidence = null
params.prior_column = null
params.polygon_format = null
params.args = ""
params.outdir = "results"

workflow {
    transcripts_ch = Channel
        .fromPath(params.transcripts, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    prior_segmentation_ch = params.prior_segmentation ? Channel.fromPath(params.prior_segmentation, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    config_ch = params.config ? Channel.fromPath(params.config, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    BAYSOR_RUN(transcripts_ch.combine(prior_segmentation_ch).combine(config_ch).map { t -> t + [params.scale] }, params.prior_confidence, params.prior_column, params.polygon_format)
}
