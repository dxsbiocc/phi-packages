#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { INSTRAIN_COMPARE } from '../main.nf'

params.bams = null
params.profiles = null
params.stb_file = null
params.args = ""
params.outdir = "results"

workflow {
    bams_ch = Channel
        .fromPath(params.bams, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    profiles_ch = params.profiles ? Channel.fromPath(params.profiles, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    stb_file_ch = Channel.fromPath(params.stb_file, checkIfExists: true)

    INSTRAIN_COMPARE(bams_ch.combine(profiles_ch), stb_file_ch)
}
