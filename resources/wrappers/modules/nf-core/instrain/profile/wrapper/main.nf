#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { INSTRAIN_PROFILE } from '../main.nf'

params.bam = null
params.genome_fasta = null
params.genes_fasta = null
params.stb_file = null
params.args = ""
params.outdir = "results"

workflow {
    bam_ch = Channel
        .fromPath(params.bam, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    genome_fasta_ch = params.genome_fasta ? Channel.fromPath(params.genome_fasta, checkIfExists: true).first() : Channel.value([])
    genes_fasta_ch = params.genes_fasta ? Channel.fromPath(params.genes_fasta, checkIfExists: true).first() : Channel.value([])
    stb_file_ch = Channel.fromPath(params.stb_file, checkIfExists: true)

    INSTRAIN_PROFILE(bam_ch, genome_fasta_ch, genes_fasta_ch, stb_file_ch)
}
