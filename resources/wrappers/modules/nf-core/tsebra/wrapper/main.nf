#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { TSEBRA } from '../main.nf'

params.gtfs = null
params.hints_files = null
params.keep_gtfs = null
params.config = null
params.args = ""
params.outdir = "results"

workflow {
    gtfs_ch = Channel
        .fromPath(params.gtfs, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    hints_files_ch = Channel.fromPath(params.hints_files, checkIfExists: true)
    keep_gtfs_ch = params.keep_gtfs ? Channel.fromPath(params.keep_gtfs, checkIfExists: true).first() : Channel.value([])
    config_ch = Channel.fromPath(params.config, checkIfExists: true)

    TSEBRA(gtfs_ch, hints_files_ch, keep_gtfs_ch, config_ch)
}
