#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { PEKA } from '../main.nf'

params.peaks = null
params.crosslinks = null
params.fasta = null
params.fai = null
params.gtf = null
params.args = ""
params.outdir = "results"

workflow {
    peaks_ch = Channel
        .fromPath(params.peaks, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    crosslinks_ch = Channel
        .fromPath(params.crosslinks, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fai_ch = params.fai ? Channel.fromPath(params.fai, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    gtf_ch = params.gtf ? Channel.fromPath(params.gtf, checkIfExists: true).first() : Channel.value([])

    PEKA(peaks_ch, crosslinks_ch.first(), fasta_ch.combine(fai_ch).first(), gtf_ch)
}
