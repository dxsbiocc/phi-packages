// Launcher config for the gsea gsea wrapper adapter. Not part of the fixed
// wrapper/{main.nf,params.json,wrapper.yaml} contract — Nextflow picks this
// up automatically because it sits beside wrapper/main.nf.

process {
    cpus   = 1
    memory = '2.GB'
    time   = '1.h'

    withName: 'GSEA_GSEA' {
        publishDir = [
            path: { "${params.outdir}/gsea_gsea" },
            mode: 'copy',
            pattern: '{*.rpt,*.zip,*_snapshot*.html,*butterfly_plot.png,*enplot*.png,*gene_set_sizes.tsv,*global_es_histogram.png,*gsea_report_for_${reference}.html,*gsea_report_for_${reference}.tsv,*gsea_report_for_${target}.html,*gsea_report_for_${target}.tsv,*gset_rnd_es_dist*.png,*heat_map_1.png,*heat_map_corr_plot.html,*index.html,*pvalues_vs_nes_plot.png,*ranked_gene_list*.tsv,*ranked_list_corr_2.png,gene_sets_*.html,gene_sets_*.png,gene_sets_*.tsv}'
        ]
        ext.args = { params.args ?: '' }
    }
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}
