#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { GSEA_GSEA } from '../main.nf'

params.gct = null
params.cls = null
params.gene_sets = null
params.reference = null
params.target = null
params.chip = null
params.args = ""
params.outdir = "results"

workflow {
    gct_ch = Channel
        .fromPath(params.gct, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    cls_ch = params.cls ? Channel.fromPath(params.cls, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    gene_sets_ch = params.gene_sets ? Channel.fromPath(params.gene_sets, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    chip_ch = Channel
        .fromPath(params.chip, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    GSEA_GSEA(gct_ch.combine(cls_ch).combine(gene_sets_ch), Channel.value([[id: 'input'], params.reference, params.target]), chip_ch.first())
}
