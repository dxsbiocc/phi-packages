#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { BAMCMP } from '../main.nf'

params.primary_aligned_bam = null
params.contaminant_aligned_bam = null
params.args = ""
params.outdir = "results"

workflow {
    primary_aligned_bam_ch = Channel
        .fromPath(params.primary_aligned_bam, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    contaminant_aligned_bam_ch = params.contaminant_aligned_bam ? Channel.fromPath(params.contaminant_aligned_bam, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    BAMCMP(primary_aligned_bam_ch.combine(contaminant_aligned_bam_ch))
}
