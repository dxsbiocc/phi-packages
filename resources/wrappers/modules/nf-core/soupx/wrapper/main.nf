#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SOUPX } from '../main.nf'

params.h5ad_filtered = null
params.h5ad_raw = null
params.npcs = null
params.cluster_algorithm = null
params.outdir = "results"

workflow {
    h5ad_filtered_ch = Channel
        .fromPath(params.h5ad_filtered, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    h5ad_raw_ch = params.h5ad_raw ? Channel.fromPath(params.h5ad_raw, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    SOUPX(h5ad_filtered_ch.combine(h5ad_raw_ch), params.npcs, params.cluster_algorithm)
}
