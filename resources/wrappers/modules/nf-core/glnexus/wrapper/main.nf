#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { GLNEXUS } from '../main.nf'

params.gvcfs = null
params.custom_config = null
params.bed = null
params.args = ""
params.outdir = "results"

workflow {
    gvcfs_ch = Channel
        .fromPath(params.gvcfs, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    custom_config_ch = params.custom_config ? Channel.fromPath(params.custom_config, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    bed_ch = Channel
        .fromPath(params.bed, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    GLNEXUS(gvcfs_ch.combine(custom_config_ch), bed_ch.first())
}
