#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { VERIFYBAMID_VERIFYBAMID2 } from '../main.nf'

params.bam = null
params.bai = null
params.svd_ud = null
params.svd_mu = null
params.svd_bed = null
params.refvcf = null
params.references = null
params.args = ""
params.outdir = "results"

workflow {
    bam_ch = Channel
        .fromPath(params.bam, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bai_ch = params.bai ? Channel.fromPath(params.bai, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    svd_ud_ch = Channel
        .fromPath(params.svd_ud, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    svd_mu_ch = params.svd_mu ? Channel.fromPath(params.svd_mu, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    svd_bed_ch = params.svd_bed ? Channel.fromPath(params.svd_bed, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    refvcf_ch = Channel.fromPath(params.refvcf, checkIfExists: true)
    references_ch = params.references ? Channel.fromPath(params.references, checkIfExists: true).first() : Channel.value([])

    VERIFYBAMID_VERIFYBAMID2(bam_ch.combine(bai_ch), svd_ud_ch.combine(svd_mu_ch).combine(svd_bed_ch).first(), refvcf_ch, references_ch)
}
