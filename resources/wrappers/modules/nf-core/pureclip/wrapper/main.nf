#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { PURECLIP } from '../main.nf'

params.ipbam = null
params.controlbam = null
params.ipbai = null
params.controlbai = null
params.genome_fasta = null
params.input_control = false
params.args = ""
params.outdir = "results"

workflow {
    ipbam_ch = Channel
        .fromPath(params.ipbam, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    controlbam_ch = params.controlbam ? Channel.fromPath(params.controlbam, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    ipbai_ch = Channel
        .fromPath(params.ipbai, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    controlbai_ch = params.controlbai ? Channel.fromPath(params.controlbai, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    genome_fasta_ch = Channel
        .fromPath(params.genome_fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    PURECLIP(ipbam_ch.combine(controlbam_ch), ipbai_ch.combine(controlbai_ch).first(), genome_fasta_ch.first(), params.input_control)
}
