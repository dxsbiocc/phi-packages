#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SVANALYZER_SVBENCHMARK } from '../main.nf'

params.test = null
params.test_tbi = null
params.truth = null
params.truth_tbi = null
params.bed = null
params.fasta = null
params.fai = null
params.args = ""
params.outdir = "results"

workflow {
    test_ch = Channel
        .fromPath(params.test, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    test_tbi_ch = params.test_tbi ? Channel.fromPath(params.test_tbi, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    truth_ch = params.truth ? Channel.fromPath(params.truth, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    truth_tbi_ch = params.truth_tbi ? Channel.fromPath(params.truth_tbi, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    bed_ch = params.bed ? Channel.fromPath(params.bed, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fai_ch = Channel
        .fromPath(params.fai, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    SVANALYZER_SVBENCHMARK(test_ch.combine(test_tbi_ch).combine(truth_ch).combine(truth_tbi_ch).combine(bed_ch), fasta_ch.first(), fai_ch.first())
}
