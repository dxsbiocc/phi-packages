#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { STAINWARPY_TRANSFORMSEGMASK } from '../main.nf'

params.hne_img = null
params.multiplx_img = null
params.seg_mask = null
params.tform_map = null
params.fixed_img = null
params.final_sz = null
params.args = ""
params.outdir = "results"

workflow {
    hne_img_ch = Channel
        .fromPath(params.hne_img, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    multiplx_img_ch = Channel
        .fromPath(params.multiplx_img, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    seg_mask_ch = Channel
        .fromPath(params.seg_mask, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    tform_map_ch = Channel
        .fromPath(params.tform_map, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    STAINWARPY_TRANSFORMSEGMASK(hne_img_ch, multiplx_img_ch.first(), seg_mask_ch.first(), tform_map_ch.first(), params.fixed_img, params.final_sz)
}
