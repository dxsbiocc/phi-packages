#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { HMMER_HMMSEARCH } from '../main.nf'

params.hmmfile = null
params.seqdb = null
params.write_align = false
params.write_target = false
params.write_domain = false
params.args = ""
params.outdir = "results"

workflow {
    hmmfile_ch = Channel
        .fromPath(params.hmmfile, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    seqdb_ch = params.seqdb ? Channel.fromPath(params.seqdb, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    HMMER_HMMSEARCH(hmmfile_ch.combine(seqdb_ch).map { t -> t + [params.write_align] }.map { t -> t + [params.write_target] }.map { t -> t + [params.write_domain] })
}
