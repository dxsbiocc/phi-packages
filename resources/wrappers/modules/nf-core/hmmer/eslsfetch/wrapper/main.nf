#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { HMMER_ESLSFETCH } from '../main.nf'

params.seqfile = null
params.ssi = null
params.keyfile = null
params.args = ""
params.outdir = "results"

workflow {
    seqfile_ch = Channel
        .fromPath(params.seqfile, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    ssi_ch = params.ssi ? Channel.fromPath(params.ssi, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    keyfile_ch = params.keyfile ? Channel.fromPath(params.keyfile, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    HMMER_ESLSFETCH(seqfile_ch.combine(ssi_ch).combine(keyfile_ch))
}
