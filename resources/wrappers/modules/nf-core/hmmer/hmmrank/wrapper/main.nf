#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { HMMER_HMMRANK } from '../main.nf'

params.tblouts = null
params.domtblouts = null
params.outdir = "results"

workflow {
    tblouts_ch = Channel
        .fromPath(params.tblouts, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    domtblouts_ch = params.domtblouts ? Channel.fromPath(params.domtblouts, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    HMMER_HMMRANK(tblouts_ch.combine(domtblouts_ch))
}
