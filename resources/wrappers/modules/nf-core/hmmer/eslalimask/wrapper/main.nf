#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { HMMER_ESLALIMASK } from '../main.nf'

params.unmaskedaln = null
params.fmask_rf = false
params.fmask_all = false
params.gmask_rf = false
params.gmask_all = false
params.pmask_rf = false
params.pmask_all = false
params.maskfile = null
params.args = ""
params.outdir = "results"

workflow {
    unmaskedaln_ch = Channel
        .fromPath(params.unmaskedaln, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    maskfile_ch = Channel.fromPath(params.maskfile, checkIfExists: true)

    HMMER_ESLALIMASK(unmaskedaln_ch.map { t -> t + [params.fmask_rf] }.map { t -> t + [params.fmask_all] }.map { t -> t + [params.gmask_rf] }.map { t -> t + [params.gmask_all] }.map { t -> t + [params.pmask_rf] }.map { t -> t + [params.pmask_all] }, maskfile_ch)
}
