#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { ENSEMBLVEP_VEP } from '../main.nf'

params.vcf = null
params.custom_extra_files = null
params.genome = null
params.species = null
params.cache_version = null
params.cache = null
params.fasta = null
params.extra_files = null
params.gtf = null
params.gtf_tbi = null
params.gtf_2 = null
params.gtf_tbi_2 = null
params.args = ""
params.outdir = "results"

workflow {
    vcf_ch = Channel
        .fromPath(params.vcf, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    custom_extra_files_ch = params.custom_extra_files ? Channel.fromPath(params.custom_extra_files, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    cache_ch = Channel
        .fromPath(params.cache, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    extra_files_ch = Channel.fromPath(params.extra_files, checkIfExists: true)
    gtf_ch = Channel
        .fromPath(params.gtf, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    gtf_tbi_ch = params.gtf_tbi ? Channel.fromPath(params.gtf_tbi, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    gtf_2_ch = params.gtf_2 ? Channel.fromPath(params.gtf_2, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    gtf_tbi_2_ch = params.gtf_tbi_2 ? Channel.fromPath(params.gtf_tbi_2, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    ENSEMBLVEP_VEP(vcf_ch.combine(custom_extra_files_ch), params.genome, params.species, params.cache_version, cache_ch.first(), fasta_ch.first(), extra_files_ch, gtf_ch.combine(gtf_tbi_ch).combine(gtf_2_ch).combine(gtf_tbi_2_ch).first())
}
