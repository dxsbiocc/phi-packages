#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { ANNOTSV_ANNOTSV } from '../main.nf'

params.sv_vcf = null
params.sv_vcf_index = null
params.candidate_small_variants = null
params.annotations = null
params.candidate_genes = null
params.false_positive_snv = null
params.gene_transcripts = null
params.args = ""
params.outdir = "results"

workflow {
    sv_vcf_ch = Channel
        .fromPath(params.sv_vcf, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    sv_vcf_index_ch = params.sv_vcf_index ? Channel.fromPath(params.sv_vcf_index, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    candidate_small_variants_ch = params.candidate_small_variants ? Channel.fromPath(params.candidate_small_variants, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    annotations_ch = Channel
        .fromPath(params.annotations, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    candidate_genes_ch = Channel
        .fromPath(params.candidate_genes, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    false_positive_snv_ch = Channel
        .fromPath(params.false_positive_snv, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    gene_transcripts_ch = Channel
        .fromPath(params.gene_transcripts, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    ANNOTSV_ANNOTSV(sv_vcf_ch.combine(sv_vcf_index_ch).combine(candidate_small_variants_ch), annotations_ch.first(), candidate_genes_ch.first(), false_positive_snv_ch.first(), gene_transcripts_ch.first())
}
