#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { HIFIASM } from '../main.nf'

params.long_reads = null
params.ul_reads = null
params.paternal_kmer_dump = null
params.maternal_kmer_dump = null
params.hic_read1 = null
params.hic_read2 = null
params.bin_files = null
params.args = ""
params.outdir = "results"

workflow {
    long_reads_ch = Channel
        .fromPath(params.long_reads, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    ul_reads_ch = params.ul_reads ? Channel.fromPath(params.ul_reads, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    paternal_kmer_dump_ch = Channel
        .fromPath(params.paternal_kmer_dump, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    maternal_kmer_dump_ch = params.maternal_kmer_dump ? Channel.fromPath(params.maternal_kmer_dump, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    hic_read1_ch = Channel
        .fromPath(params.hic_read1, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    hic_read2_ch = params.hic_read2 ? Channel.fromPath(params.hic_read2, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    bin_files_ch = Channel
        .fromPath(params.bin_files, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    HIFIASM(long_reads_ch.combine(ul_reads_ch), paternal_kmer_dump_ch.combine(maternal_kmer_dump_ch).first(), hic_read1_ch.combine(hic_read2_ch).first(), bin_files_ch.first())
}
