#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SEACR_CALLPEAK } from '../main.nf'

params.bedgraph = null
params.ctrlbedgraph = null
params.threshold = null
params.args = ""
params.outdir = "results"

workflow {
    bedgraph_ch = Channel
        .fromPath(params.bedgraph, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    ctrlbedgraph_ch = params.ctrlbedgraph ? Channel.fromPath(params.ctrlbedgraph, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    SEACR_CALLPEAK(bedgraph_ch.combine(ctrlbedgraph_ch), params.threshold)
}
