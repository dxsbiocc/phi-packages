#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { PHARMCAT_PHENOTYPER } from '../main.nf'

params.match_json = null
params.outside_match_tsv = null
params.args = ""
params.outdir = "results"

workflow {
    match_json_ch = Channel
        .fromPath(params.match_json, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    outside_match_tsv_ch = params.outside_match_tsv ? Channel.fromPath(params.outside_match_tsv, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    PHARMCAT_PHENOTYPER(match_json_ch.combine(outside_match_tsv_ch))
}
