#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { PHARMCAT_VCFPREPROCESSOR } from '../main.nf'

params.vcf_gz = null
params.vcf_index = null
params.fasta = null
params.fai = null
params.pharmcat_positions = null
params.pharmcat_positions_index = null
params.pharmcat_uniallelic_positions = null
params.pharmcat_uniallelic_positions_index = null
params.args = ""
params.outdir = "results"

workflow {
    vcf_gz_ch = Channel
        .fromPath(params.vcf_gz, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    vcf_index_ch = params.vcf_index ? Channel.fromPath(params.vcf_index, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fai_ch = Channel
        .fromPath(params.fai, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    pharmcat_positions_ch = Channel
        .fromPath(params.pharmcat_positions, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    pharmcat_positions_index_ch = params.pharmcat_positions_index ? Channel.fromPath(params.pharmcat_positions_index, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    pharmcat_uniallelic_positions_ch = Channel
        .fromPath(params.pharmcat_uniallelic_positions, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    pharmcat_uniallelic_positions_index_ch = params.pharmcat_uniallelic_positions_index ? Channel.fromPath(params.pharmcat_uniallelic_positions_index, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    PHARMCAT_VCFPREPROCESSOR(vcf_gz_ch.combine(vcf_index_ch), fasta_ch.first(), fai_ch.first(), pharmcat_positions_ch.combine(pharmcat_positions_index_ch).first(), pharmcat_uniallelic_positions_ch.combine(pharmcat_uniallelic_positions_index_ch).first())
}
