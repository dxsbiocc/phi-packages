#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SCVITOOLS_SCAR } from '../main.nf'

params.filtered = null
params.unfiltered = null
params.input_layer = null
params.output_layer = null
params.max_epochs = null
params.n_batch = null
params.outdir = "results"

workflow {
    filtered_ch = Channel
        .fromPath(params.filtered, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    unfiltered_ch = params.unfiltered ? Channel.fromPath(params.unfiltered, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    SCVITOOLS_SCAR(filtered_ch.combine(unfiltered_ch), params.input_layer, params.output_layer, params.max_epochs, params.n_batch)
}
