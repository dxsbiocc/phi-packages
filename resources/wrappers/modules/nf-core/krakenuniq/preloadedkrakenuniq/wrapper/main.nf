#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { KRAKENUNIQ_PRELOADEDKRAKENUNIQ } from '../main.nf'

params.sequences = null
params.prefixes = null
params.sequence_type = null
params.db = null
params.save_output_reads = false
params.report_file = false
params.save_output = false
params.args = ""
params.outdir = "results"

workflow {
    sequences_ch = Channel
        .fromPath(params.sequences, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    db_ch = params.db ? Channel.fromPath(params.db, checkIfExists: true).first() : Channel.value([])

    KRAKENUNIQ_PRELOADEDKRAKENUNIQ(sequences_ch.map { t -> t + [params.prefixes] }, params.sequence_type, db_ch, params.save_output_reads, params.report_file, params.save_output)
}
