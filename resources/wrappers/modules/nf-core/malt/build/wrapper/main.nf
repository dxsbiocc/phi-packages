#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { MALT_BUILD } from '../main.nf'

params.fastas = null
params.gff = null
params.mapping_db = null
params.map_type = null
params.args = ""
params.outdir = "results"

workflow {
    fastas_ch = Channel
        .fromPath("${params.fastas}/*", checkIfExists: true)
        .collect()
        .map { files -> [[id: 'input'], files] }
    gff_ch = params.gff ? Channel.fromPath(params.gff, checkIfExists: true).first() : Channel.value([])
    mapping_db_ch = params.mapping_db ? Channel.fromPath(params.mapping_db, checkIfExists: true).first() : Channel.value([])

    MALT_BUILD(fastas_ch, gff_ch, mapping_db_ch, params.map_type)
}
