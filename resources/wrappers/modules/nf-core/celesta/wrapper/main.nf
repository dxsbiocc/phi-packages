#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { CELESTA } from '../main.nf'

params.img_data = null
params.signature = null
params.high_thresholds = null
params.low_thresholds = null
params.args = ""
params.outdir = "results"

workflow {
    img_data_ch = Channel
        .fromPath(params.img_data, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    signature_ch = Channel.fromPath(params.signature, checkIfExists: true)
    high_thresholds_ch = Channel.fromPath(params.high_thresholds, checkIfExists: true)
    low_thresholds_ch = Channel.fromPath(params.low_thresholds, checkIfExists: true)

    CELESTA(img_data_ch, signature_ch, high_thresholds_ch, low_thresholds_ch)
}
