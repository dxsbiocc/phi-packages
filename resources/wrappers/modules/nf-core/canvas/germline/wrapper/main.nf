#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { CANVAS_GERMLINE } from '../main.nf'

params.bam = null
params.bai = null
params.germline_snv_vcf = null
params.male_ploidy_vcf = null
params.female_ploidy_vcf = null
params.sex = null
params.genomedir = null
params.reference = null
params.filter13 = null
params.outdir = "results"

workflow {
    bam_ch = Channel
        .fromPath(params.bam, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bai_ch = params.bai ? Channel.fromPath(params.bai, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    germline_snv_vcf_ch = Channel.fromPath(params.germline_snv_vcf, checkIfExists: true)
    male_ploidy_vcf_ch = Channel
        .fromPath(params.male_ploidy_vcf, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    female_ploidy_vcf_ch = params.female_ploidy_vcf ? Channel.fromPath(params.female_ploidy_vcf, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    genomedir_ch = params.genomedir ? Channel.fromPath(params.genomedir, checkIfExists: true).first() : Channel.value([])
    reference_ch = params.reference ? Channel.fromPath(params.reference, checkIfExists: true).first() : Channel.value([])
    filter13_ch = Channel.fromPath(params.filter13, checkIfExists: true)

    CANVAS_GERMLINE(bam_ch.combine(bai_ch), germline_snv_vcf_ch, male_ploidy_vcf_ch.combine(female_ploidy_vcf_ch).map { t -> t + [params.sex] }.first(), genomedir_ch, reference_ch, filter13_ch)
}
