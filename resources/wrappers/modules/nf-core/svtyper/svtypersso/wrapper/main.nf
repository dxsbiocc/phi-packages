#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SVTYPER_SVTYPERSSO } from '../main.nf'

params.bam = null
params.bam_index = null
params.vcf = null
params.fasta = null
params.args = ""
params.outdir = "results"

workflow {
    bam_ch = Channel
        .fromPath(params.bam, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bam_index_ch = params.bam_index ? Channel.fromPath(params.bam_index, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    vcf_ch = params.vcf ? Channel.fromPath(params.vcf, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    SVTYPER_SVTYPERSSO(bam_ch.combine(bam_index_ch).combine(vcf_ch), fasta_ch.first())
}
