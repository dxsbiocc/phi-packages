#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { LEAFCUTTER_DIFFERENTIALSPLICING } from '../main.nf'

params.counts = null
params.groups = null
params.args = ""
params.outdir = "results"

workflow {
    counts_ch = Channel
        .fromPath(params.counts, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    groups_ch = params.groups ? Channel.fromPath(params.groups, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    LEAFCUTTER_DIFFERENTIALSPLICING(counts_ch.combine(groups_ch))
}
