#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { ICHORCNA_CREATEPON } from '../main.nf'

params.wigs = null
params.gc_wig = null
params.map_wig = null
params.centromere = null
params.rep_time_wig = null
params.exons = null
params.args = ""
params.outdir = "results"

workflow {
    wigs_ch = Channel
        .fromPath(params.wigs, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    gc_wig_ch = Channel.fromPath(params.gc_wig, checkIfExists: true)
    map_wig_ch = Channel.fromPath(params.map_wig, checkIfExists: true)
    centromere_ch = Channel.fromPath(params.centromere, checkIfExists: true)
    rep_time_wig_ch = Channel.fromPath(params.rep_time_wig, checkIfExists: true)
    exons_ch = Channel.fromPath(params.exons, checkIfExists: true)

    ICHORCNA_CREATEPON(wigs_ch, gc_wig_ch, map_wig_ch, centromere_ch, rep_time_wig_ch, exons_ch)
}
