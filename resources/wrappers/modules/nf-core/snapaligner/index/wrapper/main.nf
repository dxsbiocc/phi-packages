#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SNAPALIGNER_INDEX } from '../main.nf'

params.fasta = null
params.altcontigfile = null
params.nonaltcontigfile = null
params.altliftoverfile = null
params.args = ""
params.outdir = "results"

workflow {
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    altcontigfile_ch = params.altcontigfile ? Channel.fromPath(params.altcontigfile, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    nonaltcontigfile_ch = params.nonaltcontigfile ? Channel.fromPath(params.nonaltcontigfile, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    altliftoverfile_ch = params.altliftoverfile ? Channel.fromPath(params.altliftoverfile, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    SNAPALIGNER_INDEX(fasta_ch.combine(altcontigfile_ch).combine(nonaltcontigfile_ch).combine(altliftoverfile_ch))
}
