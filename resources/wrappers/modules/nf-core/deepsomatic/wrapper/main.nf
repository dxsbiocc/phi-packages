#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { DEEPSOMATIC } from '../main.nf'

params.input_normal = null
params.index_normal = null
params.input_tumor = null
params.index_tumor = null
params.intervals = null
params.fasta = null
params.fai = null
params.gzi = null
params.args = ""
params.outdir = "results"

workflow {
    input_normal_ch = Channel
        .fromPath(params.input_normal, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    index_normal_ch = params.index_normal ? Channel.fromPath(params.index_normal, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    input_tumor_ch = params.input_tumor ? Channel.fromPath(params.input_tumor, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    index_tumor_ch = params.index_tumor ? Channel.fromPath(params.index_tumor, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    intervals_ch = Channel
        .fromPath(params.intervals, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fai_ch = Channel
        .fromPath(params.fai, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    gzi_ch = Channel
        .fromPath(params.gzi, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    DEEPSOMATIC(input_normal_ch.combine(index_normal_ch).combine(input_tumor_ch).combine(index_tumor_ch), intervals_ch.first(), fasta_ch.first(), fai_ch.first(), gzi_ch.first())
}
