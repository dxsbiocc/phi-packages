#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { MITOHIFI_MITOHIFI } from '../main.nf'

params.input = null
params.ref_fa = null
params.ref_gb = null
params.input_mode = null
params.mito_code = null
params.args = ""
params.outdir = "results"

workflow {
    input_ch = Channel
        .fromPath(params.input, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    ref_fa_ch = Channel
        .fromPath(params.ref_fa, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    ref_gb_ch = params.ref_gb ? Channel.fromPath(params.ref_gb, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    MITOHIFI_MITOHIFI(input_ch, ref_fa_ch.combine(ref_gb_ch).first(), params.input_mode, params.mito_code)
}
