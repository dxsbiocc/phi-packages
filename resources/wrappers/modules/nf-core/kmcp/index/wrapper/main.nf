#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { KMCP_INDEX } from '../main.nf'

params.compute_dir = null
params.taxdmp = null
params.seq2taxidmap = null
params.args = ""
params.outdir = "results"

workflow {
    compute_dir_ch = Channel
        .fromPath(params.compute_dir, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    taxdmp_ch = Channel
        .fromPath("${params.taxdmp}/*", checkIfExists: true)
        .collect()
        .map { files -> [[id: 'input'], files] }
    seq2taxidmap_ch = Channel
        .fromPath("${params.seq2taxidmap}/*", checkIfExists: true)
        .collect()
        .map { files -> [[id: 'input'], files] }

    KMCP_INDEX(compute_dir_ch, taxdmp_ch.first(), seq2taxidmap_ch.first())
}
