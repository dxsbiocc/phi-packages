#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { AARDVARK_MERGE } from '../main.nf'

params.vcfs = null
params.indexes = null
params.fasta = null
params.bed = null
params.args = ""
params.outdir = "results"

workflow {
    vcfs_ch = Channel
        .fromPath(params.vcfs, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    indexes_ch = params.indexes ? Channel.fromPath(params.indexes, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bed_ch = Channel
        .fromPath(params.bed, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    AARDVARK_MERGE(vcfs_ch.combine(indexes_ch), fasta_ch.first(), bed_ch.first())
}
