#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { AARDVARK_COMPARE } from '../main.nf'

params.query_vcf = null
params.query_vcf_tbi = null
params.truth_vcf = null
params.truth_vcf_tbi = null
params.regions_bed = null
params.fasta = null
params.stratification_tsv = null
params.stratification_beds = null
params.args = ""
params.outdir = "results"

workflow {
    query_vcf_ch = Channel
        .fromPath(params.query_vcf, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    query_vcf_tbi_ch = params.query_vcf_tbi ? Channel.fromPath(params.query_vcf_tbi, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    truth_vcf_ch = params.truth_vcf ? Channel.fromPath(params.truth_vcf, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    truth_vcf_tbi_ch = params.truth_vcf_tbi ? Channel.fromPath(params.truth_vcf_tbi, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    regions_bed_ch = params.regions_bed ? Channel.fromPath(params.regions_bed, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    stratification_tsv_ch = Channel
        .fromPath(params.stratification_tsv, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    stratification_beds_ch = Channel
        .fromPath(params.stratification_beds, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    AARDVARK_COMPARE(query_vcf_ch.combine(query_vcf_tbi_ch).combine(truth_vcf_ch).combine(truth_vcf_tbi_ch).combine(regions_bed_ch), fasta_ch.first(), stratification_tsv_ch.first(), stratification_beds_ch.first())
}
