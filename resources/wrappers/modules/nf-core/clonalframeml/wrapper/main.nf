#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { CLONALFRAMEML } from '../main.nf'

params.newick = null
params.msa = null
params.args = ""
params.outdir = "results"

workflow {
    newick_ch = Channel
        .fromPath(params.newick, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    msa_ch = params.msa ? Channel.fromPath(params.msa, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    CLONALFRAMEML(newick_ch.combine(msa_ch))
}
