#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { STARDIST } from '../main.nf'

params.image = null
params.model_path = null
params.model_name = null
params.args = ""
params.outdir = "results"

workflow {
    image_ch = Channel
        .fromPath(params.image, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    model_path_ch = Channel
        .fromPath(params.model_path, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    STARDIST(image_ch, model_path_ch.map { t -> t + [params.model_name] }.first())
}
