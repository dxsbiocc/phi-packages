#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { MERQURYFK_KATCOMP } from '../main.nf'

params.fastk1_hist = null
params.fastk1_ktab = null
params.fastk2_hist = null
params.fastk2_ktab = null
params.args = ""
params.outdir = "results"

workflow {
    fastk1_hist_ch = Channel
        .fromPath(params.fastk1_hist, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fastk1_ktab_ch = params.fastk1_ktab ? Channel.fromPath(params.fastk1_ktab, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fastk2_hist_ch = params.fastk2_hist ? Channel.fromPath(params.fastk2_hist, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fastk2_ktab_ch = params.fastk2_ktab ? Channel.fromPath(params.fastk2_ktab, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    MERQURYFK_KATCOMP(fastk1_hist_ch.combine(fastk1_ktab_ch).combine(fastk2_hist_ch).combine(fastk2_ktab_ch))
}
