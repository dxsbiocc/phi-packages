#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { MERQURYFK_PLOIDYPLOT } from '../main.nf'

params.fastk_hist = null
params.fastk_ktab = null
params.args = ""
params.outdir = "results"

workflow {
    fastk_hist_ch = Channel
        .fromPath(params.fastk_hist, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fastk_ktab_ch = params.fastk_ktab ? Channel.fromPath(params.fastk_ktab, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    MERQURYFK_PLOIDYPLOT(fastk_hist_ch.combine(fastk_ktab_ch))
}
