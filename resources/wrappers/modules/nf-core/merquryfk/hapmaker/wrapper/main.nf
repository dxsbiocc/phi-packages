#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { MERQURYFK_HAPMAKER } from '../main.nf'

params.matktab = null
params.patktab = null
params.childktab = null
params.args = ""
params.outdir = "results"

workflow {
    matktab_ch = Channel
        .fromPath(params.matktab, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    patktab_ch = Channel
        .fromPath(params.patktab, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    childktab_ch = Channel
        .fromPath(params.childktab, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    MERQURYFK_HAPMAKER(matktab_ch, patktab_ch.first(), childktab_ch.first())
}
