#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { MERQURYFK_MERQURYFK } from '../main.nf'

params.fastk_hist = null
params.fastk_ktab = null
params.assembly = null
params.haplotigs = null
params.mathaptab = null
params.pathaptab = null
params.args = ""
params.outdir = "results"

workflow {
    fastk_hist_ch = Channel
        .fromPath(params.fastk_hist, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fastk_ktab_ch = params.fastk_ktab ? Channel.fromPath(params.fastk_ktab, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    assembly_ch = params.assembly ? Channel.fromPath(params.assembly, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    haplotigs_ch = params.haplotigs ? Channel.fromPath(params.haplotigs, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    mathaptab_ch = Channel
        .fromPath(params.mathaptab, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    pathaptab_ch = Channel
        .fromPath(params.pathaptab, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    MERQURYFK_MERQURYFK(fastk_hist_ch.combine(fastk_ktab_ch).combine(assembly_ch).combine(haplotigs_ch), mathaptab_ch.first(), pathaptab_ch.first())
}
