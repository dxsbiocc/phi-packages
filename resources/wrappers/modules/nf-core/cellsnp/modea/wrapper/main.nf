#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { CELLSNP_MODEA } from '../main.nf'

params.bam = null
params.bai = null
params.region_vcf = null
params.barcode = null
params.args = ""
params.outdir = "results"

workflow {
    bam_ch = Channel
        .fromPath(params.bam, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bai_ch = params.bai ? Channel.fromPath(params.bai, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    region_vcf_ch = params.region_vcf ? Channel.fromPath(params.region_vcf, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    barcode_ch = params.barcode ? Channel.fromPath(params.barcode, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    CELLSNP_MODEA(bam_ch.combine(bai_ch).combine(region_vcf_ch).combine(barcode_ch))
}
