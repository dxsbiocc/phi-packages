#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { ARTIC_MINION } from '../main.nf'

params.fastq = null
params.model_dir = null
params.model = null
params.fasta = null
params.bed = null
params.hdf5_plugin_path = null
params.args = ""
params.outdir = "results"

workflow {
    fastq_ch = Channel
        .fromFilePairs(params.fastq, size: -1)
        .map { sample, reads -> [[id: sample, single_end: reads instanceof List ? reads.size() == 1 : true], reads] }
    model_dir_ch = Channel
        .fromPath(params.model_dir, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bed_ch = params.bed ? Channel.fromPath(params.bed, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    hdf5_plugin_path_ch = Channel.fromPath(params.hdf5_plugin_path, checkIfExists: true)

    ARTIC_MINION(fastq_ch, model_dir_ch.map { t -> t + [params.model] }.first(), fasta_ch.combine(bed_ch).first(), hdf5_plugin_path_ch)
}
