#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { ARTIC_ALIGNTRIM } from '../main.nf'

params.samfile = null
params.scheme_bed = null
params.normalise_depth = null
params.sort_bam = false
params.args = ""
params.outdir = "results"

workflow {
    samfile_ch = Channel
        .fromPath(params.samfile, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    scheme_bed_ch = params.scheme_bed ? Channel.fromPath(params.scheme_bed, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    ARTIC_ALIGNTRIM(samfile_ch.combine(scheme_bed_ch).map { t -> t + [params.normalise_depth] }, params.sort_bam)
}
