#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { MALTEXTRACT } from '../main.nf'

params.rma6 = null
params.taxon_list = null
params.ncbi_dir = null
params.args = ""
params.outdir = "results"

workflow {
    rma6_ch = Channel
        .fromPath(params.rma6, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    taxon_list_ch = Channel.fromPath(params.taxon_list, checkIfExists: true)
    ncbi_dir_ch = Channel.fromPath(params.ncbi_dir, checkIfExists: true)

    MALTEXTRACT(rma6_ch, taxon_list_ch, ncbi_dir_ch)
}
