#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { MODKIT_REPAIR } from '../main.nf'

params.before_trim = null
params.after_trim = null
params.args = ""
params.outdir = "results"

workflow {
    before_trim_ch = Channel
        .fromPath(params.before_trim, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    after_trim_ch = params.after_trim ? Channel.fromPath(params.after_trim, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    MODKIT_REPAIR(before_trim_ch.combine(after_trim_ch))
}
