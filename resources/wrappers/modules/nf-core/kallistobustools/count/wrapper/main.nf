#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { KALLISTOBUSTOOLS_COUNT } from '../main.nf'

params.reads = null
params.index = null
params.t2g = null
params.t1c = null
params.t2c = null
params.technology = null
params.workflow_mode = null
params.args = ""
params.outdir = "results"

workflow {
    reads_ch = Channel
        .fromPath(params.reads, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    index_ch = Channel
        .fromPath(params.index, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    t2g_ch = Channel.fromPath(params.t2g, checkIfExists: true)
    t1c_ch = Channel.fromPath(params.t1c, checkIfExists: true)
    t2c_ch = Channel.fromPath(params.t2c, checkIfExists: true)

    KALLISTOBUSTOOLS_COUNT(reads_ch, index_ch.first(), t2g_ch, t1c_ch, t2c_ch, params.technology, params.workflow_mode)
}
