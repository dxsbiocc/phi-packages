#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SAWFISH_JOINTCALL } from '../main.nf'

params.sample_dirs = null
params.fasta = null
params.bams = null
params.bais = null
params.sample_csv = null
params.args = ""
params.outdir = "results"

workflow {
    sample_dirs_ch = Channel
        .fromPath(params.sample_dirs, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bams_ch = Channel
        .fromPath(params.bams, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bais_ch = params.bais ? Channel.fromPath(params.bais, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    sample_csv_ch = Channel
        .fromPath(params.sample_csv, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    SAWFISH_JOINTCALL(sample_dirs_ch, fasta_ch.first(), bams_ch.combine(bais_ch).first(), sample_csv_ch.first())
}
