#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SAWFISH_DISCOVER } from '../main.nf'

params.bam = null
params.bai = null
params.fasta = null
params.expected_cn_bed = null
params.maf_vcf = null
params.cnv_exclude_regions_bed = null
params.args = ""
params.outdir = "results"

workflow {
    bam_ch = Channel
        .fromPath(params.bam, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bai_ch = params.bai ? Channel.fromPath(params.bai, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    expected_cn_bed_ch = Channel
        .fromPath(params.expected_cn_bed, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    maf_vcf_ch = Channel
        .fromPath(params.maf_vcf, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    cnv_exclude_regions_bed_ch = Channel
        .fromPath(params.cnv_exclude_regions_bed, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    SAWFISH_DISCOVER(bam_ch.combine(bai_ch), fasta_ch.first(), expected_cn_bed_ch.first(), maf_vcf_ch.first(), cnv_exclude_regions_bed_ch.first())
}
