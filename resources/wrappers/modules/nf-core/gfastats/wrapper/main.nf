#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { GFASTATS } from '../main.nf'

params.assembly = null
params.out_fmt = null
params.genome_size = null
params.target = null
params.agpfile = null
params.include_bed = null
params.exclude_bed = null
params.instructions = null
params.args = ""
params.outdir = "results"

workflow {
    assembly_ch = Channel
        .fromFilePairs(params.assembly, size: -1)
        .map { sample, reads -> [[id: sample, single_end: reads instanceof List ? reads.size() == 1 : true], reads] }
    agpfile_ch = Channel
        .fromPath(params.agpfile, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    include_bed_ch = Channel
        .fromPath(params.include_bed, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    exclude_bed_ch = Channel
        .fromPath(params.exclude_bed, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    instructions_ch = Channel
        .fromPath(params.instructions, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    GFASTATS(assembly_ch, params.out_fmt, params.genome_size, params.target, agpfile_ch.first(), include_bed_ch.first(), exclude_bed_ch.first(), instructions_ch.first())
}
