#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { PYPGX_RUNNGSPIPELINE } from '../main.nf'

params.vcf = null
params.tbi = null
params.coverage = null
params.control_stats = null
params.pgx_gene = null
params.resource_bundle = null
params.args = ""
params.outdir = "results"

workflow {
    vcf_ch = Channel
        .fromPath(params.vcf, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    tbi_ch = params.tbi ? Channel.fromPath(params.tbi, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    coverage_ch = params.coverage ? Channel.fromPath(params.coverage, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    control_stats_ch = params.control_stats ? Channel.fromPath(params.control_stats, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    resource_bundle_ch = Channel
        .fromPath(params.resource_bundle, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    PYPGX_RUNNGSPIPELINE(vcf_ch.combine(tbi_ch).combine(coverage_ch).combine(control_stats_ch).map { t -> t + [params.pgx_gene] }, resource_bundle_ch.first())
}
