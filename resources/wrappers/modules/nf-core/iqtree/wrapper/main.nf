#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { IQTREE } from '../main.nf'

params.alignment = null
params.tree = null
params.tree_te = null
params.lmclust = null
params.mdef = null
params.partitions_equal = null
params.partitions_proportional = null
params.partitions_unlinked = null
params.guide_tree = null
params.sitefreq_in = null
params.constraint_tree = null
params.trees_z = null
params.suptree = null
params.trees_rf = null
params.args = ""
params.outdir = "results"

workflow {
    alignment_ch = Channel
        .fromPath(params.alignment, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    tree_ch = params.tree ? Channel.fromPath(params.tree, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    tree_te_ch = Channel.fromPath(params.tree_te, checkIfExists: true)
    lmclust_ch = Channel.fromPath(params.lmclust, checkIfExists: true)
    mdef_ch = Channel.fromPath(params.mdef, checkIfExists: true)
    partitions_equal_ch = Channel.fromPath(params.partitions_equal, checkIfExists: true)
    partitions_proportional_ch = Channel.fromPath(params.partitions_proportional, checkIfExists: true)
    partitions_unlinked_ch = Channel.fromPath(params.partitions_unlinked, checkIfExists: true)
    guide_tree_ch = Channel.fromPath(params.guide_tree, checkIfExists: true)
    sitefreq_in_ch = Channel.fromPath(params.sitefreq_in, checkIfExists: true)
    constraint_tree_ch = Channel.fromPath(params.constraint_tree, checkIfExists: true)
    trees_z_ch = Channel.fromPath(params.trees_z, checkIfExists: true)
    suptree_ch = Channel.fromPath(params.suptree, checkIfExists: true)
    trees_rf_ch = Channel.fromPath(params.trees_rf, checkIfExists: true)

    IQTREE(alignment_ch.combine(tree_ch), tree_te_ch, lmclust_ch, mdef_ch, partitions_equal_ch, partitions_proportional_ch, partitions_unlinked_ch, guide_tree_ch, sitefreq_in_ch, constraint_tree_ch, trees_z_ch, suptree_ch, trees_rf_ch)
}
