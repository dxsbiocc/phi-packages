#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { VELOCYTO } from '../main.nf'

params.barcodes = null
params.bam = null
params.sorted_bam = null
params.gtf = null
params.args = ""
params.outdir = "results"

workflow {
    barcodes_ch = Channel
        .fromPath(params.barcodes, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bam_ch = params.bam ? Channel.fromPath(params.bam, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    sorted_bam_ch = params.sorted_bam ? Channel.fromPath(params.sorted_bam, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    gtf_ch = params.gtf ? Channel.fromPath(params.gtf, checkIfExists: true).first() : Channel.value([])

    VELOCYTO(barcodes_ch.combine(bam_ch).combine(sorted_bam_ch), gtf_ch)
}
