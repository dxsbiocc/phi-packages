#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { NACHO_QC } from '../main.nf'

params.rcc_files = null
params.sample_sheet = null
params.outdir = "results"

workflow {
    rcc_files_ch = Channel
        .fromPath("${params.rcc_files}/*", checkIfExists: true)
        .collect()
        .map { files -> [[id: 'input'], files] }
    sample_sheet_ch = Channel
        .fromPath(params.sample_sheet, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    NACHO_QC(rcc_files_ch, sample_sheet_ch.first())
}
