#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { RAGTAG_PATCH } from '../main.nf'

params.target = null
params.query = null
params.exclude = null
params.skip = null
params.args = ""
params.outdir = "results"

workflow {
    target_ch = Channel
        .fromPath(params.target, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    query_ch = Channel
        .fromPath(params.query, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    exclude_ch = Channel
        .fromPath(params.exclude, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    skip_ch = Channel
        .fromPath(params.skip, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    RAGTAG_PATCH(target_ch, query_ch.first(), exclude_ch.first(), skip_ch.first())
}
