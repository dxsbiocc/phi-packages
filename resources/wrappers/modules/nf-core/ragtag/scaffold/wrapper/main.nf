#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { RAGTAG_SCAFFOLD } from '../main.nf'

params.assembly = null
params.reference = null
params.exclude = null
params.skip = null
params.hard_skip = null
params.args = ""
params.outdir = "results"

workflow {
    assembly_ch = Channel
        .fromPath(params.assembly, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    reference_ch = Channel
        .fromPath(params.reference, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    exclude_ch = Channel
        .fromPath(params.exclude, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    skip_ch = Channel
        .fromPath(params.skip, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    hard_skip_ch = params.hard_skip ? Channel.fromPath(params.hard_skip, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    RAGTAG_SCAFFOLD(assembly_ch, reference_ch.first(), exclude_ch.first(), skip_ch.combine(hard_skip_ch).first())
}
