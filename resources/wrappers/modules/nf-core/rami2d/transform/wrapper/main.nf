#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { RAMI2D_TRANSFORM } from '../main.nf'

params.image_file = null
params.transform_dir = null
params.markers = null
params.mpp = null
params.args = ""
params.outdir = "results"

workflow {
    image_file_ch = Channel
        .fromPath(params.image_file, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    transform_dir_ch = params.transform_dir ? Channel.fromPath(params.transform_dir, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    markers_ch = Channel
        .fromPath(params.markers, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    RAMI2D_TRANSFORM(image_file_ch.combine(transform_dir_ch), markers_ch.first(), params.mpp)
}
