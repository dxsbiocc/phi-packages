#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { RAMI2D_REGISTER } from '../main.nf'

params.fixed_img = null
params.moving_img = null
params.markers = null
params.ifix = null
params.imov = null
params.mpp_fix = null
params.mpp_mov = null
params.mpp_reg = null
params.args = ""
params.outdir = "results"

workflow {
    fixed_img_ch = Channel
        .fromPath(params.fixed_img, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    moving_img_ch = params.moving_img ? Channel.fromPath(params.moving_img, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    markers_ch = Channel
        .fromPath(params.markers, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    RAMI2D_REGISTER(fixed_img_ch.combine(moving_img_ch), markers_ch.first(), params.ifix, params.imov, params.mpp_fix, params.mpp_mov, params.mpp_reg)
}
