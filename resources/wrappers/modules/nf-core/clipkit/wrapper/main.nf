#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { CLIPKIT } from '../main.nf'

params.aln = null
params.out_format = null
params.auxiliary_file = null
params.args = ""
params.outdir = "results"

workflow {
    aln_ch = Channel
        .fromPath(params.aln, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    auxiliary_file_ch = Channel.fromPath(params.auxiliary_file, checkIfExists: true)

    CLIPKIT(aln_ch, params.out_format, auxiliary_file_ch)
}
