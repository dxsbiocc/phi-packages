#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SEVERUS } from '../main.nf'

params.target_input = null
params.target_index = null
params.control_input = null
params.control_index = null
params.vcf = null
params.bed = null
params.args = ""
params.outdir = "results"

workflow {
    target_input_ch = Channel
        .fromPath(params.target_input, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    target_index_ch = params.target_index ? Channel.fromPath(params.target_index, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    control_input_ch = params.control_input ? Channel.fromPath(params.control_input, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    control_index_ch = params.control_index ? Channel.fromPath(params.control_index, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    vcf_ch = params.vcf ? Channel.fromPath(params.vcf, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    bed_ch = Channel
        .fromPath(params.bed, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    SEVERUS(target_input_ch.combine(target_index_ch).combine(control_input_ch).combine(control_index_ch).combine(vcf_ch), bed_ch.first())
}
