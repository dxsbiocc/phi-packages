#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { LLAMACPPPYTHON_RUN } from '../main.nf'

params.prompt_file = null
params.gguf_model = null
params.args = ""
params.outdir = "results"

workflow {
    prompt_file_ch = Channel
        .fromPath(params.prompt_file, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    gguf_model_ch = params.gguf_model ? Channel.fromPath(params.gguf_model, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    LLAMACPPPYTHON_RUN(prompt_file_ch.combine(gguf_model_ch))
}
