#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { DEEPVARIANT_POSTPROCESSVARIANTS } from '../main.nf'

params.variant_calls_tfrecord_files = null
params.gvcf_tfrecords = null
params.small_model_calls = null
params.phase_inputs = null
params.intervals = null
params.fasta = null
params.fai = null
params.gzi = null
params.args = ""
params.outdir = "results"

workflow {
    variant_calls_tfrecord_files_ch = Channel
        .fromPath(params.variant_calls_tfrecord_files, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    gvcf_tfrecords_ch = params.gvcf_tfrecords ? Channel.fromPath(params.gvcf_tfrecords, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    small_model_calls_ch = params.small_model_calls ? Channel.fromPath(params.small_model_calls, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    phase_inputs_ch = params.phase_inputs ? Channel.fromPath(params.phase_inputs, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    intervals_ch = params.intervals ? Channel.fromPath(params.intervals, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fai_ch = Channel
        .fromPath(params.fai, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    gzi_ch = Channel
        .fromPath(params.gzi, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    DEEPVARIANT_POSTPROCESSVARIANTS(variant_calls_tfrecord_files_ch.combine(gvcf_tfrecords_ch).combine(small_model_calls_ch).combine(phase_inputs_ch).combine(intervals_ch), fasta_ch.first(), fai_ch.first(), gzi_ch.first())
}
