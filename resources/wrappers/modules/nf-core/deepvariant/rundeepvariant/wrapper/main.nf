#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { DEEPVARIANT_RUNDEEPVARIANT } from '../main.nf'

params.input = null
params.index = null
params.intervals = null
params.fasta = null
params.fai = null
params.gzi = null
params.par_bed = null
params.args = ""
params.outdir = "results"

workflow {
    input_ch = Channel
        .fromPath(params.input, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    index_ch = params.index ? Channel.fromPath(params.index, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    intervals_ch = params.intervals ? Channel.fromPath(params.intervals, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fai_ch = Channel
        .fromPath(params.fai, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    gzi_ch = Channel
        .fromPath(params.gzi, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    par_bed_ch = Channel
        .fromPath(params.par_bed, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    DEEPVARIANT_RUNDEEPVARIANT(input_ch.combine(index_ch).combine(intervals_ch), fasta_ch.first(), fai_ch.first(), gzi_ch.first(), par_bed_ch.first())
}
