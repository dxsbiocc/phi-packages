#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { AMPCOMBI2_PARSETABLES } from '../main.nf'

params.amp_input = null
params.faa_input = null
params.gbk_input = null
params.opt_amp_db = null
params.opt_amp_db_dir = null
params.opt_interproscan = null
params.args = ""
params.outdir = "results"

workflow {
    amp_input_ch = Channel
        .fromPath(params.amp_input, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    faa_input_ch = Channel.fromPath(params.faa_input, checkIfExists: true)
    gbk_input_ch = Channel.fromPath(params.gbk_input, checkIfExists: true)
    opt_amp_db_dir_ch = Channel.fromPath(params.opt_amp_db_dir, checkIfExists: true)
    opt_interproscan_ch = Channel.fromPath(params.opt_interproscan, checkIfExists: true)

    AMPCOMBI2_PARSETABLES(amp_input_ch, faa_input_ch, gbk_input_ch, params.opt_amp_db, opt_amp_db_dir_ch, opt_interproscan_ch)
}
