#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SPADES } from '../main.nf'

params.illumina = null
params.pacbio = null
params.nanopore = null
params.yml = null
params.hmm = null
params.args = ""
params.outdir = "results"

workflow {
    illumina_ch = Channel
        .fromPath(params.illumina, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    pacbio_ch = params.pacbio ? Channel.fromPath(params.pacbio, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    nanopore_ch = params.nanopore ? Channel.fromPath(params.nanopore, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    yml_ch = Channel.fromPath(params.yml, checkIfExists: true)
    hmm_ch = Channel.fromPath(params.hmm, checkIfExists: true)

    SPADES(illumina_ch.combine(pacbio_ch).combine(nanopore_ch), yml_ch, hmm_ch)
}
