#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { MMSEQS_TAXONOMY } from '../main.nf'

params.db_query = null
params.db_target = null
params.args = ""
params.outdir = "results"

workflow {
    db_query_ch = Channel
        .fromPath(params.db_query, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    db_target_ch = Channel.fromPath(params.db_target, checkIfExists: true)

    MMSEQS_TAXONOMY(db_query_ch, db_target_ch)
}
