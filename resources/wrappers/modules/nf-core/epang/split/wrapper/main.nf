#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { EPANG_SPLIT } from '../main.nf'

params.refaln = null
params.fullaln = null
params.args = ""
params.outdir = "results"

workflow {
    refaln_ch = Channel
        .fromPath(params.refaln, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fullaln_ch = params.fullaln ? Channel.fromPath(params.fullaln, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    EPANG_SPLIT(refaln_ch.combine(fullaln_ch))
}
