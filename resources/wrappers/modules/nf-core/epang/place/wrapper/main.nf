#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { EPANG_PLACE } from '../main.nf'

params.queryaln = null
params.referencealn = null
params.referencetree = null
params.bfastfile = null
params.binaryfile = null
params.args = ""
params.outdir = "results"

workflow {
    queryaln_ch = Channel
        .fromPath(params.queryaln, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    referencealn_ch = params.referencealn ? Channel.fromPath(params.referencealn, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    referencetree_ch = params.referencetree ? Channel.fromPath(params.referencetree, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    bfastfile_ch = Channel.fromPath(params.bfastfile, checkIfExists: true)
    binaryfile_ch = Channel.fromPath(params.binaryfile, checkIfExists: true)

    EPANG_PLACE(queryaln_ch.combine(referencealn_ch).combine(referencetree_ch), bfastfile_ch, binaryfile_ch)
}
