#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { PREPARECOVANDBAF } from '../main.nf'

params.read_counts = null
params.gvcf = null
params.gvcf_tbi = null
params.baf_positions = null
params.args = ""
params.outdir = "results"

workflow {
    read_counts_ch = Channel
        .fromPath(params.read_counts, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    gvcf_ch = params.gvcf ? Channel.fromPath(params.gvcf, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    gvcf_tbi_ch = params.gvcf_tbi ? Channel.fromPath(params.gvcf_tbi, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    baf_positions_ch = Channel.fromPath(params.baf_positions, checkIfExists: true)

    PREPARECOVANDBAF(read_counts_ch.combine(gvcf_ch).combine(gvcf_tbi_ch), baf_positions_ch)
}
