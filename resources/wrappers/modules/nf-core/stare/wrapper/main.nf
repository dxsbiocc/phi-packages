#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { STARE } from '../main.nf'

params.bed_file = null
params.contact_folder = null
params.existing_abc = null
params.annotation = null
params.genome = null
params.psem = null
params.exclude_bed = null
params.genes = null
params.args = ""
params.outdir = "results"

workflow {
    bed_file_ch = Channel
        .fromPath(params.bed_file, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    contact_folder_ch = params.contact_folder ? Channel.fromPath(params.contact_folder, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    existing_abc_ch = params.existing_abc ? Channel.fromPath(params.existing_abc, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    annotation_ch = Channel
        .fromPath(params.annotation, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    genome_ch = Channel
        .fromPath(params.genome, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    psem_ch = Channel
        .fromPath(params.psem, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    exclude_bed_ch = Channel
        .fromPath(params.exclude_bed, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    genes_ch = Channel
        .fromPath(params.genes, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    STARE(bed_file_ch.combine(contact_folder_ch).combine(existing_abc_ch), annotation_ch.first(), genome_ch.first(), psem_ch.first(), exclude_bed_ch.first(), genes_ch.first())
}
