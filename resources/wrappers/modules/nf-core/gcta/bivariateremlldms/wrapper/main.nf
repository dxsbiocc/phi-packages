#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { GCTA_BIVARIATEREMLLDMS } from '../main.nf'

params.mgrm_file = null
params.grm_files = null
params.phenotype_file = null
params.phenotype_col1 = null
params.phenotype_col2 = null
params.quant_covariates_file = null
params.cat_covariates_file = null
params.args = ""
params.outdir = "results"

workflow {
    mgrm_file_ch = Channel
        .fromPath(params.mgrm_file, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    grm_files_ch = params.grm_files ? Channel.fromPath(params.grm_files, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    phenotype_file_ch = Channel
        .fromPath(params.phenotype_file, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    quant_covariates_file_ch = Channel
        .fromPath(params.quant_covariates_file, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    cat_covariates_file_ch = Channel
        .fromPath(params.cat_covariates_file, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    GCTA_BIVARIATEREMLLDMS(mgrm_file_ch.combine(grm_files_ch), phenotype_file_ch.map { t -> t + [params.phenotype_col1] }.map { t -> t + [params.phenotype_col2] }.first(), quant_covariates_file_ch.first(), cat_covariates_file_ch.first())
}
