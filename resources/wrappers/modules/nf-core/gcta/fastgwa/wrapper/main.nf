#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { GCTA_FASTGWA } from '../main.nf'

params.bed_pgen = null
params.bim_pvar = null
params.fam_psam = null
params.phenotype_file = null
params.quant_covariates_file = null
params.cat_covariates_file = null
params.sparse_grm_files = null
params.args = ""
params.outdir = "results"

workflow {
    bed_pgen_ch = Channel
        .fromPath(params.bed_pgen, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bim_pvar_ch = params.bim_pvar ? Channel.fromPath(params.bim_pvar, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fam_psam_ch = params.fam_psam ? Channel.fromPath(params.fam_psam, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    phenotype_file_ch = Channel
        .fromPath(params.phenotype_file, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    quant_covariates_file_ch = Channel
        .fromPath(params.quant_covariates_file, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    cat_covariates_file_ch = Channel
        .fromPath(params.cat_covariates_file, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    sparse_grm_files_ch = Channel
        .fromPath(params.sparse_grm_files, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    GCTA_FASTGWA(bed_pgen_ch.combine(bim_pvar_ch).combine(fam_psam_ch), phenotype_file_ch.first(), quant_covariates_file_ch.first(), cat_covariates_file_ch.first(), sparse_grm_files_ch.first())
}
