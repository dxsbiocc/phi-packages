#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { GCTA_MAKEGRM } from '../main.nf'

params.mfile = null
params.bed_pgen = null
params.bim_pvar = null
params.fam_psam = null
params.args = ""
params.outdir = "results"

workflow {
    mfile_ch = Channel
        .fromPath(params.mfile, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bed_pgen_ch = params.bed_pgen ? Channel.fromPath(params.bed_pgen, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    bim_pvar_ch = params.bim_pvar ? Channel.fromPath(params.bim_pvar, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fam_psam_ch = params.fam_psam ? Channel.fromPath(params.fam_psam, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    GCTA_MAKEGRM(mfile_ch.combine(bed_pgen_ch).combine(bim_pvar_ch).combine(fam_psam_ch))
}
