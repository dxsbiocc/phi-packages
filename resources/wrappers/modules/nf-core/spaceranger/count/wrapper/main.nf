#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SPACERANGER_COUNT } from '../main.nf'

params.reads = null
params.image = null
params.cytaimage = null
params.darkimage = null
params.colorizedimage = null
params.alignment = null
params.slidefile = null
params.slide = null
params.area = null
params.reference = null
params.probeset = null
params.args = ""
params.outdir = "results"

workflow {
    reads_ch = Channel
        .fromFilePairs(params.reads, size: -1)
        .map { sample, reads -> [[id: sample, single_end: reads instanceof List ? reads.size() == 1 : true], reads] }
    image_ch = params.image ? Channel.fromPath(params.image, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    cytaimage_ch = params.cytaimage ? Channel.fromPath(params.cytaimage, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    darkimage_ch = params.darkimage ? Channel.fromPath(params.darkimage, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    colorizedimage_ch = params.colorizedimage ? Channel.fromPath(params.colorizedimage, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    alignment_ch = params.alignment ? Channel.fromPath(params.alignment, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    slidefile_ch = params.slidefile ? Channel.fromPath(params.slidefile, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    reference_ch = params.reference ? Channel.fromPath(params.reference, checkIfExists: true).first() : Channel.value([])
    probeset_ch = Channel.fromPath(params.probeset, checkIfExists: true)

    SPACERANGER_COUNT(reads_ch.combine(image_ch).combine(cytaimage_ch).combine(darkimage_ch).combine(colorizedimage_ch).combine(alignment_ch).combine(slidefile_ch).map { t -> t + [params.slide] }.map { t -> t + [params.area] }, reference_ch, probeset_ch)
}
