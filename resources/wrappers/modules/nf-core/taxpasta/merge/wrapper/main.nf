#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { TAXPASTA_MERGE } from '../main.nf'

params.profiles = null
params.profiler = null
params.format = null
params.taxonomy = null
params.samplesheet = null
params.args = ""
params.outdir = "results"

workflow {
    profiles_ch = Channel
        .fromPath(params.profiles, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    taxonomy_ch = Channel.fromPath(params.taxonomy, checkIfExists: true)
    samplesheet_ch = Channel.fromPath(params.samplesheet, checkIfExists: true)

    TAXPASTA_MERGE(profiles_ch, params.profiler, params.format, taxonomy_ch, samplesheet_ch)
}
