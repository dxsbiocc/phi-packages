#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { CATPACK_PREPARE } from '../main.nf'

params.db_fasta = null
params.names = null
params.nodes = null
params.acc2tax = null
params.args = ""
params.outdir = "results"

workflow {
    db_fasta_ch = Channel
        .fromPath(params.db_fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    names_ch = Channel.fromPath(params.names, checkIfExists: true)
    nodes_ch = Channel.fromPath(params.nodes, checkIfExists: true)
    acc2tax_ch = Channel.fromPath(params.acc2tax, checkIfExists: true)

    CATPACK_PREPARE(db_fasta_ch, names_ch, nodes_ch, acc2tax_ch)
}
