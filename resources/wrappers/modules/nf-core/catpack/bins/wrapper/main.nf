#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { CATPACK_BINS } from '../main.nf'

params.bins = null
params.database = null
params.taxonomy = null
params.proteins = null
params.diamond_table = null
params.bin_suffix = null
params.args = ""
params.outdir = "results"

workflow {
    bins_ch = Channel
        .fromPath("${params.bins}/*", checkIfExists: true)
        .collect()
        .map { files -> [[id: 'input'], files] }
    database_ch = Channel
        .fromPath(params.database, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    taxonomy_ch = Channel
        .fromPath(params.taxonomy, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    proteins_ch = Channel
        .fromPath(params.proteins, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    diamond_table_ch = Channel
        .fromPath(params.diamond_table, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    CATPACK_BINS(bins_ch, database_ch.first(), taxonomy_ch.first(), proteins_ch.first(), diamond_table_ch.first(), params.bin_suffix)
}
