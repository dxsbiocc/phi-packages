// Launcher config for the catpack reads wrapper adapter. Not part of the fixed
// wrapper/{main.nf,params.json,wrapper.yaml} contract — Nextflow picks this
// up automatically because it sits beside wrapper/main.nf.

process {
    cpus   = 4
    memory = '8.GB'
    time   = '4.h'

    withName: 'CATPACK_READS' {
        publishDir = [
            path: { "${params.outdir}/catpack_reads" },
            mode: 'copy',
            pattern: '{*.CAT.log,*.ORF2LCA.txt,*.alignment.diamond,*.complete.abundance.txt,*.contig.abundance.txt,*.contig2classification.txt,*.predicted_proteins.faa,*.predicted_proteins.gff,*.read2classification.txt,*.unmapped2classification.txt,*_unmapped.alignment.diamond,*_unmapped.fasta}'
        ]
        ext.args = { params.args ?: '' }
    }
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}
