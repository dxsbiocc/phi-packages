#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { CATPACK_READS } from '../main.nf'

params.reads = null
params.contigs = null
params.database = null
params.taxonomy = null
params.bins = null
params.mode = null
params.bam_aligned = null
params.bam_unaligned = null
params.contig2classification = null
params.bin2classification = null
params.unclassified2classification = null
params.proteins = null
params.diamond_alignment = null
params.args = ""
params.outdir = "results"

workflow {
    reads_ch = Channel
        .fromFilePairs(params.reads, size: -1)
        .map { sample, reads -> [[id: sample, single_end: reads instanceof List ? reads.size() == 1 : true], reads] }
    contigs_ch = Channel
        .fromPath(params.contigs, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    database_ch = Channel
        .fromPath(params.database, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    taxonomy_ch = Channel
        .fromPath(params.taxonomy, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bins_ch = Channel
        .fromPath("${params.bins}/*", checkIfExists: true)
        .collect()
        .map { files -> [[id: 'input'], files] }
    bam_aligned_ch = Channel
        .fromPath(params.bam_aligned, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bam_unaligned_ch = Channel
        .fromPath(params.bam_unaligned, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    contig2classification_ch = Channel
        .fromPath(params.contig2classification, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bin2classification_ch = Channel
        .fromPath(params.bin2classification, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    unclassified2classification_ch = Channel
        .fromPath(params.unclassified2classification, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    proteins_ch = Channel
        .fromPath(params.proteins, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    diamond_alignment_ch = Channel
        .fromPath(params.diamond_alignment, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    CATPACK_READS(reads_ch, contigs_ch.first(), database_ch.first(), taxonomy_ch.first(), bins_ch.first(), params.mode, bam_aligned_ch.first(), bam_unaligned_ch.first(), contig2classification_ch.first(), bin2classification_ch.first(), unclassified2classification_ch.first(), proteins_ch.first(), diamond_alignment_ch.first())
}
