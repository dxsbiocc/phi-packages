#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { CATPACK_CONTIGS } from '../main.nf'

params.contigs = null
params.database = null
params.taxonomy = null
params.proteins = null
params.diamond_table = null
params.args = ""
params.outdir = "results"

workflow {
    contigs_ch = Channel
        .fromPath(params.contigs, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    database_ch = Channel
        .fromPath(params.database, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    taxonomy_ch = Channel
        .fromPath(params.taxonomy, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    proteins_ch = Channel
        .fromPath(params.proteins, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    diamond_table_ch = Channel
        .fromPath(params.diamond_table, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    CATPACK_CONTIGS(contigs_ch, database_ch.first(), taxonomy_ch.first(), proteins_ch.first(), diamond_table_ch.first())
}
