#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { WITTYER } from '../main.nf'

params.query_vcf = null
params.truth_vcf = null
params.bed = null
params.wittyer_config = null
params.args = ""
params.outdir = "results"

workflow {
    query_vcf_ch = Channel
        .fromPath(params.query_vcf, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    truth_vcf_ch = params.truth_vcf ? Channel.fromPath(params.truth_vcf, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    bed_ch = params.bed ? Channel.fromPath(params.bed, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    wittyer_config_ch = params.wittyer_config ? Channel.fromPath(params.wittyer_config, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    WITTYER(query_vcf_ch.combine(truth_vcf_ch).combine(bed_ch).combine(wittyer_config_ch))
}
