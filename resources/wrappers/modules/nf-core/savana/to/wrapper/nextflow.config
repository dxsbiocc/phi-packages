// Launcher config for the savana to wrapper adapter. Not part of the fixed
// wrapper/{main.nf,params.json,wrapper.yaml} contract — Nextflow picks this
// up automatically because it sits beside wrapper/main.nf.

process {
    cpus   = 8
    memory = '16.GB'
    time   = '8.h'

    withName: 'SAVANA_TO' {
        publishDir = [
            path: { "${params.outdir}/savana_to" },
            mode: 'copy',
            pattern: '{${prefix}.classified*.cna_rescue.vcf,${prefix}_read_counts_*_log2r_segmented.tsv,*kbp_bin_ref_*_${prefix}*.bed}'
        ]
        ext.args = { params.args ?: '' }
    }
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}
