#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SAVANA_TO } from '../main.nf'

params.tumour = null
params.tumour_index = null
params.snp_vcf = null
params.allele_counts_het_snps = null
params.breakpoints = null
params.ref = null
params.ref_index = null
params.contigs = null
params.blacklist = null
params.g1000_vcf = null
params.args = ""
params.outdir = "results"

workflow {
    tumour_ch = Channel
        .fromPath(params.tumour, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    tumour_index_ch = params.tumour_index ? Channel.fromPath(params.tumour_index, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    snp_vcf_ch = params.snp_vcf ? Channel.fromPath(params.snp_vcf, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    allele_counts_het_snps_ch = params.allele_counts_het_snps ? Channel.fromPath(params.allele_counts_het_snps, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    breakpoints_ch = params.breakpoints ? Channel.fromPath(params.breakpoints, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    ref_ch = Channel
        .fromPath(params.ref, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    ref_index_ch = params.ref_index ? Channel.fromPath(params.ref_index, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    contigs_ch = Channel
        .fromPath(params.contigs, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    blacklist_ch = Channel
        .fromPath(params.blacklist, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    SAVANA_TO(tumour_ch.combine(tumour_index_ch).combine(snp_vcf_ch).combine(allele_counts_het_snps_ch).combine(breakpoints_ch), ref_ch.combine(ref_index_ch).first(), contigs_ch.first(), blacklist_ch.first(), Channel.value([[id: 'input'], params.g1000_vcf]))
}
