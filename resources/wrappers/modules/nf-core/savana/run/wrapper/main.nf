#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SAVANA_RUN } from '../main.nf'

params.tumour = null
params.tumour_index = null
params.normal = null
params.normal_index = null
params.ref = null
params.ref_index = null
params.args = ""
params.outdir = "results"

workflow {
    tumour_ch = Channel
        .fromPath(params.tumour, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    tumour_index_ch = params.tumour_index ? Channel.fromPath(params.tumour_index, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    normal_ch = params.normal ? Channel.fromPath(params.normal, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    normal_index_ch = params.normal_index ? Channel.fromPath(params.normal_index, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    ref_ch = Channel
        .fromPath(params.ref, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    ref_index_ch = params.ref_index ? Channel.fromPath(params.ref_index, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    SAVANA_RUN(tumour_ch.combine(tumour_index_ch).combine(normal_ch).combine(normal_index_ch), ref_ch.combine(ref_index_ch).first())
}
