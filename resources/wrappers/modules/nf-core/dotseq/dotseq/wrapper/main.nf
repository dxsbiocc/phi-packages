#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { DOTSEQ_DOTSEQ } from '../main.nf'

params.contrast_variable = null
params.reference = null
params.target = null
params.samplesheet = null
params.counts = null
params.annotation = null
params.outdir = "results"

workflow {
    samplesheet_ch = Channel
        .fromPath(params.samplesheet, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    counts_ch = params.counts ? Channel.fromPath(params.counts, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    annotation_ch = params.annotation ? Channel.fromPath(params.annotation, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    DOTSEQ_DOTSEQ(Channel.value([[id: 'input'], params.contrast_variable, params.reference, params.target]), samplesheet_ch.combine(counts_ch).combine(annotation_ch).first())
}
