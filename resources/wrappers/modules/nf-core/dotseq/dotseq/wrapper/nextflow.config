// Launcher config for the dotseq dotseq wrapper adapter. Not part of the fixed
// wrapper/{main.nf,params.json,wrapper.yaml} contract — Nextflow picks this
// up automatically because it sits beside wrapper/main.nf.

process {
    cpus   = 4
    memory = '8.GB'
    time   = '4.h'

    withName: 'DOTSEQ_DOTSEQ' {
        publishDir = [
            path: { "${params.outdir}/dotseq_dotseq" },
            mode: 'copy',
            pattern: '{*.DOTSeqDataSets.rds,*.R_sessionInfo.log,*.composite.png,*.dou.dotseq.results.tsv,*.dou_strategy.dotseq.results.tsv,*.dte_strategy.dotseq.results.tsv,*.heatmap.png,*.interaction_p_distribution.png,*.translation.dotseq.results.tsv,*.venn.png,*.volcano.png}'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}
