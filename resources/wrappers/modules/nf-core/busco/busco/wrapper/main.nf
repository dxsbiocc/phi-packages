#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { BUSCO_BUSCO } from '../main.nf'

params.fasta = null
params.mode = null
params.lineage = null
params.busco_lineages_path = null
params.config_file = null
params.clean_intermediates = false
params.args = ""
params.outdir = "results"

workflow {
    fasta_ch = Channel
        .fromPath("${params.fasta}/*", checkIfExists: true)
        .collect()
        .map { files -> [[id: 'input'], files] }
    busco_lineages_path_ch = Channel.fromPath(params.busco_lineages_path, checkIfExists: true)
    config_file_ch = Channel.fromPath(params.config_file, checkIfExists: true)

    BUSCO_BUSCO(fasta_ch, params.mode, params.lineage, busco_lineages_path_ch, config_file_ch, params.clean_intermediates)
}
