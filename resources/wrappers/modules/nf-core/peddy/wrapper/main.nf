#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { PEDDY } from '../main.nf'

params.vcf = null
params.vcf_tbi = null
params.ped = null
params.sites = null
params.args = ""
params.outdir = "results"

workflow {
    vcf_ch = Channel
        .fromPath(params.vcf, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    vcf_tbi_ch = params.vcf_tbi ? Channel.fromPath(params.vcf_tbi, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    ped_ch = Channel
        .fromPath(params.ped, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    sites_ch = Channel
        .fromPath(params.sites, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    PEDDY(vcf_ch.combine(vcf_tbi_ch), ped_ch.first(), sites_ch.first())
}
