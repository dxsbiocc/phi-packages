#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { TINC } from '../main.nf'

params.cna_rds = null
params.vcf_rds = null
params.outdir = "results"

workflow {
    cna_rds_ch = Channel
        .fromPath(params.cna_rds, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    vcf_rds_ch = params.vcf_rds ? Channel.fromPath(params.vcf_rds, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    TINC(cna_rds_ch.combine(vcf_rds_ch))
}
