#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { POPSCLE_DEMUXLET } from '../main.nf'

params.bam = null
params.donor_genotype = null
params.plp_prefix = null
params.args = ""
params.outdir = "results"

workflow {
    bam_ch = Channel
        .fromPath(params.bam, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    donor_genotype_ch = params.donor_genotype ? Channel.fromPath(params.donor_genotype, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    POPSCLE_DEMUXLET(bam_ch.combine(donor_genotype_ch).map { t -> t + [params.plp_prefix] })
}
