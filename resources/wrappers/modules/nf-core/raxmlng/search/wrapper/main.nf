#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { RAXMLNG_SEARCH } from '../main.nf'

params.alignment = null
params.model = null
params.tree = null
params.tree_constraint = null
params.partitions = null
params.site_weights = null
params.args = ""
params.outdir = "results"

workflow {
    alignment_ch = Channel
        .fromPath(params.alignment, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    tree_ch = Channel.fromPath(params.tree, checkIfExists: true)
    tree_constraint_ch = Channel.fromPath(params.tree_constraint, checkIfExists: true)
    partitions_ch = Channel.fromPath(params.partitions, checkIfExists: true)
    site_weights_ch = Channel.fromPath(params.site_weights, checkIfExists: true)

    RAXMLNG_SEARCH(alignment_ch.map { t -> t + [params.model] }, tree_ch, tree_constraint_ch, partitions_ch, site_weights_ch)
}
