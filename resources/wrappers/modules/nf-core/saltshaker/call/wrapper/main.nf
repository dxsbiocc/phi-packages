#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SALTSHAKER_CALL } from '../main.nf'

params.breakpoint = null
params.cluster = null
params.mtfasta = null
params.flank = null
params.heteroplasmy_limit = null
params.mito_length = null
params.heavy_strand_origin_start = null
params.heavy_strand_origin_end = null
params.light_strand_origin_start = null
params.light_strand_origin_end = null
params.args = ""
params.outdir = "results"

workflow {
    breakpoint_ch = Channel
        .fromPath(params.breakpoint, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    cluster_ch = params.cluster ? Channel.fromPath(params.cluster, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    mtfasta_ch = Channel
        .fromPath(params.mtfasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    SALTSHAKER_CALL(breakpoint_ch.combine(cluster_ch), mtfasta_ch.first(), params.flank, params.heteroplasmy_limit, params.mito_length, params.heavy_strand_origin_start, params.heavy_strand_origin_end, params.light_strand_origin_start, params.light_strand_origin_end)
}
