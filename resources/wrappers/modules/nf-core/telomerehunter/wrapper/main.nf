#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { TELOMEREHUNTER } from '../main.nf'

params.tumor_bam = null
params.tumor_bai = null
params.control_bam = null
params.control_bai = null
params.fasta = null
params.fai = null
params.cytoband = null
params.args = ""
params.outdir = "results"

workflow {
    tumor_bam_ch = Channel
        .fromPath(params.tumor_bam, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    tumor_bai_ch = params.tumor_bai ? Channel.fromPath(params.tumor_bai, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    control_bam_ch = params.control_bam ? Channel.fromPath(params.control_bam, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    control_bai_ch = params.control_bai ? Channel.fromPath(params.control_bai, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fai_ch = params.fai ? Channel.fromPath(params.fai, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    cytoband_ch = params.cytoband ? Channel.fromPath(params.cytoband, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    TELOMEREHUNTER(tumor_bam_ch.combine(tumor_bai_ch).combine(control_bam_ch).combine(control_bai_ch), fasta_ch.combine(fai_ch).combine(cytoband_ch).first())
}
