#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SEXDETERRMINE } from '../main.nf'

params.depth = null
params.sample_list_file = null
params.args = ""
params.outdir = "results"

workflow {
    depth_ch = Channel
        .fromPath(params.depth, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    sample_list_file_ch = Channel.fromPath(params.sample_list_file, checkIfExists: true)

    SEXDETERRMINE(depth_ch, sample_list_file_ch)
}
