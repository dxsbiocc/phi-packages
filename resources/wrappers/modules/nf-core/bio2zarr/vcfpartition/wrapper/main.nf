#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { BIO2ZARR_VCFPARTITION } from '../main.nf'

params.vcf = null
params.index = null
params.args = ""
params.outdir = "results"

workflow {
    vcf_ch = Channel
        .fromPath(params.vcf, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    index_ch = params.index ? Channel.fromPath(params.index, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    BIO2ZARR_VCFPARTITION(vcf_ch.combine(index_ch))
}
