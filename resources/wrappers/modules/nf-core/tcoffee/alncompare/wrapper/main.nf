#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { TCOFFEE_ALNCOMPARE } from '../main.nf'

params.msa = null
params.ref_msa = null
params.args = ""
params.outdir = "results"

workflow {
    msa_ch = Channel
        .fromPath(params.msa, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    ref_msa_ch = params.ref_msa ? Channel.fromPath(params.ref_msa, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    TCOFFEE_ALNCOMPARE(msa_ch.combine(ref_msa_ch))
}
