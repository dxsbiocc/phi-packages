#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { TCOFFEE_REGRESSIVE } from '../main.nf'

params.fasta = null
params.tree = null
params.template = null
params.accessory_information = null
params.compress = false
params.args = ""
params.outdir = "results"

workflow {
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    tree_ch = Channel
        .fromPath(params.tree, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    template_ch = Channel
        .fromPath(params.template, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    accessory_information_ch = params.accessory_information ? Channel.fromPath(params.accessory_information, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    TCOFFEE_REGRESSIVE(fasta_ch, tree_ch.first(), template_ch.combine(accessory_information_ch).first(), params.compress)
}
