#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { TCOFFEE_IRMSD } from '../main.nf'

params.msa = null
params.template = null
params.structures = null
params.args = ""
params.outdir = "results"

workflow {
    msa_ch = Channel
        .fromPath(params.msa, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    template_ch = Channel
        .fromPath(params.template, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    structures_ch = params.structures ? Channel.fromPath(params.structures, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    TCOFFEE_IRMSD(msa_ch, template_ch.combine(structures_ch).first())
}
