#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { METACACHE_BUILD } from '../main.nf'

params.genome_files = null
params.taxonomy = null
params.seq2taxid = null
params.args = ""
params.outdir = "results"

workflow {
    genome_files_ch = Channel
        .fromPath("${params.genome_files}/*", checkIfExists: true)
        .collect()
        .map { files -> [[id: 'input'], files] }
    taxonomy_ch = Channel.fromPath("${params.taxonomy}/*", checkIfExists: true).collect()
    seq2taxid_ch = Channel.fromPath(params.seq2taxid, checkIfExists: true)

    METACACHE_BUILD(genome_files_ch, taxonomy_ch, seq2taxid_ch)
}
