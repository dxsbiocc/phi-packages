#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { GENRICH } from '../main.nf'

params.treatment_bam = null
params.control_bam = null
params.blacklist_bed = null
params.args = ""
params.outdir = "results"

workflow {
    treatment_bam_ch = Channel
        .fromPath(params.treatment_bam, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    control_bam_ch = params.control_bam ? Channel.fromPath(params.control_bam, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    blacklist_bed_ch = params.blacklist_bed ? Channel.fromPath(params.blacklist_bed, checkIfExists: true).first() : Channel.value([])

    GENRICH(treatment_bam_ch.combine(control_bam_ch), blacklist_bed_ch)
}
