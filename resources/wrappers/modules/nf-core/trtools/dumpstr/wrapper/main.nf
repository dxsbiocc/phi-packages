#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { TRTOOLS_DUMPSTR } from '../main.nf'

params.vcf = null
params.filter_regions = null
params.filter_regions_tbi = null
params.args = ""
params.outdir = "results"

workflow {
    vcf_ch = Channel
        .fromPath(params.vcf, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    filter_regions_ch = Channel
        .fromPath(params.filter_regions, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    filter_regions_tbi_ch = params.filter_regions_tbi ? Channel.fromPath(params.filter_regions_tbi, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    TRTOOLS_DUMPSTR(vcf_ch, filter_regions_ch.combine(filter_regions_tbi_ch).first())
}
