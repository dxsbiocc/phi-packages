#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { BIGSLICE_BIGSLICE } from '../main.nf'

params.bgc = null
params.s = null
params.hmmdb = null
params.export_tsv = false
params.args = ""
params.outdir = "results"

workflow {
    bgc_ch = Channel
        .fromPath(params.bgc, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    s_ch = params.s ? Channel.fromPath(params.s, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    hmmdb_ch = params.hmmdb ? Channel.fromPath(params.hmmdb, checkIfExists: true).first() : Channel.value([])

    BIGSLICE_BIGSLICE(bgc_ch.combine(s_ch), hmmdb_ch, params.export_tsv)
}
