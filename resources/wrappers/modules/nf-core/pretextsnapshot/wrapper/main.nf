#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { PRETEXTSNAPSHOT } from '../main.nf'

params.pretext_map = null
params.order_file = null
params.args = ""
params.outdir = "results"

workflow {
    pretext_map_ch = Channel
        .fromPath(params.pretext_map, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    order_file_ch = params.order_file ? Channel.fromPath(params.order_file, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    PRETEXTSNAPSHOT(pretext_map_ch.combine(order_file_ch))
}
