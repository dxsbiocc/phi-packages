#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { CENTRIFUGE_BUILD } from '../main.nf'

params.fasta = null
params.conversion_table = null
params.taxonomy_tree = null
params.name_table = null
params.size_table = null
params.args = ""
params.outdir = "results"

workflow {
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    conversion_table_ch = Channel.fromPath(params.conversion_table, checkIfExists: true)
    taxonomy_tree_ch = Channel.fromPath(params.taxonomy_tree, checkIfExists: true)
    name_table_ch = Channel.fromPath(params.name_table, checkIfExists: true)
    size_table_ch = Channel.fromPath(params.size_table, checkIfExists: true)

    CENTRIFUGE_BUILD(fasta_ch, conversion_table_ch, taxonomy_tree_ch, name_table_ch, size_table_ch)
}
