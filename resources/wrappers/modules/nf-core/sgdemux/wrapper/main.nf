#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SGDEMUX } from '../main.nf'

params.sample_sheet = null
params.fastqs_dir = null
params.args = ""
params.outdir = "results"

workflow {
    sample_sheet_ch = Channel
        .fromPath(params.sample_sheet, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fastqs_dir_ch = params.fastqs_dir ? Channel.fromPath(params.fastqs_dir, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    SGDEMUX(sample_sheet_ch.combine(fastqs_dir_ch))
}
