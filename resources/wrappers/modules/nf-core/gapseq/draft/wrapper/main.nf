#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { GAPSEQ_DRAFT } from '../main.nf'

params.reactions = null
params.transporters = null
params.pathways = null
params.args = ""
params.outdir = "results"

workflow {
    reactions_ch = Channel
        .fromPath(params.reactions, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    transporters_ch = params.transporters ? Channel.fromPath(params.transporters, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    pathways_ch = params.pathways ? Channel.fromPath(params.pathways, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    GAPSEQ_DRAFT(reactions_ch.combine(transporters_ch).combine(pathways_ch))
}
