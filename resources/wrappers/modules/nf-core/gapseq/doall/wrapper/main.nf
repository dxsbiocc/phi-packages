#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { GAPSEQ_DOALL } from '../main.nf'

params.fasta = null
params.medium = null
params.db = null
params.args = ""
params.outdir = "results"

workflow {
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    medium_ch = params.medium ? Channel.fromPath(params.medium, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    db_ch = params.db ? Channel.fromPath(params.db, checkIfExists: true).first() : Channel.value([])

    GAPSEQ_DOALL(fasta_ch.combine(medium_ch), db_ch)
}
