#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { GAPSEQ_MEDIUM } from '../main.nf'

params.draft = null
params.pathways = null
params.args = ""
params.outdir = "results"

workflow {
    draft_ch = Channel
        .fromPath(params.draft, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    pathways_ch = params.pathways ? Channel.fromPath(params.pathways, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    GAPSEQ_MEDIUM(draft_ch.combine(pathways_ch))
}
