#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SEQUENZAUTILS_BAM2SEQZ } from '../main.nf'

params.normalbam = null
params.tumourbam = null
params.fasta = null
params.wigfile = null
params.args = ""
params.outdir = "results"

workflow {
    normalbam_ch = Channel
        .fromPath(params.normalbam, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    tumourbam_ch = params.tumourbam ? Channel.fromPath(params.tumourbam, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_ch = params.fasta ? Channel.fromPath(params.fasta, checkIfExists: true).first() : Channel.value([])
    wigfile_ch = Channel.fromPath(params.wigfile, checkIfExists: true)

    SEQUENZAUTILS_BAM2SEQZ(normalbam_ch.combine(tumourbam_ch), fasta_ch, wigfile_ch)
}
