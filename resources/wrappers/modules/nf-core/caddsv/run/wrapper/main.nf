#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { CADDSV_RUN } from '../main.nf'

params.variants = null
params.annotations_dir = null
params.config = null
params.args = ""
params.outdir = "results"

workflow {
    variants_ch = Channel
        .fromPath(params.variants, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    annotations_dir_ch = Channel.fromPath(params.annotations_dir, checkIfExists: true)
    config_ch = Channel.fromPath(params.config, checkIfExists: true)

    CADDSV_RUN(variants_ch, annotations_dir_ch, config_ch)
}
