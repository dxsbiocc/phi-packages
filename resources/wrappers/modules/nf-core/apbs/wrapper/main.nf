#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { APBS } from '../main.nf'

params.apbs_input = null
params.pqr = null
params.args = ""
params.outdir = "results"

workflow {
    apbs_input_ch = Channel
        .fromPath(params.apbs_input, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    pqr_ch = params.pqr ? Channel.fromPath(params.pqr, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    APBS(apbs_input_ch.combine(pqr_ch))
}
