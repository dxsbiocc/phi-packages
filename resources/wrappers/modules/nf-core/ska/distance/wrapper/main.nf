#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SKA_DISTANCE } from '../main.nf'

params.sketch_files = null
params.sketch_list = null
params.args = ""
params.outdir = "results"

workflow {
    sketch_files_ch = Channel
        .fromPath(params.sketch_files, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    sketch_list_ch = params.sketch_list ? Channel.fromPath(params.sketch_list, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    SKA_DISTANCE(sketch_files_ch.combine(sketch_list_ch))
}
