#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SKA_FASTA } from '../main.nf'

params.fastas = null
params.fasta_list = null
params.args = ""
params.outdir = "results"

workflow {
    fastas_ch = Channel
        .fromPath(params.fastas, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fasta_list_ch = params.fasta_list ? Channel.fromPath(params.fasta_list, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    SKA_FASTA(fastas_ch.combine(fasta_list_ch))
}
