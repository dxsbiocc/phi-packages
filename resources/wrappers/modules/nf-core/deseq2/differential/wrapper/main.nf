#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { DESEQ2_DIFFERENTIAL } from '../main.nf'

params.contrast_variable = null
params.reference = null
params.target = null
params.formula = null
params.comparison = null
params.samplesheet = null
params.counts = null
params.control_genes_file = null
params.transcript_lengths_file = null
params.outdir = "results"

workflow {
    samplesheet_ch = Channel
        .fromPath(params.samplesheet, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    counts_ch = params.counts ? Channel.fromPath(params.counts, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    control_genes_file_ch = Channel
        .fromPath(params.control_genes_file, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    transcript_lengths_file_ch = Channel
        .fromPath(params.transcript_lengths_file, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    DESEQ2_DIFFERENTIAL(Channel.value([[id: 'input'], params.contrast_variable, params.reference, params.target, params.formula, params.comparison]), samplesheet_ch.combine(counts_ch).first(), control_genes_file_ch.first(), transcript_lengths_file_ch.first())
}
