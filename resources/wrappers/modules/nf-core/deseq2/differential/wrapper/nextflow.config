// Launcher config for the deseq2 differential wrapper adapter. Not part of the fixed
// wrapper/{main.nf,params.json,wrapper.yaml} contract — Nextflow picks this
// up automatically because it sits beside wrapper/main.nf.

process {
    cpus   = 1
    memory = '2.GB'
    time   = '1.h'

    withName: 'DESEQ2_DIFFERENTIAL' {
        publishDir = [
            path: { "${params.outdir}/deseq2_differential" },
            mode: 'copy',
            pattern: '{*.R_sessionInfo.log,*.dds.rld.rds,*.deseq2.dispersion.pdf,*.deseq2.dispersion.png,*.deseq2.model.txt,*.deseq2.results.tsv,*.deseq2.sizefactors.tsv,*.normalised_counts.tsv,*.rlog.tsv,*.vst.tsv}'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}
