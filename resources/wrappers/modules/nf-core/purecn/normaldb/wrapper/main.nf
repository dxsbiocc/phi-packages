#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { PURECN_NORMALDB } from '../main.nf'

params.coverage_files = null
params.normal_vcf = null
params.normal_vcf_tbi = null
params.genome = null
params.assay = null
params.args = ""
params.outdir = "results"

workflow {
    coverage_files_ch = Channel
        .fromPath(params.coverage_files, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    normal_vcf_ch = params.normal_vcf ? Channel.fromPath(params.normal_vcf, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    normal_vcf_tbi_ch = params.normal_vcf_tbi ? Channel.fromPath(params.normal_vcf_tbi, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    PURECN_NORMALDB(coverage_files_ch.combine(normal_vcf_ch).combine(normal_vcf_tbi_ch), params.genome, params.assay)
}
