#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { PURECN_RUN } from '../main.nf'

params.intervals = null
params.coverage = null
params.vcf = null
params.normal_db = null
params.mapping_bias = null
params.genome = null
params.args = ""
params.outdir = "results"

workflow {
    intervals_ch = Channel
        .fromPath(params.intervals, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    coverage_ch = params.coverage ? Channel.fromPath(params.coverage, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    vcf_ch = params.vcf ? Channel.fromPath(params.vcf, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    normal_db_ch = params.normal_db ? Channel.fromPath(params.normal_db, checkIfExists: true).first() : Channel.value([])
    mapping_bias_ch = Channel.fromPath(params.mapping_bias, checkIfExists: true)

    PURECN_RUN(intervals_ch.combine(coverage_ch).combine(vcf_ch), normal_db_ch, mapping_bias_ch, params.genome)
}
