#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { EAGLE2 } from '../main.nf'

params.input = null
params.index = null
params.ref_vcf = null
params.ref_index = null
params.map = null
params.args = ""
params.outdir = "results"

workflow {
    input_ch = Channel
        .fromPath(params.input, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    index_ch = params.index ? Channel.fromPath(params.index, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    ref_vcf_ch = params.ref_vcf ? Channel.fromPath(params.ref_vcf, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    ref_index_ch = params.ref_index ? Channel.fromPath(params.ref_index, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    map_ch = params.map ? Channel.fromPath(params.map, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    EAGLE2(input_ch.combine(index_ch).combine(ref_vcf_ch).combine(ref_index_ch).combine(map_ch))
}
