#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { TETRANSCRIPTS } from '../main.nf'

params.bam_t = null
params.bam_c = null
params.g_gtf = null
params.te_gtf = null
params.args = ""
params.outdir = "results"

workflow {
    bam_t_ch = Channel
        .fromPath(params.bam_t, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bam_c_ch = Channel
        .fromPath(params.bam_c, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    g_gtf_ch = Channel
        .fromPath(params.g_gtf, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    te_gtf_ch = Channel
        .fromPath(params.te_gtf, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    TETRANSCRIPTS(bam_t_ch, bam_c_ch.first(), g_gtf_ch.first(), te_gtf_ch.first())
}
