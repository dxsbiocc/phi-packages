#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SAGEPROTEOMICS_SAGE } from '../main.nf'

params.mz_m_l = null
params.fasta_proteome = null
params.base_config = null
params.outdir = "results"

workflow {
    mz_m_l_ch = Channel
        .fromPath(params.mz_m_l, checkIfExists: true)
        .collect()
        .map { files -> [[id: 'input'], files] }
    fasta_proteome_ch = Channel
        .fromPath(params.fasta_proteome, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    base_config_ch = Channel
        .fromPath(params.base_config, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    SAGEPROTEOMICS_SAGE(mz_m_l_ch, fasta_proteome_ch.first(), base_config_ch.first())
}
