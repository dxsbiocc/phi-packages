#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { ORTHOFINDER } from '../main.nf'

params.fastas = null
params.prior_run = null
params.args = ""
params.outdir = "results"

workflow {
    fastas_ch = Channel
        .fromPath("${params.fastas}/*", checkIfExists: true)
        .collect()
        .map { files -> [[id: 'input'], files] }
    prior_run_ch = Channel
        .fromPath(params.prior_run, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    ORTHOFINDER(fastas_ch, prior_run_ch.first())
}
