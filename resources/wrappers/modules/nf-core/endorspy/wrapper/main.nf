#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { ENDORSPY } from '../main.nf'

params.stats_raw = null
params.stats_qualityfiltered = null
params.stats_deduplicated = null
params.args = ""
params.outdir = "results"

workflow {
    stats_raw_ch = Channel
        .fromPath(params.stats_raw, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    stats_qualityfiltered_ch = params.stats_qualityfiltered ? Channel.fromPath(params.stats_qualityfiltered, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    stats_deduplicated_ch = params.stats_deduplicated ? Channel.fromPath(params.stats_deduplicated, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    ENDORSPY(stats_raw_ch.combine(stats_qualityfiltered_ch).combine(stats_deduplicated_ch))
}
