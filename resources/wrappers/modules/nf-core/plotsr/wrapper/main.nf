#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { PLOTSR } from '../main.nf'

params.syri = null
params.fastas = null
params.genomes = null
params.bedpe = null
params.markers = null
params.tracks = null
params.chrord = null
params.chrname = null
params.args = ""
params.outdir = "results"

workflow {
    syri_ch = Channel
        .fromPath(params.syri, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fastas_ch = Channel
        .fromPath(params.fastas, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    genomes_ch = Channel
        .fromPath(params.genomes, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bedpe_ch = Channel
        .fromPath(params.bedpe, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    markers_ch = Channel
        .fromPath(params.markers, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    tracks_ch = Channel
        .fromPath(params.tracks, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    chrord_ch = Channel
        .fromPath(params.chrord, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    chrname_ch = Channel
        .fromPath(params.chrname, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    PLOTSR(syri_ch, fastas_ch.first(), genomes_ch.first(), bedpe_ch.first(), markers_ch.first(), tracks_ch.first(), chrord_ch.first(), chrname_ch.first())
}
