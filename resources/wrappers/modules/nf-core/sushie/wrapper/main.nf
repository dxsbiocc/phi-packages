#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SUSHIE } from '../main.nf'

params.study_locus_files = null
params.ld_files = null
params.sample_sizes = null
params.args = ""
params.outdir = "results"

workflow {
    study_locus_files_ch = Channel
        .fromPath(params.study_locus_files, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    ld_files_ch = Channel.fromPath(params.ld_files, checkIfExists: true)

    SUSHIE(study_locus_files_ch, ld_files_ch, params.sample_sizes)
}
