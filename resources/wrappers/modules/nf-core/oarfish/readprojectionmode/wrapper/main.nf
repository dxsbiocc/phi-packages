#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { OARFISH_READPROJECTIONMODE } from '../main.nf'

params.reads = null
params.seq_tech = null
params.fasta = null
params.annotation = null
params.args = ""
params.outdir = "results"

workflow {
    reads_ch = Channel
        .fromFilePairs(params.reads, size: -1)
        .map { sample, reads -> [[id: sample, single_end: reads instanceof List ? reads.size() == 1 : true], reads] }
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    annotation_ch = Channel
        .fromPath(params.annotation, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    OARFISH_READPROJECTIONMODE(reads_ch.map { t -> t + [params.seq_tech] }, fasta_ch.first(), annotation_ch.first())
}
