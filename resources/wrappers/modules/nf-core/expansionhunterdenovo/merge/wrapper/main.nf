#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { EXPANSIONHUNTERDENOVO_MERGE } from '../main.nf'

params.manifest = null
params.fasta = null
params.fasta_fai = null
params.args = ""
params.outdir = "results"

workflow {
    manifest_ch = Channel
        .fromPath(params.manifest, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fasta_fai_ch = params.fasta_fai ? Channel.fromPath(params.fasta_fai, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    EXPANSIONHUNTERDENOVO_MERGE(manifest_ch, fasta_ch.combine(fasta_fai_ch).first())
}
