#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { EXPANSIONHUNTERDENOVO_PROFILE } from '../main.nf'

params.alignment_file = null
params.alignment_index = null
params.fasta = null
params.fasta_fai = null
params.args = ""
params.outdir = "results"

workflow {
    alignment_file_ch = Channel
        .fromPath(params.alignment_file, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    alignment_index_ch = params.alignment_index ? Channel.fromPath(params.alignment_index, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fasta_fai_ch = params.fasta_fai ? Channel.fromPath(params.fasta_fai, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    EXPANSIONHUNTERDENOVO_PROFILE(alignment_file_ch.combine(alignment_index_ch), fasta_ch.combine(fasta_fai_ch).first())
}
