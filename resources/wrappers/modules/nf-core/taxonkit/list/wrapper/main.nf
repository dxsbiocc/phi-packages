#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { TAXONKIT_LIST } from '../main.nf'

params.taxidfile = null
params.taxid = null
params.taxdb = null
params.args = ""
params.outdir = "results"

workflow {
    taxidfile_ch = Channel
        .fromPath(params.taxidfile, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    taxdb_ch = params.taxdb ? Channel.fromPath(params.taxdb, checkIfExists: true).first() : Channel.value([])

    TAXONKIT_LIST(taxidfile_ch.map { t -> t + [params.taxid] }, taxdb_ch)
}
