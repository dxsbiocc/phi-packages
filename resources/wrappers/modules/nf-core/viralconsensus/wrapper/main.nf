#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { VIRALCONSENSUS } from '../main.nf'

params.bam = null
params.fasta = null
params.primer_bed = null
params.save_pos_counts = false
params.save_ins_counts = false
params.args = ""
params.outdir = "results"

workflow {
    bam_ch = Channel
        .fromPath(params.bam, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    primer_bed_ch = params.primer_bed ? Channel.fromPath(params.primer_bed, checkIfExists: true).first() : Channel.value([])

    VIRALCONSENSUS(bam_ch, fasta_ch.first(), primer_bed_ch, params.save_pos_counts, params.save_ins_counts)
}
