#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { MGNIFAM_GENERATEFAMILIES } from '../main.nf'

params.clustering = null
params.fasta_file = null
params.fasta_index = null
params.args = ""
params.outdir = "results"

workflow {
    clustering_ch = Channel
        .fromPath(params.clustering, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fasta_file_ch = params.fasta_file ? Channel.fromPath(params.fasta_file, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_index_ch = params.fasta_index ? Channel.fromPath(params.fasta_index, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    MGNIFAM_GENERATEFAMILIES(clustering_ch.combine(fasta_file_ch).combine(fasta_index_ch))
}
