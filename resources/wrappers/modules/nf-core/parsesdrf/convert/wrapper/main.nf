#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { PARSESDRF_CONVERT } from '../main.nf'

params.sdrf = null
params.fasta = null
params.raw_folder = null
params.format = null
params.args = ""
params.outdir = "results"

workflow {
    sdrf_ch = Channel
        .fromPath(params.sdrf, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fasta_ch = params.fasta ? Channel.fromPath(params.fasta, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    PARSESDRF_CONVERT(sdrf_ch.combine(fasta_ch).map { t -> t + [params.raw_folder] }, params.format)
}
