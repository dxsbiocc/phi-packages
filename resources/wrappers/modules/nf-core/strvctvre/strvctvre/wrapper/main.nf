#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { STRVCTVRE_STRVCTVRE } from '../main.nf'

params.sv_file = null
params.sv_file_index = null
params.assembly = null
params.phylop = null
params.data_directory = null
params.outdir = "results"

workflow {
    sv_file_ch = Channel
        .fromPath(params.sv_file, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    sv_file_index_ch = params.sv_file_index ? Channel.fromPath(params.sv_file_index, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    phylop_ch = Channel
        .fromPath(params.phylop, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    data_directory_ch = Channel
        .fromPath(params.data_directory, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    STRVCTVRE_STRVCTVRE(sv_file_ch.combine(sv_file_index_ch).map { t -> t + [params.assembly] }, phylop_ch.first(), data_directory_ch.first())
}
