#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SOURMASH_PAIRWISE } from '../main.nf'

params.signatures = null
params.file_list = null
params.args = ""
params.outdir = "results"

workflow {
    signatures_ch = Channel
        .fromPath(params.signatures, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    file_list_ch = Channel.fromPath(params.file_list, checkIfExists: true)

    SOURMASH_PAIRWISE(signatures_ch, file_list_ch)
}
