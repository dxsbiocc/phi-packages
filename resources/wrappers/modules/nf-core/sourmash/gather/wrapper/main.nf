#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SOURMASH_GATHER } from '../main.nf'

params.signature = null
params.database = null
params.save_unassigned = false
params.save_matches_sig = false
params.save_prefetch = false
params.save_prefetch_csv = false
params.args = ""
params.outdir = "results"

workflow {
    signature_ch = Channel
        .fromPath(params.signature, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    database_ch = params.database ? Channel.fromPath(params.database, checkIfExists: true).first() : Channel.value([])

    SOURMASH_GATHER(signature_ch, database_ch, params.save_unassigned, params.save_matches_sig, params.save_prefetch, params.save_prefetch_csv)
}
