#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { CHECKQC } from '../main.nf'

params.run_dir = null
params.checkqc_config = null
params.args = ""
params.outdir = "results"

workflow {
    run_dir_ch = Channel
        .fromPath(params.run_dir, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    checkqc_config_ch = Channel.fromPath(params.checkqc_config, checkIfExists: true)

    CHECKQC(run_dir_ch, checkqc_config_ch)
}
