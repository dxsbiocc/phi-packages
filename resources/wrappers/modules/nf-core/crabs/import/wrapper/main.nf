#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { CRABS_IMPORT } from '../main.nf'

params.fasta = null
params.accession2taxid = null
params.names = null
params.nodes = null
params.import_format = null
params.args = ""
params.outdir = "results"

workflow {
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    accession2taxid_ch = Channel
        .fromPath(params.accession2taxid, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    names_ch = Channel
        .fromPath(params.names, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    nodes_ch = Channel
        .fromPath(params.nodes, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    CRABS_IMPORT(fasta_ch, accession2taxid_ch.first(), names_ch.first(), nodes_ch.first(), params.import_format)
}
