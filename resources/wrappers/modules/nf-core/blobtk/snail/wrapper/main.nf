#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { BLOBTK_SNAIL } from '../main.nf'

params.fasta = null
params.full_table = null
params.blob_dir = null
params.format = null
params.args = ""
params.outdir = "results"

workflow {
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    full_table_ch = params.full_table ? Channel.fromPath(params.full_table, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    blob_dir_ch = Channel
        .fromPath(params.blob_dir, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    BLOBTK_SNAIL(fasta_ch.combine(full_table_ch), blob_dir_ch.first(), params.format)
}
