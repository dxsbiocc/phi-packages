#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { BLOBTK_PLOT } from '../main.nf'

params.fasta = null
params.local_path = null
params.online_path = null
params.extra_args = null
params.format = null
params.args = ""
params.outdir = "results"

workflow {
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    local_path_ch = Channel.fromPath(params.local_path, checkIfExists: true)

    BLOBTK_PLOT(fasta_ch, local_path_ch, params.online_path, params.extra_args, params.format)
}
