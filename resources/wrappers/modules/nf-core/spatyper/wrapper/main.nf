#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored module at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { SPATYPER } from '../main.nf'

params.fasta = null
params.repeats = null
params.repeat_order = null
params.args = ""
params.outdir = "results"

workflow {
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    repeats_ch = Channel.fromPath(params.repeats, checkIfExists: true)
    repeat_order_ch = Channel.fromPath(params.repeat_order, checkIfExists: true)

    SPATYPER(fasta_ch, repeats_ch, repeat_order_ch)
}
