// Launcher config for the DESeq2 differential-expression wrapper adapter.
// Not part of the fixed wrapper/{main.nf,params.json,wrapper.yaml} contract —
// Nextflow picks this up automatically because it sits beside wrapper/main.nf.
//
// No docker/singularity registry override needed: ../main.nf already
// declares a fully-qualified Wave container ref, matching bioconductor-deseq2
// + bioconductor-limma at the exact versions pinned in ../environment.yml.
//
// sample_id_col/gene_id_col/padj_threshold/log2fc_threshold are read by the
// ext.args closure below, which Nextflow evaluates before wrapper/main.nf's
// own `params.x = default` lines run — so they must also be defaulted here
// (see create-wrapper skill).
params.sample_id_col = 'sample'
params.gene_id_col   = 'gene_id'
params.padj_threshold = 0.05
params.log2fc_threshold = 1

process {
    cpus   = 2
    memory = '4.GB'
    time   = '30.min'

    withName: 'DESEQ2_DIFFERENTIAL' {
        ext.args = {
            // alpha is DESeq2's independent-filtering target and the post-hoc padj cutoff.
            // log2fc_threshold is the post-hoc |log2FoldChange| cutoff, applied in the same process.
            "--sample_id_col ${params.sample_id_col} --gene_id_col ${params.gene_id_col} --alpha ${params.padj_threshold} --log2fc_threshold ${params.log2fc_threshold}"
        }
        publishDir = [
            path: { "${params.outdir}/deseq2_differential" },
            mode: 'copy'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        // Run as the calling user, as nf-core does: root-owned outputs and temp dirs
        // (e.g. STAR's 700-mode _STARgenome) otherwise break output collection on Linux.
        docker.runOptions = '-u $(id -u):$(id -g)'
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}
