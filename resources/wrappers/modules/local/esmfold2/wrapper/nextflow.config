process {
    cpus   = 4
    memory = '32.GB'
    time   = '6.h'

    withName: 'ESMFOLD2' {
        accelerator = 1
        publishDir = [
            path: { "${params.outdir}/esmfold2" },
            mode: 'copy'
        ]
        ext.args = { params.args ?: '' }
    }
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '--gpus all -u $(id -u):$(id -g)'
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.runOptions = '--nv'
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}
