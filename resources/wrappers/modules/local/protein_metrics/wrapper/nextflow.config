process {
    cpus   = 2
    memory = '4.GB'
    time   = '2.h'

    withName: 'PROTEIN_METRICS' {
        publishDir = [
            path: { "${params.outdir}/protein_metrics" },
            mode: 'copy'
        ]
        ext.args = { params.args ?: '' }
    }
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}
