process {
    cpus   = 4
    memory = '16.GB'
    time   = '8.h'

    withName: '.*RFD3' {
        accelerator = 1
        memory = '32.GB'
        publishDir = [
            path: { "${params.outdir}/01_rfd3" },
            mode: 'copy'
        ]
    }

    withName: '.*LIGANDMPNN' {
        accelerator = 1
        memory = '16.GB'
        publishDir = [
            path: { "${params.outdir}/02_ligandmpnn" },
            mode: 'copy'
        ]
    }

    withName: '.*BOLTZ2' {
        accelerator = 1
        memory = '32.GB'
        publishDir = [
            path: { "${params.outdir}/03_boltz2" },
            mode: 'copy'
        ]
    }

    withName: '.*ALPHAFOLD3' {
        accelerator = 1
        cpus   = 8
        memory = '64.GB'
        time   = '12.h'
        publishDir = [
            path: { "${params.outdir}/03_alphafold3" },
            mode: 'copy'
        ]
    }

    withName: '.*PROTEIN_METRICS' {
        cpus   = 2
        memory = '4.GB'
        time   = '2.h'
        publishDir = [
            path: { "${params.outdir}/04_metrics" },
            mode: 'copy'
        ]
    }

    withName: '.*DESIGN_FILTER' {
        cpus   = 2
        memory = '4.GB'
        time   = '1.h'
        publishDir = [
            path: { "${params.outdir}/05_selected" },
            mode: 'copy'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '--gpus all -u $(id -u):$(id -g)'
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.runOptions = '--nv'
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}
