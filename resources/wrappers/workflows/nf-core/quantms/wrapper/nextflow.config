// Launcher config: pull in the real pipeline config (profiles, resource
// labels, containers). includeConfig resolves its own relative includes
// against ../, not this file. Generated by scripts/vendor-pipelines.py.
includeConfig '../nextflow.config'

// Conservative caps so a smoke run fits a laptop; remove for production.
process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '4.h'
    ]
}
