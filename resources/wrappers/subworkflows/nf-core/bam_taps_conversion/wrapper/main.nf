#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored subworkflow at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { BAM_TAPS_CONVERSION } from '../main.nf'

params.bam = null
params.bai = null
params.fa = null
params.fa_fai = null
params.outdir = "results"

workflow {
    bam_ch = Channel
        .fromPath(params.bam, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bai_ch = Channel
        .fromPath(params.bai, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fa_ch = Channel
        .fromPath(params.fa, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fa_fai_ch = Channel
        .fromPath(params.fa_fai, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    BAM_TAPS_CONVERSION(bam_ch, bai_ch, fa_ch, fa_fai_ch)
}
