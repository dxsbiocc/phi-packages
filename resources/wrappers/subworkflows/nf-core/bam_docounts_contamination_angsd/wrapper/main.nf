#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored subworkflow at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { BAM_DOCOUNTS_CONTAMINATION_ANGSD } from '../main.nf'

params.bam = null
params.bai = null
params.hapmap_file = null
params.outdir = "results"

workflow {
    bam_ch = Channel
        .fromPath(params.bam, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bai_ch = params.bai ? Channel.fromPath(params.bai, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    hapmap_file_ch = Channel
        .fromPath(params.hapmap_file, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    BAM_DOCOUNTS_CONTAMINATION_ANGSD(bam_ch.combine(bai_ch), hapmap_file_ch)
}
