#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored subworkflow at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { BAM_QC_PICARD } from '../main.nf'

params.bam = null
params.bai = null
params.bait_interval = null
params.target_interval = null
params.fasta = null
params.fasta_fai = null
params.fasta_dict = null
params.fasta_gzi = null
params.outdir = "results"

workflow {
    bam_ch = Channel
        .fromPath(params.bam, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bai_ch = params.bai ? Channel.fromPath(params.bai, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    bait_interval_ch = params.bait_interval ? Channel.fromPath(params.bait_interval, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    target_interval_ch = params.target_interval ? Channel.fromPath(params.target_interval, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fasta_fai_ch = Channel
        .fromPath(params.fasta_fai, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fasta_dict_ch = Channel
        .fromPath(params.fasta_dict, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fasta_gzi_ch = Channel
        .fromPath(params.fasta_gzi, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    BAM_QC_PICARD(bam_ch.combine(bai_ch).combine(bait_interval_ch).combine(target_interval_ch), fasta_ch, fasta_fai_ch, fasta_dict_ch, fasta_gzi_ch)
}
