#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored subworkflow at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { FASTQ_ALIGN_BOWTIE2 } from '../main.nf'

params.reads = null
params.index = null
params.save_unaligned = false
params.sort_bam = null
params.fasta = null
params.fai = null
params.outdir = "results"

workflow {
    reads_ch = Channel
        .fromPath(params.reads, checkIfExists: true)
        .map { f -> [[id: f.simpleName, single_end: true], f] }
    index_ch = Channel
        .fromPath(params.index, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fai_ch = params.fai ? Channel.fromPath(params.fai, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    FASTQ_ALIGN_BOWTIE2(reads_ch, index_ch.first(), params.save_unaligned, params.sort_bam, fasta_ch.combine(fai_ch))
}
