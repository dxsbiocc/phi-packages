#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored subworkflow at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { FASTQ_ALIGN_MAPAD } from '../main.nf'

params.reads = null
params.index = null
params.fasta = null
params.fai = null
params.mismatch_parameter = null
params.double_stranded_library = null
params.five_prime_overhang = null
params.three_prime_overhang = null
params.deam_rate_double_stranded = null
params.deam_rate_single_stranded = null
params.indel_rate = null
params.outdir = "results"

workflow {
    reads_ch = Channel
        .fromPath(params.reads, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    index_ch = Channel
        .fromPath(params.index, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fai_ch = params.fai ? Channel.fromPath(params.fai, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    FASTQ_ALIGN_MAPAD(reads_ch, index_ch, fasta_ch.combine(fai_ch), params.mismatch_parameter, params.double_stranded_library, params.five_prime_overhang, params.three_prime_overhang, params.deam_rate_double_stranded, params.deam_rate_single_stranded, params.indel_rate)
}
