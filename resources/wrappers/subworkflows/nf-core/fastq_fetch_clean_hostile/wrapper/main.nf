#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored subworkflow at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { FASTQ_FETCH_CLEAN_HOSTILE } from '../main.nf'

params.fastq = null
params.reference_dir = null
params.reference_name = null
params.index_name = null
params.outdir = "results"

workflow {
    fastq_ch = Channel
        .fromPath(params.fastq, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    reference_dir_ch = Channel
        .fromPath(params.reference_dir, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    FASTQ_FETCH_CLEAN_HOSTILE(fastq_ch, reference_dir_ch.map { t -> t + [params.reference_name] }, params.index_name)
}
