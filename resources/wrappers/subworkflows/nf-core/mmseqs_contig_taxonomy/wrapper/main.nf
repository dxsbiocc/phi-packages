#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored subworkflow at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { MMSEQS_CONTIG_TAXONOMY } from '../main.nf'

params.fasta = null
params.mmseqsdb = null
params.mmseqs2_db_id = null
params.outdir = "results"

workflow {
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    mmseqsdb_ch = Channel
        .fromPath(params.mmseqsdb, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    mmseqs2_db_id_ch = Channel
        .fromPath(params.mmseqs2_db_id, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    MMSEQS_CONTIG_TAXONOMY(fasta_ch, mmseqsdb_ch, mmseqs2_db_id_ch)
}
