#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored subworkflow at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { MMSEQS_CONTIG_TAXONOMY } from '../main.nf'

params.fasta = null
params.mmseqsdb = null
params.mmseqs2_db_id = null
params.outdir = "results"

workflow {
    contigs_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    mmseqsdb_ch = params.mmseqsdb ? Channel.fromPath(params.mmseqsdb, checkIfExists: true) : Channel.empty()
    db_id_ch = Channel.value(params.mmseqs2_db_id)

    MMSEQS_CONTIG_TAXONOMY(contigs_ch, mmseqsdb_ch, db_id_ch)
}
