#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored subworkflow at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { FASTA_CLASSIFY_CATPACK } from '../main.nf'

params.fasta = null
params.fasta_2 = null
params.db = null
params.db_id = null
params.run_summarise = null
params.bin_suffix = null
params.outdir = "results"

workflow {
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fasta_2_ch = Channel
        .fromPath(params.fasta_2, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    db_ch = Channel
        .fromPath(params.db, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    FASTA_CLASSIFY_CATPACK(fasta_ch, fasta_2_ch, db_ch, params.db_id, params.run_summarise, params.bin_suffix)
}
