#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored subworkflow at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { BAM_CNV_WISECONDORX } from '../main.nf'

params.bam = null
params.bai = null
params.fasta = null
params.fai = null
params.reference = null
params.blacklist = null
params.outdir = "results"

workflow {
    bam_ch = Channel
        .fromPath(params.bam, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bai_ch = params.bai ? Channel.fromPath(params.bai, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fai_ch = Channel
        .fromPath(params.fai, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    reference_ch = Channel
        .fromPath(params.reference, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    blacklist_ch = Channel
        .fromPath(params.blacklist, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    BAM_CNV_WISECONDORX(bam_ch.combine(bai_ch), fasta_ch.first(), fai_ch.first(), reference_ch.first(), blacklist_ch.first())
}
