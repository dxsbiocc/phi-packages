#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored subworkflow at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { BED_SCATTER_BEDTOOLS } from '../main.nf'

params.bed = null
params.scatter_count = null
params.outdir = "results"

workflow {
    bed_ch = Channel
        .fromPath(params.bed, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    BED_SCATTER_BEDTOOLS(bed_ch.map { t -> t + [params.scatter_count] })
}
