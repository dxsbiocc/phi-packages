#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored subworkflow at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { FASTQ_FIND_MIRNA_MIRDEEP2 } from '../main.nf'

params.fastq = null
params.genome_fasta = null
params.index = null
params.mature_mirna = null
params.hairpin_mirna = null
params.outdir = "results"

workflow {
    fastq_ch = Channel
        .fromPath(params.fastq, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    genome_fasta_ch = Channel
        .fromPath(params.genome_fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    index_ch = Channel
        .fromPath(params.index, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    mature_mirna_ch = Channel
        .fromPath(params.mature_mirna, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    hairpin_mirna_ch = params.hairpin_mirna ? Channel.fromPath(params.hairpin_mirna, checkIfExists: true).map { f -> [f] } : Channel.value([[]])

    FASTQ_FIND_MIRNA_MIRDEEP2(fastq_ch, genome_fasta_ch, index_ch, mature_mirna_ch.combine(hairpin_mirna_ch))
}
