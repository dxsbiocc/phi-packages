#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored subworkflow at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { FASTA_BUILD_ADD_KRAKEN2 } from '../main.nf'

params.fasta = null
params.names_dmp = null
params.nodes_dmp = null
params.acc2taxidfile = null
params.val_cleanintermediate = null
params.seqid2taxidfile = null
params.outdir = "results"

workflow {
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    names_dmp_ch = Channel
        .fromPath(params.names_dmp, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    nodes_dmp_ch = Channel
        .fromPath(params.nodes_dmp, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    acc2taxidfile_ch = Channel
        .fromPath(params.acc2taxidfile, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    val_cleanintermediate_ch = Channel
        .fromPath(params.val_cleanintermediate, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    seqid2taxidfile_ch = Channel
        .fromPath(params.seqid2taxidfile, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    FASTA_BUILD_ADD_KRAKEN2(fasta_ch, names_dmp_ch, nodes_dmp_ch, acc2taxidfile_ch, val_cleanintermediate_ch, seqid2taxidfile_ch)
}
