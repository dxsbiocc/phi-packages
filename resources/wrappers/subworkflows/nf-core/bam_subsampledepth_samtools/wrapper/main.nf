#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored subworkflow at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { BAM_SUBSAMPLEDEPTH_SAMTOOLS } from '../main.nf'

params.bam = null
params.bai = null
params.depth = null
params.fasta = null
params.fai = null
params.region = null
params.outdir = "results"

workflow {
    bam_ch = Channel
        .fromPath(params.bam, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    bai_ch = params.bai ? Channel.fromPath(params.bai, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fai_ch = params.fai ? Channel.fromPath(params.fai, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    depth_ch = Channel.of([[:], params.depth])
    region_ch = params.region ? Channel.fromPath(params.region, checkIfExists: true).map { f -> [[id: 'regions'], f] } : Channel.value([[id: 'regions'], []])

    BAM_SUBSAMPLEDEPTH_SAMTOOLS(bam_ch.combine(bai_ch), depth_ch, fasta_ch.combine(fai_ch), region_ch)
}
