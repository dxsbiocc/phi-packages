#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored subworkflow at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { BAM_STATS_MIRNA_MIRTOP } from '../main.nf'

params.bam = null
params.hairpin = null
params.gtf = null
params.species = null
params.outdir = "results"

workflow {
    bam_ch = Channel
        .fromPath(params.bam, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    hairpin_ch = Channel
        .fromPath(params.hairpin, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    gtf_ch = Channel
        .fromPath(params.gtf, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }

    BAM_STATS_MIRNA_MIRTOP(bam_ch, hairpin_ch, gtf_ch.map { t -> t + [params.species] })
}
