// Launcher config for the bam_telomere_estimation subworkflow wrapper adapter. Not part of the
// fixed wrapper/{main.nf,params.json,wrapper.yaml} contract — Nextflow picks
// this up automatically because it sits beside wrapper/main.nf.
//
// Global publishDir collects every nested module's outputs into one results
// directory (matches the generated subworkflow wrappers).

process {
    cpus   = 2
    memory = '4.GB'
    time   = '2.h'

    publishDir = [
        path: { "${params.outdir}/bam_telomere_estimation" },
        mode: 'copy'
    ]
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}
