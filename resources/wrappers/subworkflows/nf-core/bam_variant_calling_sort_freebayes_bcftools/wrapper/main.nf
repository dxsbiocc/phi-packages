#!/usr/bin/env nextflow
// Thin agent-facing adapter over the vendored subworkflow at ../main.nf.
// See docs/contracts/wrapper.md. Generated by scripts/generate-wrappers.py;
// review flagged semantics before publishing.
nextflow.enable.dsl = 2

include { BAM_VARIANT_CALLING_SORT_FREEBAYES_BCFTOOLS } from '../main.nf'

params.input1 = null
params.index1 = null
params.input2 = null
params.index2 = null
params.bed = null
params.fasta = null
params.fai = null
params.samples = null
params.populations = null
params.cnv = null
params.outdir = "results"

workflow {
    input1_ch = Channel
        .fromPath(params.input1, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    index1_ch = params.index1 ? Channel.fromPath(params.index1, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    input2_ch = params.input2 ? Channel.fromPath(params.input2, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    index2_ch = params.index2 ? Channel.fromPath(params.index2, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    bed_ch = params.bed ? Channel.fromPath(params.bed, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    fasta_ch = Channel
        .fromPath(params.fasta, checkIfExists: true)
        .map { f -> [[id: f.simpleName], f] }
    fai_ch = params.fai ? Channel.fromPath(params.fai, checkIfExists: true).map { f -> [f] } : Channel.value([[]])
    samples_ch = params.samples ? Channel.value([[:], file(params.samples, checkIfExists: true)]) : Channel.value([[:], []])
    populations_ch = params.populations ? Channel.value([[:], file(params.populations, checkIfExists: true)]) : Channel.value([[:], []])
    cnv_ch = params.cnv ? Channel.value([[:], file(params.cnv, checkIfExists: true)]) : Channel.value([[:], []])

    BAM_VARIANT_CALLING_SORT_FREEBAYES_BCFTOOLS(input1_ch.combine(index1_ch).combine(input2_ch).combine(index2_ch).combine(bed_ch), fasta_ch.combine(fai_ch).first(), samples_ch, populations_ch, cnv_ch)
}
