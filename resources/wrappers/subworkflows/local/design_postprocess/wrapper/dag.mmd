flowchart TD
    in_struct([structures])
    in_extra([extra_tables])
    in_ref([reference])

    p_metrics[PROTEIN_METRICS]
    d_clu{run_foldseek_cluster}
    p_foldseek[FOLDSEEK_EASYCLUSTER]
    p_filter[DESIGN_FILTER]

    out_merged([merged.tsv])
    out_filtered([filtered.tsv])
    out_summary([summary.json])

    in_struct --> p_metrics
    in_ref --> p_metrics
    in_struct --> d_clu
    d_clu -->|true| p_foldseek
    p_metrics --> p_filter
    p_foldseek --> p_filter
    in_extra --> p_filter
    p_filter --> out_merged
    p_filter --> out_filtered
    p_filter --> out_summary
