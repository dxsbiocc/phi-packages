process {
    cpus   = 2
    memory = '4.GB'
    time   = '2.h'

    withName: '.*PROTEIN_METRICS' {
        publishDir = [
            path: { "${params.outdir}/design_postprocess/metrics" },
            mode: 'copy'
        ]
    }

    withName: '.*FOLDSEEK' {
        cpus   = 8
        memory = '16.GB'
        time   = '4.h'
        publishDir = [
            path: { "${params.outdir}/design_postprocess/foldseek" },
            mode: 'copy'
        ]
    }

    withName: '.*DESIGN_FILTER' {
        publishDir = [
            path: { "${params.outdir}/design_postprocess/filtered" },
            mode: 'copy'
        ]
    }
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        conda.enabled = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
}
